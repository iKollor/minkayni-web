# Copia este archivo a .env y completa los valores.
# La web construye ESTÁTICO: el contenido de Strapi se lee en build.
# Si Strapi no responde, cada página usa su fallback local (src/data/pages/*).

# URL base del CMS Strapi (sin slash final)
STRAPI_URL=https://strapi.example.org

# Token de API de Strapi (tipo "Read-only" es suficiente para el build)
STRAPI_TOKEN=

# Clave de las teselas CARTO del mapa de sectores.
# Gratuita hasta 5 M de peticiones al mes: https://carto.com/basemaps/apikey/
# Sin ella, CARTO sirve las teselas con una marca de agua "API key required".
# Acaba siendo visible en el navegador (es inevitable en una clave de mapa):
# restríngela por dominio en el panel de CARTO.
PUBLIC_CARTO_KEY=

# Opcional: "true" hace fallar el build si Strapi no responde.
# Recomendado en el despliegue de producción; así un CMS caído aborta el build
# en vez de publicar en silencio el contenido de respaldo.
# STRAPI_STRICT=false

# Opcional: logs del codegen GraphQL→Zod (pnpm run zod:gen)
# STRAPI_CODEGEN_DEBUG=0
