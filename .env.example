# Copia este archivo a .env y completa los valores.
# La web construye ESTÁTICO: el contenido de Strapi se lee en build.
# Si Strapi no responde, cada página usa su fallback local (src/data/pages/*).

# URL base del CMS Strapi (sin slash final)
STRAPI_URL="https://strapi.minkayni.org"

# Token de API de Strapi (tipo "Read-only" es suficiente para el build)
STRAPI_TOKEN=""

# Opcional: "true" hace fallar el build si Strapi no responde (útil en CI)
# STRAPI_STRICT="false"

# Opcional: logs del codegen GraphQL→Zod (npm run zod:gen)
# STRAPI_CODEGEN_DEBUG=1
