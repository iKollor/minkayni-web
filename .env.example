# Copia este archivo a .env y completa los valores.
# La web construye ESTÁTICO: el contenido de Strapi se lee en build.
# Si Strapi no responde, cada página usa su fallback local (src/data/pages/*).

# URL base del CMS Strapi (sin slash final)
STRAPI_URL=https://strapi.example.org

# Token de API de Strapi (tipo "Read-only" es suficiente para el build)
STRAPI_TOKEN=

# Clave de las teselas CARTO del mapa de sectores.
# Gratuita hasta 5 M de peticiones al mes: https://carto.com/basemaps/apikey/
# Sin ella, CARTO sirve las teselas con una marca de agua "API key required".
# Acaba siendo visible en el navegador (es inevitable en una clave de mapa):
# restríngela por dominio en el panel de CARTO.
PUBLIC_CARTO_KEY=

# Opcional: "true" hace fallar el build si Strapi no responde.
# Recomendado en el despliegue de producción; así un CMS caído aborta el build
# en vez de publicar en silencio el contenido de respaldo.
# STRAPI_STRICT=false

# Opcional: logs del codegen GraphQL→Zod (pnpm run zod:gen)
# STRAPI_CODEGEN_DEBUG=0

# Medición para Google Ad Grants (opcional en local, OBLIGATORIA en producción:
# la política de Ad Grants exige seguimiento de conversiones para mantener la
# cuenta activa). Sin estos valores el sitio no carga ninguna etiqueta.
#
# Identificador de Google Analytics 4, con el prefijo G-
PUBLIC_GA_MEASUREMENT_ID=
# Identificador de conversiones de Google Ads, con el prefijo AW- (opcional si
# ya enlazaste la propiedad de Analytics con la cuenta de Ads)
PUBLIC_ADS_CONVERSION_ID=

# Opcional: origen desde el que se emiten los medios del CMS. Por defecto
# https://www.minkayni.org, donde Nginx reenvía /media/ a Strapi (nginx.conf).
# PUBLIC_MEDIA_ORIGIN=https://www.minkayni.org

# Opcional: "on" enciende la intro animada de la portada (el logotipo que se
# reproduce cinco segundos en la primera visita). Está apagada por defecto:
# PageSpeed analiza siempre como visita nueva y, con la intro delante, en
# escritorio no llegaba a medir el LCP (rendimiento 0) y en móvil daba 7,8 s,
# que es justo lo que Ad Grants reprocha. Encendida, se muestra solo a quien
# llega de nuevas y con buena conexión.
# PUBLIC_HOME_INTRO=off
