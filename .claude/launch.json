{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "astro-dev",
            "runtimeExecutable": "pnpm",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "port": 4321,
            "autoPort": true
        },
        {
            "name": "static-dist",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "serve",
                "dist",
                "-l",
                "4399"
            ],
            "port": 4399
        },
        {
            "name": "astro-preview",
            "runtimeExecutable": "npx",
            "runtimeArgs": [
                "astro",
                "preview",
                "--port",
                "4400"
            ],
            "port": 4400,
            "autoPort": true
        }
    ]
}
