---
/* Vista previa de una subpágina del constructor, generada en el momento.

   Fuera de src/pages a propósito: la build de producción es estática y esta
   ruta no puede prerenderizarse. Solo existe en la build de vista previa,
   donde astro.config.ts la inyecta en /preview/page/<documentId> y en
   /en/preview/page/<documentId> (el prefijo decide el idioma, como en el
   resto del sitio). La lógica vive en src/utils/preview.ts. */
import BuilderPageView from "@/components/blocks/BuilderPageView.astro";
import { previewHeaders, resolvePreview } from "@/utils/preview";

export const prerender = false;

for (const [name, value] of Object.entries(previewHeaders())) Astro.response.headers.set(name, value);

const result = await resolvePreview(Astro.url, Astro.params.documentId);
if ("response" in result) return result.response;
const { page } = result;
---

<BuilderPageView {page} noindex />
