---
import PageLayout from "@/layouts/PageLayout.astro";
import Pulseline from "@/components/batucada/Pulseline.astro";
import Torn from "@/components/batucada/Torn.astro";
import CmsImage from "@/components/CmsImage.astro";
import ImmersiveTimeline from "@/components/ImmersiveTimeline.astro";
import { bp } from "@/components/batucada/tokens";
import { batucadaHistoriaFallback } from "@/data/pages/batucada-historia";
import { loadPageContent } from "@/utils/page-content";
import { formatTitle } from "@/utils/rich-title";

/* Contenido: single type `batucada-history-page` en Strapi, con fallback local. */
const d = await loadPageContent("batucadaHistoryPage", batucadaHistoriaFallback);

const timeline = d.timeline;
---

<PageLayout title="Historia — Batucada Popular" showHero={false} linkColor="text-white" navbarThreshold={0.5}>
    <article class="overflow-clip bg-white text-black">
        <header class:list={[bp.edge, bp.fieldBlue, "pt-[calc(90px+clamp(2.25rem,5vw,4.5rem))] pb-[clamp(2.25rem,5vw,4.5rem)]"]} aria-labelledby="historia-title">
            <a class="inline-flex min-h-11 items-center gap-2 border-b-2 border-current text-[0.78rem] font-black uppercase tracking-[0.14em] focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-black" href={d.backLink.href} data-bp-hero><span aria-hidden="true">←</span> {d.backLink.text}</a>
            <p class:list={[bp.eyebrow, "mt-[clamp(1rem,2.5vw,2rem)]"]} data-bp-hero>{d.hero.eyebrow}</p>
            <h1 id="historia-title" class:list={[bp.riso, "font-bp mt-[clamp(1rem,2.5vw,2rem)] max-w-[14ch] text-balance text-[clamp(2.4rem,5.4vw,5.8rem)] uppercase leading-[0.94] tracking-[-0.03em]"]} data-bp-hero set:html={formatTitle(d.hero.title)} />
            <p class:list={[bp.body, "mt-7 max-w-[56ch]"]} data-bp-hero>{d.hero.body}</p>
        </header>

        <Pulseline items={d.pulseline.map((item) => item.text ?? "")} />

        <section class="mx-auto my-[clamp(2.25rem,5vw,4.5rem)] w-[94%] max-w-[1440px] rounded-[2.75rem] bg-[#dedbd4] px-4 py-14 sm:px-8 lg:rounded-[5rem] lg:px-14 lg:py-20" aria-label="Línea de tiempo de la Batucada Popular" data-bp-scene>
            <div class="mb-10 max-w-[760px]">
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary" data-bp-hit>{d.timelineHeading.eyebrow}</p>
                <h2 class="font-display text-4xl font-black leading-none text-black sm:text-6xl" data-bp-hit set:html={formatTitle(d.timelineHeading.title)} />
            </div>
            <ImmersiveTimeline items={timeline} ariaLabel="Línea de tiempo de la Batucada Popular" />
        </section>

        <Torn color="var(--bg-white)" border={2} field="none" />

        <section class:list={[bp.edge, bp.fieldPurple, "grid items-center gap-[clamp(2.25rem,5vw,4.5rem)] py-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.02fr)_minmax(26rem,0.98fr)]"]} aria-labelledby="sentido-title" data-bp-scene>
            <figure class={bp.visual}>
                <span class:list={[bp.echoPlate, "bg-bp-blue"]} aria-hidden="true"></span>
                <div class:list={[bp.frame, "aspect-[5/4] border-white"]} data-bp-photo>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <CmsImage
                        media={d.senseImage}
                        fallback={d.senseLocalImage}
                        alt={d.senseImageAlt}
                        class={bp.frameImg}
                        widths={[640, 960, 1072]}
                        sizes="(min-width: 64em) 46vw, 100vw"
                    />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </div>
            </figure>
            <div class="min-w-0">
                <p class={bp.eyebrow} data-bp-hit>{d.senseHeading.eyebrow}</p>
                <h2 id="sentido-title" class="font-bp mt-4 max-w-[12ch] text-balance text-[clamp(2.1rem,3.4vw,3.9rem)] uppercase leading-[0.96] tracking-[-0.03em]" data-bp-hit set:html={formatTitle(d.senseHeading.title)} />
                <p class:list={[bp.body, "mt-7 max-w-[46ch]"]} data-bp-hit>{d.senseHeading.body}</p>
                <p class:list={[bp.body, "mt-7 max-w-[46ch] border-t-[3px] border-accent pt-6 font-black"]} data-bp-hit>{d.senseHighlight}</p>
            </div>
        </section>

        <Torn color="var(--primary)" border={1} flip field="purple" />

        <section
            class:list={[bp.block, bp.fieldBlue, bp.predome, "grid items-center gap-[clamp(2.25rem,5vw,4.5rem)]", "[background-image:url(/batucada/semitono-soft.webp),var(--bp-rings-br)] [background-size:cover,auto] [background-blend-mode:multiply,normal]"]}
            aria-labelledby="historia-cta-title"
            data-bp-scene
        >
            <div>
                <p class={bp.eyebrow} data-bp-hit>{d.ctaHeading.eyebrow}</p>
                <h2 id="historia-cta-title" class:list={[bp.riso, "font-bp mt-4 max-w-[12ch] text-balance text-[clamp(2.4rem,4.6vw,5.4rem)] uppercase leading-[0.96] tracking-[-0.03em]"]} data-bp-hit set:html={formatTitle(d.ctaHeading.title)} />
            </div>
            <div class="flex flex-col flex-wrap items-stretch gap-x-6 gap-y-4 text-center sm:flex-row sm:items-center sm:text-left" data-bp-hit>
                <a class:list={[bp.button, bp.buttonInk, "focus-visible:outline-black"]} href={d.ctaPrimary.href}>{d.ctaPrimary.text}</a>
                <a class:list={[bp.textLink, "justify-center focus-visible:outline-black"]} href={d.ctaSecondary.href}>{d.ctaSecondary.text} <span class={bp.textLinkArrow} aria-hidden="true">↖</span></a>
            </div>
        </section>
    </article>
</PageLayout>

<script>
    import { initBatucadaAnchors, initBatucadaMotion, initPulseline } from "../../../scripts/batucada/motion";

    initBatucadaAnchors();
    initBatucadaMotion();
    initPulseline();
</script>
