---
import PageLayout from "@/layouts/PageLayout.astro";
import Pulseline from "@/components/batucada/Pulseline.astro";
import Torn from "@/components/batucada/Torn.astro";
import { bp } from "@/components/batucada/tokens";
import { batucadaEcosistemaFallback } from "@/data/pages/batucada-ecosistema";
import { loadPageContent } from "@/utils/page-content";
import { formatTitle } from "@/utils/rich-title";

/* Contenido: single type `batucada-ecosystem-page` en Strapi, con fallback local. */
const d = await loadPageContent("batucadaEcosystemPage", batucadaEcosistemaFallback);

const organisms = d.organisms;
const horizons = d.horizons;
const allies = d.allies;

const cardShadows = ["shadow-[6px_6px_0_var(--color-bp-blue)]", "rotate-[0.6deg] shadow-[6px_6px_0_var(--accent)]", "-rotate-[0.6deg] shadow-[6px_6px_0_var(--primary)]"];
---

<PageLayout title="Ecosistema — Batucada Popular" showHero={false} linkColor="text-white" navbarThreshold={0.5}>
    <article class="overflow-clip bg-white text-black">
        <header class:list={[bp.edge, bp.fieldInk, "pt-[calc(90px+clamp(2.25rem,5vw,4.5rem))] pb-[clamp(2.25rem,5vw,4.5rem)]"]} aria-labelledby="eco-title">
            <a class="inline-flex min-h-11 items-center gap-2 border-b-2 border-current text-[0.78rem] font-black uppercase tracking-[0.14em] focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-bp-blue" href={d.backLink.href} data-bp-hero><span aria-hidden="true">←</span> {d.backLink.text}</a>
            <p class:list={[bp.eyebrow, "mt-[clamp(1rem,2.5vw,2rem)] text-bp-blue"]} data-bp-hero>{d.hero.eyebrow}</p>
            <h1 id="eco-title" class="font-bp mt-[clamp(1rem,2.5vw,2rem)] max-w-[14ch] text-balance text-[clamp(2.4rem,5.4vw,5.8rem)] uppercase leading-[0.94] tracking-[-0.03em]" data-bp-hero set:html={formatTitle(d.hero.title)} />
            <p class:list={[bp.body, "mt-7 max-w-[56ch]"]} data-bp-hero>{d.hero.body}</p>
        </header>

        <Pulseline items={d.pulseline.map((item) => item.text ?? "")} />

        <section class={bp.block} aria-labelledby="organismos-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-primary"]} data-bp-hit>{d.organismsHeading.eyebrow}</p>
            <h2 id="organismos-title" class:list={[bp.h2, "max-w-[14ch]"]} data-bp-hit set:html={formatTitle(d.organismsHeading.title)} />
            <ul class="mt-[clamp(2rem,4.5vw,3.5rem)] grid grid-cols-[repeat(auto-fill,minmax(min(20rem,100%),1fr))] gap-[clamp(1.5rem,2.5vw,2.25rem)]" data-bp-clave>
                {
                    organisms.map((org, index) => (
                        <li class:list={["grid content-start gap-4 border-[3px] border-black bg-white p-[clamp(1.5rem,2.5vw,2rem)]", cardShadows[index % 3]]}>
                            <p class:list={[bp.eyebrow, "text-primary"]}>{org.kind}</p>
                            <h3 class={bp.h3}>{org.name}</h3>
                            <p class="text-base leading-[1.6]">{org.text}</p>
                        </li>
                    ))
                }
            </ul>
        </section>

        <Torn color="var(--bg-white)" border={1} field="none" />

        <section class:list={[bp.block, bp.fieldPurple]} aria-labelledby="horizonte-title" data-bp-scene>
            <p class={bp.eyebrow} data-bp-hit>{d.horizonsHeading.eyebrow}</p>
            <h2 id="horizonte-title" class:list={[bp.h2]} data-bp-hit set:html={formatTitle(d.horizonsHeading.title)} />
            <p class:list={[bp.body, "mt-5 max-w-[56ch]"]} data-bp-hit>{d.horizonsHeading.body}</p>
            <ol class="relative mt-[clamp(2rem,4.5vw,3.5rem)] grid gap-[clamp(1.6rem,3vw,2.4rem)]" data-bp-clave>
                <span class="absolute bottom-2 top-2 left-[calc(0.65rem-1px)] border-l-[3px] border-dashed border-white/40" aria-hidden="true"></span>
                {
                    horizons.map((item) => (
                        <li class="relative max-w-[68ch] pl-[2.6rem] lg:pl-[3.2rem]">
                            <span class="absolute left-0 top-[0.45rem] aspect-square w-[1.3rem] rotate-45 border-2 border-black bg-bp-blue" aria-hidden="true" />
                            <h3 class="font-bp text-[clamp(1.15rem,1.6vw,1.5rem)] uppercase tracking-[0.01em]">{item.title}</h3>
                            <p class="mt-[0.6rem] leading-[1.6]">{item.description}</p>
                        </li>
                    ))
                }
            </ol>
        </section>

        <Torn color="var(--primary)" border={3} flip field="purple" />

        <section class={bp.block} aria-labelledby="alianzas-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-primary"]} data-bp-hit>{d.alliesHeading.eyebrow}</p>
            <h2 id="alianzas-title" class:list={[bp.h2, "max-w-[12ch]"]} data-bp-hit set:html={formatTitle(d.alliesHeading.title)} />
            <ul class="mt-[clamp(1.75rem,3.5vw,2.75rem)] flex flex-wrap gap-x-[1.1rem] gap-y-4" data-bp-clave>
                {
                    allies.map((ally, index) => (
                        <li class:list={["rounded-[3px_8px_4px_7px] border-2 px-4 py-[0.55rem] text-[0.85rem] font-black uppercase tracking-[0.08em]", index % 2 ? "rotate-[1deg] border-primary text-primary" : "-rotate-[1.2deg] border-black text-black"]}>{ally.text}</li>
                    ))
                }
            </ul>
        </section>

        <Torn color="var(--bg-white)" border={2} field="none" />

        <section
            class:list={[bp.block, bp.fieldBlue, bp.predome, "grid items-center gap-[clamp(2.25rem,5vw,4.5rem)]", "[background-image:url(/batucada/semitono-soft.webp),var(--bp-rings-br)] [background-size:cover,auto] [background-blend-mode:multiply,normal]"]}
            aria-labelledby="eco-cta-title"
            data-bp-scene
        >
            <div>
                <p class={bp.eyebrow} data-bp-hit>{d.ctaHeading.eyebrow}</p>
                <h2 id="eco-cta-title" class:list={[bp.riso, "font-bp mt-4 max-w-[12ch] text-balance text-[clamp(2.4rem,4.6vw,5.4rem)] uppercase leading-[0.96] tracking-[-0.03em]"]} data-bp-hit set:html={formatTitle(d.ctaHeading.title)} />
            </div>
            <div class="flex flex-col flex-wrap items-stretch gap-x-6 gap-y-4 text-center sm:flex-row sm:items-center sm:text-left" data-bp-hit>
                <a class:list={[bp.button, bp.buttonInk, "focus-visible:outline-black"]} href={d.ctaPrimary.href} target="_blank" rel="noopener noreferrer">{d.ctaPrimary.text}</a>
                <a class:list={[bp.textLink, "justify-center focus-visible:outline-black"]} href={d.ctaSecondary.href}>{d.ctaSecondary.text} <span class={bp.textLinkArrow} aria-hidden="true">↖</span></a>
            </div>
        </section>
    </article>
</PageLayout>

<script>
    import { initBatucadaAnchors, initBatucadaMotion, initPulseline } from "../../../scripts/batucada/motion";

    initBatucadaAnchors();
    initBatucadaMotion();
    initPulseline();
</script>
