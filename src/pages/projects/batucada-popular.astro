---
import { Image } from "astro:assets";
import PageLayout from "@/layouts/PageLayout.astro";
import Measure from "@/components/batucada/Measure.astro";
import Pulseline from "@/components/batucada/Pulseline.astro";
import Torn from "@/components/batucada/Torn.astro";
import { bp } from "@/components/batucada/tokens";
import HeroPhoto from "@/assets/FOTO_BATUCADA.webp";
import CommunityPhoto from "@/assets/batucada-popular/comunidad.webp";
import BatucadaLogo from "@/assets/batucada-popular/logo-batucada-popular.svg";

const methodSteps = [
    { number: "01", title: "Diagnóstico", text: "Identificamos necesidades y fortalezas del territorio." },
    { number: "02", title: "Acción de aprendizaje", text: "Desarrollamos talleres y actividades formativas mediante el arte." },
    { number: "03", title: "Acompañamiento", text: "Damos seguimiento y fortalecemos el proceso de cada participante." },
    { number: "04", title: "Revisión", text: "Evaluamos resultados, avances y aspectos por mejorar." },
    { number: "05", title: "Reflexión", text: "Analizamos aprendizajes y proyectamos nuevas acciones comunitarias." },
];

/* Debe coincidir en orden con SECTORS en scripts/batucada/map.ts:
   el índice enlaza la lista con los pines del mapa. */
const sectors = [
    "Socio Vivienda",
    "Mapasingue",
    "Trinipuerto",
    "Nigeria",
    "Sergio Toral 1",
    "Sergio Toral 2",
    "Bastión Popular, Bloque 2",
    "Suburbio, Cisne 1",
    "Suburbio, Cisne 2",
    "Guasmo Sur",
    "Nueva Prosperina",
    "Paraíso de la Flor",
];

const communityActions = ["Encuentros barriales", "Procesos de memoria", "Campañas comunitarias", "Comunicación popular"];

const awards = [
    {
        year: "2024",
        title: "Resilience Fund — Global Initiative Against Transnational Organized Crime",
        text: "Fellowship que reconoció a la Batucada Popular como una de las diez iniciativas seleccionadas en el mundo, entre alrededor de quinientas propuestas.",
    },
    {
        year: "2025",
        title: "ONU Mujeres — Construimos Paz",
        text: "Una de las seis organizaciones que transforman Guayaquil con arte y cultura de paz dentro del programa Construimos Paz.",
    },
    {
        year: "2026",
        title: "Presea «Rosa Borja Febres-Cordero de Icaza»",
        text: "Mérito en Servicio Social de las preseas cívicas del Municipio de Guayaquil, a una de las mejores iniciativas populares de la ciudad.",
    },
];

const ecosystem = ["CESCU", "Movimiento de Barrios", "Radio Sin Paro", "Escuela de Líderes Jóvenes", "Batambá"];

const figures = [
    { sr: "+300", target: 300, prefix: "+", label: "integrantes" },
    { sr: "12", target: 12, prefix: "", label: "sectores" },
    { sr: "2020", target: 0, prefix: "", label: "desde" },
];
---

<PageLayout title="Batucada Popular" showHero={false} linkColor="text-white" navbarThreshold={0.85}>
    <article class="overflow-clip bg-white text-black">
        <!-- ============ HERO: campo azul de marca ============ -->
        <header
            class:list={[
                bp.edge,
                bp.fieldBlue,
                "grid min-h-svh content-center gap-x-[clamp(1rem,2.5vw,2rem)] gap-y-[clamp(2.25rem,5vw,4.5rem)] pt-[calc(90px+clamp(1rem,2.5vw,2rem))] pb-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(28rem,1.02fr)_minmax(0,0.98fr)] lg:items-center",
                "[background-image:url(/batucada/semitono-soft.webp),var(--bp-rings-tr)] [background-size:cover,auto] [background-blend-mode:multiply,normal]",
            ]}
            aria-labelledby="bp-title"
        >
            <div class="flex min-w-0 flex-col items-start justify-center">
                <p class:list={[bp.eyebrow, "mb-[clamp(1rem,2.5vw,2rem)] flex w-full flex-wrap justify-between gap-x-6 gap-y-1 border-b-2 border-current pb-3"]} data-bp-hero>
                    <span>Guayaquil, Ecuador</span> <span>Desde 2020</span>
                </p>
                <p class="relative my-[clamp(1rem,2.5vw,2rem)] inline-block -rotate-2 border-[3px] border-black bg-white px-[1.1rem] py-[0.9rem]" data-bp-hero>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <Image class="h-auto w-[clamp(7rem,12vw,10.5rem)]" src={BatucadaLogo} alt="Batucada Popular" loading="eager" />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </p>
                <h1 id="bp-title" class:list={[bp.h1, bp.riso, "max-w-[14ch] text-black"]} data-bp-hero>El barrio suena, se organiza y se transforma.</h1>
                <div class="mt-[clamp(1.75rem,4vw,3rem)] flex flex-wrap items-center gap-x-6 gap-y-4" data-bp-hero>
                    <a class:list={[bp.button, bp.buttonYellow, "focus-visible:outline-black"]} href="#historia">Conoce el proceso</a>
                    <a class:list={[bp.textLink, "focus-visible:outline-black"]} href="#metodologia">Ver metodología <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
                </div>
            </div>

            <figure class:list={[bp.visual, "min-w-0 lg:flex lg:flex-col lg:justify-center lg:self-stretch"]}>
                <span class:list={[bp.echoPlate, "bg-black"]} aria-hidden="true"></span>
                <div class:list={[bp.frame, "aspect-[4/3] lg:aspect-auto lg:min-h-96 lg:flex-1"]} data-bp-photo>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <Image class={bp.frameImg} src={HeroPhoto} alt="Jóvenes de Batucada Popular tocando tambores durante una presentación" loading="eager" widths={[720, 1080, 1600, 2200]} sizes="(min-width: 64em) 48vw, 100vw" />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </div>
                <figcaption class="mt-[calc(1rem+clamp(0.75rem,1.5vw,1.25rem))] max-w-[34ch] text-[0.78rem] font-black uppercase tracking-[0.14em] lg:self-end lg:text-right">Arte, organización y transformación comunitaria.</figcaption>
            </figure>
        </header>

        <Pulseline />

        <!-- ============ 01 · QUIÉNES SOMOS + ORIGEN ============ -->
        <section id="historia" class:list={[bp.block, "scroll-mt-[92px]"]} aria-labelledby="intro-title" data-bp-scene>
            <Measure num="01" label="Quiénes somos" filled={2} />

            <p class:list={[bp.eyebrow]} data-bp-hit>Un proceso construido desde los territorios</p>
            <h2 id="intro-title" class:list={[bp.h2, "max-w-[13ch] text-[clamp(2.4rem,5vw,5.4rem)]"]} data-bp-hit>
                Cuando el tambor convoca, la comunidad <em class="not-italic text-primary underline decoration-bp-blue decoration-[0.08em] underline-offset-[0.12em]">responde</em>.
            </h2>

            <div class="mt-[clamp(2rem,4.5vw,3.5rem)] grid items-start gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)]">
                <div>
                    <div class:list={[bp.body, "grid max-w-[60ch] gap-[clamp(1rem,2.5vw,2rem)]"]} data-bp-clave>
                        <p>Batucada Popular es un colectivo juvenil comunitario y territorial que desarrolla procesos de organización, formación y participación con niñas, niños, adolescentes y jóvenes de sectores populares de Guayaquil.</p>
                        <p>A través de la percusión, la educación popular y la acción comunitaria, el arte se convierte en una herramienta para fortalecer la convivencia, el liderazgo juvenil y la defensa de los derechos humanos — y para prevenir la captación y el reclutamiento forzado en los barrios.</p>
                    </div>
                    <ul class="mt-[clamp(1.75rem,3.5vw,2.75rem)] flex flex-wrap gap-x-[1.6rem] gap-y-[1.1rem]" data-bp-clave>
                        {
                            figures.map((figure, index) => (
                                <li class:list={["grid gap-[0.2rem] rounded-[4px_8px_5px_7px] border-[3px] border-black bg-white px-[1.2rem] py-[0.85rem]", index % 2 ? "rotate-[1.2deg] shadow-[4px_4px_0_var(--accent)]" : "-rotate-1 shadow-[4px_4px_0_var(--color-bp-blue)]"]}>
                                    <strong class="font-bp text-[clamp(1.6rem,2.4vw,2.4rem)] leading-none [font-variant-numeric:tabular-nums]">
                                        {figure.target > 0 ? (
                                            <>
                                                <span class="sr-only">{figure.sr}</span>
                                                <span aria-hidden="true" data-bp-count={figure.target} data-bp-prefix={figure.prefix}>
                                                    {figure.sr}
                                                </span>
                                            </>
                                        ) : (
                                            figure.sr
                                        )}
                                    </strong>
                                    <small class="text-[0.78rem] font-black uppercase tracking-[0.12em]">{figure.label}</small>
                                </li>
                            ))
                        }
                    </ul>
                </div>

                <aside class={bp.note} data-bp-hit aria-labelledby="origen-title">
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <h3 id="origen-title" class:list={[bp.h3, "tracking-[0.02em]"]}>De dónde venimos</h3>
                    <ol class="mt-6 grid gap-[1.15rem]">
                        {
                            [
                                { period: "2019–20", title: "Palos y baldes.", text: "La batucada nace en pandemia como una iniciativa familiar frente al miedo, con instrumentos improvisados." },
                                { period: "2020", title: "La protesta.", text: "Salimos con baldes, junto a jóvenes y niños, a reclamar por el presupuesto de las universidades. Fuimos apresados — y esa experiencia nos convenció de organizar a las juventudes para defender sus derechos de forma pacífica." },
                                { period: "2020–21", title: "Batambá.", text: "La semilla feminista: las madres que sostenían la vida de los barrios integraron a sus hijas e hijos al proceso." },
                                { period: "Hoy", title: "Un referente.", text: "Una red juvenil que moviliza a la ciudad para exigir derechos de manera pacífica y no violenta." },
                            ].map((item) => (
                                <li class="grid grid-cols-[auto_minmax(0,1fr)] items-baseline gap-[0.9rem] text-base leading-[1.55]">
                                    <span class="font-bp whitespace-nowrap text-[0.95rem] text-primary">{item.period}</span>
                                    <p>
                                        <strong class="block">{item.title}</strong>
                                        {item.text}
                                    </p>
                                </li>
                            ))
                        }
                    </ol>
                    <a class:list={[bp.textLink, "mt-7 focus-visible:outline-primary"]} href="/projects/batucada-popular/historia/">Lee la historia completa <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </aside>
            </div>
        </section>

        <Torn color="var(--bg-white)" border={1} />

        <!-- ============ INTERLUDIO · EL PULSO ============ -->
        <section class:list={[bp.edge, bp.fieldBlue, "grid items-center gap-[clamp(2.25rem,5vw,4.5rem)] py-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.02fr)_minmax(26rem,0.98fr)]"]} aria-labelledby="pulse-title" data-bp-scene>
            <figure class={bp.visual}>
                <span class:list={[bp.echoPlate, "bg-primary"]} aria-hidden="true"></span>
                <div class:list={[bp.frame, "aspect-[5/4]"]} data-bp-photo>
                    <span class:list={[bp.tape, bp.tapeTL]} aria-hidden="true"></span>
                    <Image class={bp.frameImg} src={CommunityPhoto} alt="Integrantes de Batucada Popular compartiendo juntas después de una presentación" widths={[640, 960, 1400, 1800]} sizes="(min-width: 64em) 46vw, 100vw" />
                    <span class:list={[bp.tape, bp.tapeBR]} aria-hidden="true"></span>
                </div>
            </figure>
            <div class="min-w-0">
                <p class={bp.eyebrow} data-bp-hit>El corazón del proyecto</p>
                <h2 id="pulse-title" class="font-bp mt-4 max-w-[12ch] text-balance text-[clamp(2.1rem,3.4vw,3.9rem)] uppercase leading-[0.96] tracking-[-0.03em]" data-bp-hit>La percusión es un pretexto para encontrarnos y organizarnos.</h2>
                <p class:list={[bp.body, "mt-7 max-w-[46ch]"]} data-bp-hit>Los ensayos permanentes son espacios seguros donde las juventudes fortalecen sus capacidades artísticas, desarrollan disciplina, construyen vínculos solidarios y se reconocen como protagonistas del cambio social.</p>
                <p class:list={[bp.body, "mt-7 max-w-[46ch] border-t-[3px] border-black pt-6 font-black"]} data-bp-hit>No se trata solo de aprender música. Se trata de pertenecer.</p>
            </div>
        </section>

        <Torn color="#29aae1" border={2} flip />

        <!-- ============ 02 · METODOLOGÍA ============ -->
        <section id="metodologia" class:list={[bp.block, bp.fieldInk, "scroll-mt-[92px]"]} aria-labelledby="method-title" data-bp-scene>
            <Measure num="02" label="Cómo trabajamos" filled={4} numClass="text-bp-blue" />

            <p class:list={[bp.eyebrow, "text-bp-blue"]} data-bp-hit>Metodología DAARR</p>
            <h2 id="method-title" class:list={[bp.h2, "max-w-[14ch]"]} data-bp-hit>Escuchar. Hacer. Acompañar. Aprender de nuevo.</h2>

            <ol class="mt-[clamp(2rem,4.5vw,3.5rem)] border-t-[3px] border-white" data-bp-clave>
                {
                    methodSteps.map((step) => (
                        <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-baseline gap-x-5 gap-y-[0.4rem] border-b-2 border-dashed border-white/30 py-[clamp(1.35rem,2.2vw,1.8rem)] sm:grid-cols-[3.5rem_minmax(11rem,0.55fr)_minmax(0,1fr)]">
                            <span class="font-bp row-span-2 text-[1.35rem] text-bp-blue sm:row-span-1" aria-hidden="true">
                                {step.number}
                            </span>
                            <h3 class="font-display text-[clamp(1.3rem,1.5vw,1.7rem)] font-black">{step.title}</h3>
                            <p class="col-start-2 max-w-[58ch] text-base leading-[1.55] text-bp-dim sm:col-start-auto">{step.text}</p>
                        </li>
                    ))
                }
            </ol>
            <p class="mt-[clamp(2rem,4.5vw,3.5rem)] max-w-[56ch] border-l-4 border-accent pl-5 font-black leading-[1.55]" data-bp-hit>Los propios jóvenes se trasladan a otros territorios para enseñar percusión y facilitar procesos sobre derechos, salud sexual y reproductiva y nuevas masculinidades: el ciclo forma liderazgos que se multiplican.</p>
        </section>

        <Torn color="var(--bg-black)" border={3} />

        <!-- ============ 03 · TERRITORIO (mapa) ============ -->
        <section id="territorio" class:list={[bp.block, bp.fieldPurple, "scroll-mt-[92px]"]} aria-labelledby="territory-title" data-bp-scene>
            <Measure num="03" label="Dónde suena" filled={6} numClass="text-white" />

            <p class={bp.eyebrow} data-bp-hit>Presencia activa</p>
            <h2 id="territory-title" class:list={[bp.h2, "max-w-[14ch]"]} data-bp-hit>
                <strong class="text-accent [font-weight:inherit]">12 sectores</strong> conectados por una red juvenil que se organiza desde adentro.
            </h2>

            <div class="mt-[clamp(2rem,4.5vw,3.5rem)] grid items-stretch gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(24rem,0.9fr)_minmax(0,1.1fr)]">
                <div>
                    <p class:list={[bp.body, "max-w-[52ch]"]} data-bp-hit>Más de 300 niñas, niños, adolescentes y jóvenes integran las batucadas en los barrios populares de Guayaquil. La presencia territorial permite responder a las necesidades de cada sector y fortalecer liderazgos e incidencia social desde las propias comunidades.</p>
                    <ol class="mt-[clamp(1.75rem,3vw,2.5rem)] grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] gap-x-5 gap-y-2" data-bp-clave>
                        {
                            sectors.map((name, index) => (
                                <li>
                                    <button type="button" class="group relative flex w-full cursor-pointer items-center py-2 pl-[2.8rem] text-left font-bold text-white focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-white" data-bp-sector>
                                        <span class="absolute left-[0.3rem] top-1/2 aspect-square w-[1.9rem] -translate-y-1/2 rotate-45 border-2 border-black bg-bp-blue transition-[scale,background-color] duration-[180ms] ease-bp-rebound group-hover:scale-[1.15] group-hover:bg-accent group-data-[active]:scale-[1.15] group-data-[active]:bg-accent motion-reduce:transition-none" aria-hidden="true" />
                                        <span class="font-display absolute left-[0.3rem] top-1/2 grid w-[1.9rem] -translate-y-1/2 place-items-center text-[0.72rem] font-black text-black" aria-hidden="true">
                                            {String(index + 1).padStart(2, "0")}
                                        </span>
                                        {name}
                                    </button>
                                </li>
                            ))
                        }
                    </ol>
                    <p class="mt-6 text-[0.9rem] text-white/80" data-bp-hit>Haz clic en un sector para acercarte a su barrio. Los puntos señalan sectores, no direcciones; la presencia varía según los periodos y las condiciones de cada barrio.</p>
                </div>

                <div class="relative aspect-[4/3] border-[3px] border-white bg-[#e8e0d3] lg:aspect-auto lg:min-h-[clamp(26rem,62vh,40rem)]">
                    <div id="bp-map" class="peer absolute inset-0 z-0" role="application" aria-label="Mapa de Guayaquil con los 12 sectores donde trabaja Batucada Popular" aria-describedby="bp-map-status" aria-busy="true" data-state="idle"></div>
                    <p id="bp-map-status" class="pointer-events-none absolute inset-x-0 bottom-3 z-[1] text-center text-[0.78rem] font-black uppercase tracking-[0.14em] text-black/70 peer-data-[state=ready]:hidden" data-bp-map-status role="status">Cargando mapa de los sectores…</p>
                    <button
                        type="button"
                        class="absolute bottom-3 left-3 z-[2] hidden -rotate-1 cursor-pointer border-2 border-black bg-accent px-3 py-[0.45rem] text-[0.7rem] font-black uppercase tracking-[0.08em] text-black shadow-[3px_3px_0_rgba(10,8,1,0.6)] transition-transform duration-[180ms] ease-bp-rebound hover:-translate-y-[2px] focus-visible:outline-[3px] focus-visible:outline-offset-4 focus-visible:outline-white peer-data-[state=ready]:inline-flex motion-reduce:transition-none"
                        data-bp-map-reset>Ver los 12 sectores</button
                    >
                </div>
            </div>
        </section>

        <Torn color="var(--primary)" border={4} />

        <!-- ============ 04 · ACCIÓN COMUNITARIA ============ -->
        <section class={bp.block} aria-labelledby="action-title" data-bp-scene>
            <Measure num="04" label="Más allá del ensayo" filled={8} />

            <div class="grid items-center gap-[clamp(2.25rem,5vw,4.5rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(20rem,0.95fr)]">
                <div>
                    <p class={bp.eyebrow} data-bp-hit>Acción comunitaria en los barrios</p>
                    <h2 id="action-title" class:list={[bp.h2, "max-w-[12ch]"]} data-bp-hit>El ritmo también recupera memoria, espacio público y voz.</h2>
                </div>
                <ol class="border-t-[3px] border-black" data-bp-clave>
                    {
                        communityActions.map((action, index) => (
                            <li class="group grid grid-cols-[2.6rem_minmax(0,1fr)] items-center gap-[1.15rem] border-b-2 border-dashed border-black/55 py-[clamp(1.2rem,1.9vw,1.6rem)]">
                                <span class="grid aspect-square w-[2.6rem] place-items-center border-2 border-black bg-bp-blue text-[0.9rem] font-black text-black transition-transform duration-[180ms] ease-bp-rebound group-hover:-rotate-[8deg] group-hover:scale-[1.08] motion-reduce:transition-none" aria-hidden="true">
                                    0{index + 1}
                                </span>
                                <p class="text-[clamp(1.15rem,1.8vw,1.7rem)] font-black">{action}</p>
                            </li>
                        ))
                    }
                </ol>
            </div>
        </section>

        <!-- ============ INTERLUDIO · ECOSISTEMA ============ -->
        <section class:list={[bp.block, bp.fieldInk]} aria-labelledby="eco-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-bp-blue"]} data-bp-hit>El ecosistema</p>
            <h2 id="eco-title" class:list={[bp.h2, "max-w-[12ch]"]} data-bp-hit>La batucada no suena sola.</h2>
            <p class:list={[bp.body, "mt-7 max-w-[56ch]"]} data-bp-hit>Alrededor del proceso crecieron una organización de investigación, un movimiento de barrios, una radio juvenil y una escuela de líderes: contranarrativas que disputan la forma de contar a los barrios populares.</p>
            <ul class="mt-[clamp(1.75rem,3.5vw,2.75rem)] flex flex-wrap gap-x-[1.1rem] gap-y-4" data-bp-clave>
                {
                    ecosystem.map((name, index) => (
                        <li class:list={["rounded-[3px_8px_4px_7px] border-2 px-4 py-[0.55rem] text-[0.85rem] font-black uppercase tracking-[0.08em]", index % 2 ? "rotate-[1deg] border-bp-blue text-bp-blue" : "-rotate-[1.2deg] border-white text-white"]}>{name}</li>
                    ))
                }
            </ul>
            <div class="mt-[clamp(1.75rem,4vw,3rem)] flex flex-wrap items-center gap-x-6 gap-y-4" data-bp-hit>
                <a class:list={[bp.textLink, "focus-visible:outline-bp-blue"]} href="/projects/batucada-popular/ecosistema/">Conoce el ecosistema <span class={bp.textLinkArrow} aria-hidden="true">↘</span></a>
            </div>
        </section>

        <Torn color="var(--bg-black)" border={1} flip />

        <!-- ============ RECONOCIMIENTOS ============ -->
        <section class={bp.block} aria-labelledby="awards-title" data-bp-scene>
            <p class:list={[bp.eyebrow, "text-primary"]} data-bp-hit>Reconocimientos</p>
            <h2 id="awards-title" class:list={[bp.h2, "max-w-[13ch]"]} data-bp-hit>El mundo empieza a escuchar.</h2>
            <ol class="mt-[clamp(2rem,4.5vw,3.5rem)] grid grid-cols-[repeat(auto-fill,minmax(min(19rem,100%),1fr))] gap-[clamp(1.5rem,2.5vw,2.25rem)]" data-bp-clave>
                {
                    awards.map((award, index) => (
                        <li class:list={["grid content-start gap-[0.9rem] border-[3px] border-black bg-white p-[clamp(1.4rem,2.4vw,2rem)] shadow-[5px_5px_0_rgba(10,8,1,0.85)]", index % 2 ? "rotate-[0.7deg]" : "-rotate-[0.7deg]"]}>
                            <span class="font-bp -rotate-2 justify-self-start border-2 border-current px-[0.55rem] py-[0.2rem] text-base text-primary" aria-hidden="true">
                                {award.year}
                            </span>
                            <h3 class="text-[1.15rem] font-black leading-[1.3]">{award.title}</h3>
                            <p class="text-[0.95rem] leading-[1.55]">{award.text}</p>
                        </li>
                    ))
                }
            </ol>
