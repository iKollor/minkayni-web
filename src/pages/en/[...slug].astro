---
/* Subpáginas del constructor en inglés.

   No puede limitarse a montar la página española como hacen las demás rutas
   de `/en`: una ruta dinámica necesita su propio `getStaticPaths`, porque es
   ahí donde Astro decide qué URLs existen. La lista y la mezcla de idiomas
   viven en `builderPagePaths`, compartidas con `/[...slug]`. */
import BuilderPageView from "@/components/blocks/BuilderPageView.astro";
import { builderPagePaths } from "@/utils/builder-pages";
import type { BuilderPage } from "@/schemas/pages.zod";

export async function getStaticPaths() {
    return builderPagePaths("en");
}

interface Props {
    page: BuilderPage;
}
const { page } = Astro.props;
---

<BuilderPageView {page} />
