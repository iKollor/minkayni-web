---
import PageLayout from "@/layouts/PageLayout.astro";
import Button from "@/components/Button.astro";
import { Markdown } from "@astropub/md";
import ProjectExplorer, { type ProjectItem } from "@/components/projects/ProjectExplorer.astro";
import { projectsFallback } from "@/data/pages/projects";
import { loadPageContent } from "@/utils/page-content";
import { formatTitle } from "@/utils/rich-title";

/* Contenido: single type `projects-page` en Strapi, con fallback local. */
const d = await loadPageContent("projectsPage", projectsFallback);

const projects = d.projects as unknown as ProjectItem[];

/* Estilos por posición de los pasos DAARR (presentacional). */
const stepStyles = [
    { card: "bg-primary text-white", number: "text-secondary", dim: "text-white/75", offset: "" },
    { card: "bg-secondary text-black", number: "text-primary", dim: "text-black/65", offset: "lg:translate-y-6" },
    { card: "bg-accent text-black", number: "text-primary", dim: "text-black/65", offset: "lg:translate-y-12" },
    { card: "bg-primary text-white", number: "text-secondary", dim: "text-white/75", offset: "lg:translate-y-6" },
    { card: "bg-secondary text-black", number: "text-primary", dim: "text-black/65", offset: "" },
];
---

<PageLayout title="Proyectos" linkColor="text-white" navbarThreshold={0.45}>
    <section class="mx-auto w-[90%] max-w-[1280px] py-20 sm:py-28" aria-labelledby="projects-intro-title">
        <div class="grid items-end gap-10 lg:grid-cols-[0.8fr_1.2fr]">
            <div>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.intro.eyebrow}</p>
                <h2 id="projects-intro-title" class="font-display text-5xl font-black leading-[0.92] tracking-tight text-black sm:text-7xl" set:html={formatTitle(d.intro.title, "text-secondary-deep")} />
            </div>
            <div class="max-w-[62ch] text-lg leading-relaxed text-black/70 lg:pb-2 lg:text-xl">
                <p>{d.intro.body}</p>
            </div>
        </div>
    </section>

    <ProjectExplorer {projects} filters={d.filters} eyebrow={d.explorerHeading.eyebrow} title={d.explorerHeading.title} />

    <section id="metodologia" class="mx-auto w-[90%] max-w-[1280px] py-24 sm:py-32" aria-labelledby="method-title">
        <div class="mb-12 max-w-[760px]">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{d.methodHeading.eyebrow}</p>
            <h2 id="method-title" class="font-display text-5xl font-black leading-none text-primary sm:text-7xl" set:html={formatTitle(d.methodHeading.title)} />
            <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-black/70">{d.methodHeading.body}</p>
        </div>

        <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-5">
            {
                d.methodSteps.map((step, index) => {
                    const style = stepStyles[index % stepStyles.length];
                    return (
                        <li class={`rounded-[2rem] p-7 ${style.card} ${style.offset}`}>
                            <span class={`mb-8 block font-display text-5xl font-black ${style.number}`}>{step.number}</span>
                            <h3 class="mb-3 font-display text-2xl font-bold">{step.title}</h3>
                            <p class={`leading-relaxed ${style.dim}`}>{step.text}</p>
                        </li>
                    );
                })
            }
        </ol>
        <a href={d.methodLink.href} class="mt-10 inline-flex items-center gap-2 font-display font-bold text-primary underline-offset-4 transition hover:text-secondary-deep hover:underline">
            {d.methodLink.text} <span aria-hidden="true">→</span>
        </a>
    </section>

    <section class="mx-auto w-[90%] max-w-[1280px] pb-24" aria-labelledby="horizon-title">
        <div class="mb-12 max-w-[760px]">
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.horizonHeading.eyebrow}</p>
            <h2 id="horizon-title" class="font-display text-4xl font-black leading-none text-black sm:text-6xl" set:html={formatTitle(d.horizonHeading.title)} />
        </div>
        <div class="grid gap-5 md:grid-cols-3">
            {
                d.horizonCards.map((card) => (
                    <div class="rounded-[2.25rem] bg-[#dedbd4] p-8 sm:p-10">
                        <h3 class="font-display text-2xl font-bold text-primary">{card.title}</h3>
                        <p class="mt-3 leading-relaxed text-black/70">{card.description}</p>
                    </div>
                ))
            }
        </div>
    </section>

    <section id="alianzas" class="mx-auto mb-44 md:mb-80 mt-4 w-[94%] max-w-[1440px] overflow-hidden rounded-[2.75rem] bg-[linear-gradient(130deg,var(--primary),#410063)] px-6 py-16 text-white sm:px-12 lg:rounded-[5rem] lg:px-20 lg:py-24" aria-labelledby="alliances-title">
        <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
            <div class="max-w-[760px]">
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary">{d.alliancesHeading.eyebrow}</p>
                <h2 id="alliances-title" class="font-display text-5xl font-black leading-[0.95] sm:text-7xl" set:html={formatTitle(d.alliancesHeading.title)} />
                <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-white/75">{d.alliancesHeading.body}</p>
                <ul class="mt-8 flex flex-wrap gap-2" aria-label="Aliados y financiadores">
                    {d.allies.map((ally) => <li class="rounded-full bg-white/10 px-4 py-2 text-sm font-bold backdrop-blur">{ally.text}</li>)}
                </ul>
            </div>
            <div class="flex flex-col items-center gap-4">
                <Button href={d.ctaButton.href} defaultText={d.ctaButton.defaultText} hoverText={d.ctaButton.hoverText} />
                <a
                    href={d.ctaSecondary.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex min-h-14 items-center justify-center rounded-full bg-white/10 px-7 py-4 text-center font-display text-lg font-bold text-white backdrop-blur transition hover:-translate-y-1 hover:bg-white hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
                >
                    {d.ctaSecondary.text}
                </a>
            </div>
        </div>

        <div class="mt-12 text-sm text-white/65 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-secondary">
            <Markdown of={d.alliancesNote} />
        </div>
    </section>
</PageLayout>
