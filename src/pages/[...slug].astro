---
/* Subpáginas del constructor de Strapi (collection type `page`).
   Cada entrada publicada genera la ruta /<slug> en build; las rutas
   estáticas del sitio tienen prioridad y además se filtran por seguridad.
   Reveals y odómetro usan el mismo patrón que /about e /impact. */
import PageLayout from "@/layouts/PageLayout.astro";
import BlockRenderer from "@/components/blocks/BlockRenderer.astro";
import { getCollection } from "astro:content";
import { getData } from "@/utils/i18n";
import type { BuilderPage } from "@/schemas/pages.zod";

export async function getStaticPaths() {
    /* Rutas propias del sitio que una subpágina jamás debe pisar. */
    const RESERVED = new Set(["", "about", "impact", "projects", "batucada-popular", "index", "admin", "api", "media", "batucada"]);

    let entries: Awaited<ReturnType<typeof getCollection<"builderPages">>> = [];
    try {
        entries = await getCollection("builderPages");
    } catch {
        entries = [];
    }

    return entries
        .map((entry) => getData(entry, "es") as BuilderPage)
        .filter((page): page is BuilderPage & { slug: string } => {
            const slug = page?.slug?.trim();
            return Boolean(slug) && !RESERVED.has(slug as string) && Boolean(page.publishedAt);
        })
        .map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props {
    page: BuilderPage;
}
const { page } = Astro.props;
const blocks = (page.sections ?? []).filter((section): section is Record<string, unknown> => Boolean(section));
---

<PageLayout title={page.title ?? ""} navbarThreshold={0.5}>
    <div class="pb-32 md:pb-64">
        <BlockRenderer {blocks} />
    </div>
</PageLayout>

<script>
    import { initBatucadaAnchors } from "../scripts/batucada/motion";
    import { initReveals, initCounters } from "../scripts/reveals";

    const initBuilderPage = () => {
        initBatucadaAnchors(); // anclas internas con offset por navbar fija
        initCounters();
        initReveals();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBuilderPage, { once: true });
    } else {
        initBuilderPage();
    }
</script>
