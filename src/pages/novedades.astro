---
/* Novedades (/novedades). La versión inglesa vive en /en/news; las dos pintan
   el mismo componente y solo cambian de idioma. Ver src/utils/novedades.ts
   para el porqué de la página. */
import PageLayout from "../layouts/PageLayout.astro";
import Novedades from "../components/Novedades.astro";
import { loadLayoutContent } from "../utils/layout-content";
import { cargarNovedades } from "../utils/novedades";
import { cargarActividades } from "../utils/actividades";
import { getLocale, useTranslations } from "../i18n";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);
const novedades = await cargarNovedades(locale);
const actividades = await cargarActividades(locale);
/* Redes y correo para el bloque «Síguenos y participa». */
const { footer, site } = await loadLayoutContent(locale);
---

<PageLayout title={t("news.title")} description={t("news.metaDescription")}>
    <Novedades {novedades} {actividades} {locale} socials={footer.Socials} contactEmail={site.contactEmail} />
</PageLayout>
