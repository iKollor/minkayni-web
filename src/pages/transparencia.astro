---
/* ──────────────────────────────────────────────────────────────────────────
   OPCIÓN B — Página dedicada de Transparencia Legal (/transparencia).

   Pensada para el enlace que se envía a Goodstack, TechSoup, Google for
   Nonprofits y Microsoft Elevate: una sola URL pública, en HTML semántico,
   con la identidad legal completa, el domicilio, el contacto institucional,
   los enlaces de verificación del Estado ecuatoriano y los documentos
   oficiales descargables.

   Los tres datos que un revisor —o un rastreador automático— busca para
   confirmar que la organización existe y opera desde este dominio son la
   DIRECCIÓN FÍSICA, el CORREO @minkayni.org y el TELÉFONO. Por eso viven en
   su propia sección, en texto plano y SIN animación de entrada: ni
   `data-reveal` ni `data-scroll-float`. Nada de lo que hay ahí depende de
   que el visitante haga scroll ni de que el navegador ejecute JavaScript.

   Accesibilidad: <dl> para pares dato/valor, <address> para el domicilio,
   jerarquía de encabezados sin saltos, foco visible en todos los enlaces y
   contraste AA (texto #0a0801 sobre crema #FFF6E5 ≈17:1; blanco sobre
   morado #6e00a3 ≈11:1). No depende de JavaScript.

   Contenido editable en Strapi: single type `legal-transparency`.
─────────────────────────────────────────────────────────────────────────── */
import PageLayout from "../layouts/PageLayout.astro";
import { Icon } from "astro-icon/components";
import { getLegalContent, fullRows, formatAddress, documentUrl, domainOwnershipLine } from "../components/legal/legalContent";
import DataAndCookies from "../components/legal/DataAndCookies.astro";
import { getLocale, useTranslations } from "../i18n";
const locale = getLocale(Astro.url);
const t = useTranslations(locale);

const d = await getLegalContent(locale);
const rows = fullRows(d, locale);
const address = formatAddress(d);
const documents = (d.documents ?? []).filter((doc) => doc?.file?.url);
const verificationLinks = (d.verificationLinks ?? []).filter((link) => link?.href && link?.text);

/* `tel:` necesita el número sin espacios; el texto visible conserva el
   formato legible (+593 98 526 1647). */
const telHref = d.phone ? `tel:${d.phone.replace(/[^+\d]/g, "")}` : "";

/* Titularidad del dominio: la frase que Google for Nonprofits pide encontrar
   en el propio dominio oficial. Se compone de los campos verificados, no se
   escribe a mano (ver domainOwnershipLine). */
const domainOwnership = domainOwnershipLine(d, locale);

/* Contacto oficial como pares dato/valor. `text` es SIEMPRE el valor en
   claro: el correo y el teléfono se leen tal cual aunque el enlace no se
   pueda seguir (impresión, lector de texto, rastreador sin JavaScript). */
const contactRows = [
    { icon: "mdi:map-marker-outline", label: t("transparency.physicalAddress"), text: address, href: "" },
    { icon: "mdi:email-outline", label: t("transparency.email"), text: d.email, href: d.email ? `mailto:${d.email}` : "" },
    { icon: "mdi:phone-outline", label: t("transparency.phone"), text: d.phone, href: telHref },
    { icon: "mdi:web", label: t("transparency.website"), text: d.website, href: d.website },
].filter((row) => Boolean(row.text));
---

<PageLayout title={t("nav.legalTransparency")} description={d.seo.metaDescription}>
    <!-- Identidad legal -->
    <section class="mx-auto w-[90%] max-w-[1100px] pt-16 sm:pt-24" aria-labelledby="legal-identity-title">
        <header class="max-w-[70ch]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.eyebrow}</p>
            <h2 data-scroll-float id="legal-identity-title" class="font-display text-4xl font-black leading-[0.95] text-black sm:text-6xl">{d.title}</h2>
            <p class="mt-6 text-lg leading-relaxed text-black/75">{d.intro}</p>
        </header>

        <dl class="mt-12 divide-y divide-black/10 border-y border-black/10" data-reveal-group>
            {
                rows.map((row) => (
                    <div class="grid gap-1 py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
                        <dt class="text-sm font-bold uppercase tracking-[0.14em] text-black/70">{row.label}</dt>
                        <dd class="text-base font-semibold leading-snug text-black sm:text-lg">{row.value}</dd>
                    </div>
                ))
            }
        </dl>
    </section>

    <!-- Domicilio y contacto oficial.

         Bloque deliberadamente estático: sin `data-reveal` en la sección ni
         `data-scroll-float` en el título. Es el dato que se verifica, así que
         se ve al cargar la página, sin esperar al scroll ni a GSAP. -->
    <section class="mx-auto w-[90%] max-w-[1100px] pt-16 sm:pt-20" aria-labelledby="legal-contact-title">
        <h2 id="legal-contact-title" class="font-display text-3xl font-black leading-tight text-primary sm:text-4xl">{t("transparency.address")}</h2>

        <address class="mt-8 not-italic">
            <dl class="divide-y divide-black/10 border-y border-black/10">
                {
                    contactRows.map((row) => (
                        <div class="grid gap-1 py-5 sm:grid-cols-[minmax(0,15rem)_1fr] sm:gap-8">
                            <dt class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.14em] text-black/70">
                                <Icon name={row.icon} class="h-4 w-4 shrink-0 text-primary" aria-hidden="true" />
                                {row.label}
                            </dt>
                            <dd class="text-base font-semibold leading-snug text-black sm:text-lg">
                                {row.href ? (
                                    <a
                                        href={row.href}
                                        class="underline decoration-primary/40 underline-offset-4 transition hover:text-primary focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                                    >
                                        {row.text}
                                    </a>
                                ) : (
                                    row.text
                                )}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </address>

        {
            domainOwnership && (
                <p
                    id="domain-ownership"
                    class="mt-8 rounded-3xl border border-primary/20 bg-primary/[0.06] px-6 py-5 text-base font-semibold leading-relaxed text-black sm:text-lg"
                >
                    {domainOwnership}
                </p>
            )
        }
    </section>

    <!-- Verificación en fuentes oficiales del Estado ecuatoriano -->
    {
        verificationLinks.length > 0 && (
            <section
                class="mx-auto mt-16 w-[94%] max-w-[1200px] rounded-[2.5rem] bg-primary px-6 py-14 text-white sm:px-12 lg:rounded-[4rem] lg:px-16 lg:py-20"
                aria-labelledby="legal-sources-title"
            >
                <h2 data-scroll-float id="legal-sources-title" class="font-display text-3xl font-black leading-tight sm:text-5xl">
                    {t("transparency.officialSources")}
                </h2>

                <ul class="mt-10 grid gap-3 sm:grid-cols-2">
                    {verificationLinks.map((link) => (
                        <li>
                            <a
                                href={link!.href!}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex h-full items-center gap-3 rounded-2xl bg-white/10 px-5 py-4 font-semibold transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary"
                            >
                                <Icon name="mdi:shield-check-outline" class="h-5 w-5 shrink-0 text-secondary" aria-hidden="true" />
                                <span>{link!.text}</span>
                                <Icon name="mdi:external-link" class="h-4 w-4 shrink-0" aria-hidden="true" />
                                <span class="sr-only">{t("transparency.opensNewTab")}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        )
    }

    <!-- Documentos oficiales -->
    <section class="mx-auto w-[90%] max-w-[1100px] pt-16 sm:pt-24" aria-labelledby="legal-documents-title">
        <h2 data-scroll-float id="legal-documents-title" class="font-display text-3xl font-black leading-tight text-primary sm:text-5xl">{t("transparency.documents")}</h2>

        {
            documents.length > 0 ? (
                <ul class="mt-10 grid gap-4 sm:grid-cols-2" data-reveal-group>
                    {documents.map((doc) => (
                        <li>
                            <a
                                href={documentUrl(doc!.file!.url)}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex h-full items-start gap-4 rounded-3xl border border-black/10 bg-white/60 px-6 py-5 transition hover:border-primary hover:bg-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                            >
                                <Icon name="mdi:file-document-outline" class="mt-0.5 h-6 w-6 shrink-0 text-primary" aria-hidden="true" />
                                <span>
                                    <span class="block font-display text-lg font-bold leading-snug text-black">{doc!.title}</span>
                                    {doc!.note && <span class="mt-1 block text-sm leading-relaxed text-black/70">{doc!.note}</span>}
                                    <span class="sr-only">{t("transparency.opensPdf")}</span>
                                </span>
                            </a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p class="mt-8 max-w-[70ch] text-lg leading-relaxed text-black/75">{t("transparency.certificates")}</p>
            )
        }

        {d.note && <p class="mt-10 max-w-[75ch] rounded-3xl bg-black/[0.04] px-6 py-5 text-sm leading-relaxed text-black/75">{d.note}</p>}
    </section>

    <!-- Datos y cookies (#datos). El aviso de cookies enlaza directamente a
         este ancla: es la explicación de lo que la etiqueta de medición hace,
         escrita al lado del código que lo hace (ver el componente). -->
    <DataAndCookies email={d.email} legalName={d.legalName} />
</PageLayout>
