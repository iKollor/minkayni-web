---
import PageLayout from "../layouts/PageLayout.astro";
import Button from "../components/Button.astro";
import { Image } from "astro:assets";
import { Markdown } from "@astropub/md";
import flor from "../assets/SVG/misc/flor.svg";
import MaskFlor from "../components/MaskFlor.astro";
import foto from "../assets/FOTO_BATUCADA.webp";
import { impactFallback } from "../data/pages/impact";
import { loadPageContent } from "../utils/page-content";
import { formatTitle } from "../utils/rich-title";

/* Contenido: single type `impact-page` en Strapi, con fallback local. */
const d = await loadPageContent("impactPage", impactFallback);

/* Estilos por posición de las tarjetas de cifras (presentacional). */
const statStyles = [
    { bg: "bg-primary text-white", dim: "text-white/75" },
    { bg: "bg-secondary text-black", dim: "text-black/70" },
    { bg: "bg-accent text-black", dim: "text-black/70" },
    { bg: "bg-black text-white", dim: "text-white/70" },
];
---

<PageLayout title="Impacto" navbarThreshold={0.5}>
    <!-- Intro -->
    <section class="mx-auto w-[90%] max-w-[1280px] py-20 sm:py-28" aria-labelledby="impact-intro-title">
        <div class="grid items-end gap-10 lg:grid-cols-[1.1fr_0.9fr]">
            <div data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.intro.eyebrow}</p>
                <h2 id="impact-intro-title" class="font-display text-5xl font-black leading-[0.92] tracking-tight text-black sm:text-7xl" set:html={formatTitle(d.intro.title, "text-secondary-deep")} />
            </div>
            <div class="max-w-[62ch] text-lg leading-relaxed text-black/75 lg:pb-2" data-reveal data-reveal-delay="0.1">
                <p>{d.intro.body}</p>
            </div>
        </div>

        <nav class="mt-10 flex flex-wrap gap-2" aria-label="Secciones de esta página" data-reveal data-reveal-delay="0.15">
            {
                d.sectionNav.map((s) => (
                    <a
                        href={s.href}
                        class="min-h-11 rounded-full border border-black/15 px-5 py-2.5 font-display text-sm font-bold text-black/80 transition hover:border-primary hover:text-primary focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                    >
                        {s.text}
                    </a>
                ))
            }
        </nav>

        <!-- Cifras -->
        <div id="cifras" class="mt-14 grid gap-5 scroll-mt-28 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
            {
                d.stats.map((stat, index) => {
                    const style = statStyles[index % statStyles.length];
                    return (
                        <div class={`rounded-[2.25rem] p-8 transition duration-300 hover:-translate-y-2 ${style.bg}`}>
                            <p class="font-display text-6xl font-black tabular-nums">
                                <span data-count={stat.target} data-count-prefix={stat.prefix ?? ""} data-count-suffix={stat.suffix ?? ""}>{stat.value}</span>
                            </p>
                            <p class="mt-3 font-display text-lg font-bold leading-snug">{stat.label}</p>
                            <p class={`mt-2 text-sm leading-relaxed ${style.dim}`}>{stat.detail}</p>
                        </div>
                    );
                })
            }
        </div>
        <div class="mt-6 text-sm text-black/60 [&_a]:underline [&_a]:underline-offset-4 [&_a:hover]:text-primary" data-reveal>
            <Markdown of={d.statsNote} />
        </div>
    </section>

    <!-- Resultados medidos -->
    <section
        id="resultados"
        class="mx-auto w-[94%] max-w-[1440px] scroll-mt-28 rounded-[2.75rem] bg-[linear-gradient(130deg,var(--primary),#410063)] px-6 py-16 text-white sm:px-12 lg:rounded-[5rem] lg:px-20 lg:py-24"
        aria-labelledby="results-title"
    >
        <div class="grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
            <div data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary">{d.resultsHeading.eyebrow}</p>
                <h2 id="results-title" class="font-display text-4xl font-black leading-[0.95] sm:text-6xl" set:html={formatTitle(d.resultsHeading.title)} />
                <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-white/80">{d.resultsHeading.body}</p>
                <blockquote class="mt-8 max-w-[52ch] border-l-2 border-secondary pl-5 text-lg italic leading-relaxed text-white/85">
                    {d.resultsQuote}
                    <cite class="mt-2 block text-sm not-italic text-white/60">{d.resultsQuoteCite}</cite>
                </blockquote>
                <a href={d.resultsLink.href} class="mt-8 inline-flex items-center gap-2 font-display font-bold text-secondary underline-offset-4 transition hover:text-white hover:underline">
                    {d.resultsLink.text} <span aria-hidden="true">→</span>
                </a>
            </div>
            <div class="grid gap-4 sm:grid-cols-2" data-reveal-group>
                {
                    d.results.map((r) => (
                        <div class="rounded-[1.75rem] bg-white/10 p-6 backdrop-blur sm:p-8">
                            <p class="font-display text-5xl font-black tabular-nums text-secondary">
                                <span data-count={r.target} data-count-prefix={r.prefix ?? ""} data-count-suffix={r.suffix ?? "%"}>{r.value}</span>
                            </p>
                            <p class="mt-3 leading-relaxed text-white/85">{r.detail}</p>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="mt-14 border-t border-white/15 pt-10">
            <p class="mb-6 text-sm font-bold uppercase tracking-[0.22em] text-white/60">{d.otherProcessesTitle}</p>
            <div class="grid gap-4 lg:grid-cols-2" data-reveal-group>
                {
                    d.otherProcesses.map((p) => (
                        <div class="rounded-[1.75rem] bg-white/5 p-6 sm:p-8">
                            <h3 class="font-display text-lg font-bold text-white">{p.title}</h3>
                            <ul class="mt-4 flex flex-wrap gap-2">
                                {(p.metrics ?? []).map((m) => (
                                    <li class="rounded-full bg-white/10 px-4 py-1.5 text-sm text-white/85">{m?.text}</li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Reconocimientos -->
    <section id="reconocimientos" class="mx-auto w-[90%] max-w-[1280px] scroll-mt-28 py-24" aria-labelledby="awards-title">
        <div class="mb-12 max-w-[760px]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{d.awardsHeading.eyebrow}</p>
            <h2 id="awards-title" class="font-display text-4xl font-black leading-none text-primary sm:text-6xl" set:html={formatTitle(d.awardsHeading.title)} />
        </div>

        <div class="grid gap-5 md:grid-cols-2" data-reveal-group>
            {
                d.awards.map((r) => (
                    <article class="flex flex-col rounded-[2.25rem] bg-[#dedbd4] p-8 transition duration-300 hover:-translate-y-2 sm:p-10">
                        <div class="flex flex-wrap items-center gap-2">
                            {r.year && <span class="rounded-full bg-primary px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-white">{r.year}</span>}
                            {r.recipient && <span class="rounded-full bg-accent px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] text-black">{r.recipient}</span>}
                            {r.org && <span class="rounded-full bg-black/10 px-3 py-1 text-xs font-bold text-black">{r.org}</span>}
                        </div>
                        <h3 class="mt-6 font-display text-3xl font-bold text-black">{r.title}</h3>
                        <p class="mt-3 leading-relaxed text-black/75">{r.text}</p>
                        {r.href && (
                            <a
                                href={r.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="mt-auto pt-6 text-sm font-bold text-primary underline underline-offset-4 transition hover:text-secondary-deep"
                            >
                                {r.linkText ?? "Ver la fuente"} ↗
                            </a>
                        )}
                    </article>
                ))
            }
        </div>
        <p class="mt-6 max-w-[80ch] text-sm text-black/60" data-reveal>{d.awardsNote}</p>
    </section>

    <!-- Prensa -->
    <section id="prensa" class="mx-auto w-[90%] max-w-[1280px] scroll-mt-28 pb-28" aria-labelledby="press-impact-title">
        <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr]">
            <div class="relative mx-auto hidden items-center justify-center lg:flex" data-reveal>
                <div class="absolute -right-6 -top-8 h-28 w-28" data-float aria-hidden="true"><Image src={flor} alt="" class="h-full w-full object-cover" /></div>
                <div class="absolute -bottom-6 -left-8 h-24 w-24" data-float aria-hidden="true"><Image src={flor} alt="" class="h-full w-full object-cover" /></div>
                <MaskFlor src={foto} alt="Integrantes de Batucada Popular en presentación" className="h-72 w-72 shadow-lg xl:h-96 xl:w-96" />
            </div>
            <div data-reveal data-reveal-delay="0.1">
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.pressHeading.eyebrow}</p>
                <h2 id="press-impact-title" class="font-display text-4xl font-black leading-none text-black sm:text-6xl" set:html={formatTitle(d.pressHeading.title)} />
                <ul class="mt-8 divide-y divide-black/10">
                    {
                        d.pressItems.map((p) => (
                            <li>
                                <a href={p.href} target="_blank" rel="noopener noreferrer" class="group flex items-baseline justify-between gap-4 py-4 transition hover:text-primary">
                                    <span class="leading-snug">
                                        <span class="font-display font-bold">{p.title}</span>
                                        <span class="ml-2 whitespace-nowrap text-sm text-black/60">
                                            {p.outlet} · {p.year}
                                        </span>
                                    </span>
                                    <span class="text-primary opacity-0 transition group-hover:opacity-100" aria-hidden="true">
                                        ↗
                                    </span>
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </div>
        </div>
    </section>

    <!-- Sigue el recorrido -->
    <section class="mx-auto w-[90%] max-w-[1280px] pb-24" aria-labelledby="journey-title">
        <div class="mb-10 max-w-[760px]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{d.journeyHeading.eyebrow}</p>
            <h2 id="journey-title" class="font-display text-4xl font-black leading-none text-black sm:text-5xl" set:html={formatTitle(d.journeyHeading.title)} />
        </div>
        <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
            {
                d.journeyCards.map((item) => (
                    <a
                        href={item.href}
                        class="group flex flex-col rounded-[2.25rem] border border-black/10 p-8 transition duration-300 hover:-translate-y-2 hover:border-primary/40 hover:shadow-[0_24px_50px_rgba(35,15,55,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:p-10"
                    >
                        <p class="text-xs font-bold uppercase tracking-[0.22em] text-black/50 transition group-hover:text-primary">{item.eyebrow}</p>
                        <h3 class="mt-4 font-display text-2xl font-bold text-black transition group-hover:text-primary">{item.title}</h3>
                        <p class="mt-3 leading-relaxed text-black/70">{item.text}</p>
                        <span class="mt-auto pt-6 font-display font-bold text-primary opacity-70 transition group-hover:opacity-100" aria-hidden="true">
                            Seguir leyendo →
                        </span>
                    </a>
                ))
            }
        </div>
    </section>

    <!-- CTA -->
    <section
        class="mx-auto mb-44 md:mb-80 w-[94%] max-w-[1440px] overflow-hidden rounded-[2.75rem] bg-accent px-6 py-16 text-black sm:px-12 lg:rounded-[5rem] lg:px-20 lg:py-20"
        aria-labelledby="impact-cta-title"
    >
        <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
            <div class="max-w-[760px]" data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.ctaHeading.eyebrow}</p>
                <h2 id="impact-cta-title" class="font-display text-5xl font-black leading-[0.95] sm:text-7xl" set:html={formatTitle(d.ctaHeading.title)} />
                <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-black/75">{d.ctaHeading.body}</p>
            </div>
            <Button href={d.ctaButton.href} defaultText={d.ctaButton.defaultText} hoverText={d.ctaButton.hoverText} />
        </div>
    </section>
</PageLayout>

<script>
    import { initBatucadaAnchors } from "../scripts/batucada/motion";
    import { initReveals, initCounters } from "../scripts/reveals";

    const initImpact = () => {
        initBatucadaAnchors(); // anclas internas con offset por navbar fija
        initCounters();
        initReveals();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initImpact, { once: true });
    } else {
        initImpact();
    }
</script>
