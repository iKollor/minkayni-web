---
import PageLayout from "../layouts/PageLayout.astro";
import CardInfo from "../components/CardInfo.astro";
import Slider from "../components/Slider.astro";
import Card from "../components/Card.astro";
import Image from "astro/components/Image.astro";
import flor from "../assets/SVG/misc/flor.svg";
import MaskFlor from "../components/MaskFlor.astro";
import foto from "../assets/FOTO_BATUCADA.webp";
---

<PageLayout title="Impacto" navbarThreshold={0.5}>
    <section class="w-screen h-fit flex flex-col mt-30 mb-5 items-center">
        <CardInfo
            isVisible={true}
            buttonText="Conversemos"
            href="/about#contacto"
            text="Batucada Popular convierte la música en un espacio seguro de formación, liderazgo y convivencia. El proceso acompaña a 300 jóvenes en 11 sectores de Guayaquil y fortalece una red de más de 40 líderes juveniles."
        />
    </section>

    <section class="w-screen h-fit flex flex-col mt-10 mb-5 sm:mb-20 items-center">
        <Slider
            slides={[
                {
                    isVisible: false,
                    buttonText: "Conoce más",
                    href: "/projects#batucada-popular",
                    text: "El tambor convoca y abre una primera experiencia de pertenencia. Desde ahí comienza un proceso sostenido de escucha, disciplina y creación colectiva.",
                },
                {
                    isVisible: false,
                    buttonText: "Ver metodología",
                    href: "/projects#metodologia",
                    text: "La práctica artística se combina con formación en derechos, cultura de paz y liderazgo para que cada participante reconozca su capacidad de actuar.",
                },
                {
                    isVisible: false,
                    buttonText: "Únete",
                    href: "/about#contacto",
                    text: "Familias, liderazgos barriales y organizaciones sostienen los espacios seguros y ayudan a que las oportunidades lleguen a nuevas comunidades.",
                },
            ]}
            interval={4000}
        />
    </section>

    <section class="w-screen h-fit flex flex-col md:flex-row flex-wrap gap-8 justify-center items-center mt-30 mb-2 px-4">
        <Card
            tittle="Expresión y autoestima"
            text="La práctica artística ofrece un lenguaje para reconocer emociones, desarrollar confianza y descubrir capacidades propias."
            buttontext="Conoce el proyecto"
            href="/projects#batucada-popular"
        />
        <Card
            tittle="Liderazgo juvenil"
            text="Las y los participantes asumen responsabilidades, acompañan a sus pares y convierten la experiencia en acción colectiva."
            buttontext="Nuestra metodología"
            href="/projects#metodologia"
        />
        <Card
            tittle="Redes que protegen"
            text="Familias, liderazgos locales y aliados se articulan para sostener oportunidades y espacios de encuentro en el territorio."
            buttontext="Hagamos minka"
            href="/about#contacto"
        />
    </section>

    <section class="w-screen h-fit flex flex-col md:flex-row items-center justify-center mt-30 px-6 md:px-12 mb-50 sm:mb-100">
        <div class="w-full md:w-1/2 min-h-[25vw] flex justify-center items-center relative z-20">
            <div class="absolute bottom-30 left-10 sm:bottom-70 sm:left-20 w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40 lg:w-48 lg:h-48 z-0">
                <Image src={flor} alt="flor decorativa" class="object-cover w-full h-full" />
            </div>
            <MaskFlor src={foto} alt="Integrantes de Batucada Popular" className="w-56 h-56 shadow-lg z-10 sm:w-64 sm:h-64 md:w-120 md:h-120 lg:w-120" />
        </div>

        <div class="flex flex-col gap-6 rounded-3xl bg-(--bg-indigo-bright) text-(--bg-white) px-6 sm:px-8 md:px-12 lg:px-16 py-8 sm:py-10 md:py-12 lg:py-16 md:-translate-x-10 lg:-translate-x-40 max-w-2xl shadow-lg sm:translate-y-0 -translate-y-8">
            <h1 class="text-3xl sm:text-4xl md:text-5xl text-center font-semibold">Informe de avance</h1>
            <p class="text-sm sm:text-base md:text-lg leading-relaxed text-justify">
                Medimos el impacto observando la permanencia, la participación, los liderazgos que nacen y las redes comunitarias que se fortalecen. Desde 2020, Batucada Popular ha crecido hasta vincular a 300 jóvenes y más de 40 líderes en 11 sectores de Guayaquil. Los reportajes publicados en 2025 y 2026 también documentan el papel del arte en la prevención del reclutamiento y la construcción de comunidades resilientes.
            </p>
        </div>
    </section>
</PageLayout>
