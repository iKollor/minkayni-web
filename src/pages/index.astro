---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Logo from "../assets/SVG/LOGO_HEADER_WHITE.svg";
import Tag from "../components/index/Tag.astro";
import Moments from "../components/index/Moments.astro";
import Testimonials from "../components/index/Testimonials.astro";
import Nosotros from "../components/index/Nosotros.astro";
import IntroVideo from "../components/IntroVideo.astro";
import { BubbleBackground } from "@/components/animate-ui/components/backgrounds/bubble";

import { Markdown } from "@astropub/md";

import { getEntry } from "astro:content";

import { getData } from "../utils/i18n";
import Projects from "../components/index/Projects.astro";
import { fallbackLegend } from "../data/site";
import { homepageTextsFallback } from "../data/pages/global";

const homepage = await getEntry("homepage", "homepage");

const testimonials = getData(homepage, "Testimonials", "es", []);
const teams = getData(homepage, "Teams", "es", []);
const legend = getData(homepage, "legend", "es", fallbackLegend);
const testimonialsTitle = getData(homepage, "testimonialsTitle", "es", homepageTextsFallback.testimonialsTitle) || homepageTextsFallback.testimonialsTitle;
const teamTitle = getData(homepage, "teamTitle", "es", homepageTextsFallback.teamTitle) || homepageTextsFallback.teamTitle;
const featuredProject = homepage ? getData(homepage, "featuredProject", "es", null) : null;
---

<MainLayout title="">
    <style is:global>
        /* Hint para evitar glitches al animar clip-path: forzar rasterización/GPU */
        #app-content {
            will-change: clip-path;
            transform: translateZ(0);
            -webkit-transform: translateZ(0);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        @supports not (clip-path: circle(50% at 50% 50%)) {
            #app-content {
                clip-path: none !important;
            }
        }

        #odometer {
            overflow: visible;
            font-variant-numeric: normal;
            letter-spacing: 0;
        }
        #odometer .digit {
            display: inline-block;
            position: relative;
            overflow: visible;
            height: 1em;
            width: auto;
            min-width: 0;
            padding: 0;
            margin: 0;
            font-variant-numeric: inherit;
        }
        #odometer .digit span {
            display: block;
            width: auto;
        }

        #foundation-text {
            opacity: 0;
            visibility: hidden;
        }
        #hero-background {
            contain: paint;
            will-change: background;
        }
    </style>

    <IntroVideo />

    <!-- Contenido principal -->
    <div id="app-content" class="opacity-0 transition-opacity duration-500">
        <header>
            <div class="header__container w-full relative">
                <div id="hero-background" class="bg__container absolute top-0 left-0 w-full h-[50vh] md:h-screen z-20 bg-[var(--primary)]">
                    <BubbleBackground
                        interactive={true}
                        colors={{
                            first: "140,100,255",
                            second: "18,113,255",
                            third: "140,100,255",
                            fourth: "63,169,245",
                            fifth: "140,100,255",
                            sixth: "63,169,245",
                        }}
                        client:load
                    >
                        <div class="z-10 relative flex justify-center items-center h-full">
                            <Image class="logo pointer-events-none w-[70svw] sm:w-[50svw] md:w-[40svw] mb-2 mr-[2px]" src={Logo} alt="Logo" />
                        </div>
                    </BubbleBackground>
                </div>
                <div class="bottom__section__container w-full md:w-[90%] min-h-[100svh] flex flex-col-reverse md:flex-row mx-auto pt-[70svh] justify-end items-center">
                    <div class="prose w-full md:w-1/2 h-[80%] text-[color:var(--text)] opacity-80 text-lg md:text-base max-w-[90%] md:max-w-[50%] text-center md:text-left leading-relaxed pt-5 md:pt-0" id="foundation-text">
                        <Markdown of={legend} class="prose" />
                    </div>
                </div>
            </div>
        </header>

        <div id="moments">
            <section class="max-w-[1200px] mx-auto my-16 px-4"><Tag /></section>
            <section class="my-24">
                <Moments />
            </section>
            <!-- Reemplazado: ahora cargamos el módulo de animaciones de Moments -->
            <script src="../scripts/moments.ts"></script>
        </div>
        <section id="testimonials">
            {
                testimonials.length > 0 ? (
                    <Testimonials testimonials={testimonials} title={testimonialsTitle} />
                ) : (
                    <div class="mx-auto w-[90%] max-w-[1200px] py-24 sm:py-32">
                        <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{testimonialsTitle}</p>
                        <blockquote class="rounded-[2.75rem] bg-secondary p-8 text-black sm:p-14 lg:rounded-[5rem] lg:p-20">
                            <p class="max-w-[32ch] font-display text-4xl font-black leading-[1.05] sm:text-6xl">“Aprendí a tocar el tambor, a manejar mejor mi carácter y encontré buenos amigos.”</p>
                            <footer class="mt-8 text-lg font-bold">Daniel · Integrante de Batucada Popular</footer>
                        </blockquote>
                    </div>
                )
            }
        </section>

        <section id="about-us">
            {
                teams.length > 0 ? (
                    <Nosotros data={teams} title={teamTitle} />
                ) : (
                    <div class="mx-auto grid w-[90%] max-w-[1200px] items-center gap-8 py-24 sm:py-32 lg:grid-cols-[1fr_auto]">
                        <div>
                            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary">Quiénes somos</p>
                            <h2 class="max-w-[14ch] font-display text-5xl font-black leading-[0.92] text-primary sm:text-7xl">Un equipo que cree en el trabajo compartido.</h2>
                            <p class="mt-6 max-w-[54ch] text-lg leading-relaxed text-black/65">Educación, arte y organización comunitaria se encuentran para acompañar a las juventudes y sostener procesos que nacen desde el territorio.</p>
                        </div>
                        <a href="/about" class="inline-flex min-h-14 items-center justify-center rounded-full bg-primary px-7 py-4 font-display text-lg font-bold text-white transition hover:-translate-y-1 hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">Conoce a Minkayni</a>
                    </div>
                )
            }
        </section>
        <section id="projects">
            <Projects content={featuredProject} />
        </section>
    </div>
    <script>
        import { init } from "../scripts/index/init.ts";

        init();
    </script>
</MainLayout>

<script>
    import { gsap } from "../scripts/main";

    if (typeof window !== "undefined") {
        const initTitles = () => {
            const nodeList = document.querySelectorAll(".title, #title") as NodeListOf<HTMLElement>;
            const titles = Array.from(nodeList) as HTMLElement[];
            if (!titles.length) return;

            titles.forEach((el) => {
                if (el.dataset.gsapTitleInit) return;
                el.dataset.gsapTitleInit = "1";

                gsap.fromTo(
                    el,
                    { y: 80, opacity: 0, willChange: "transform, opacity" },
                    {
                        y: 0,
                        opacity: 1,
                        ease: "power1.out",
                        duration: 0.8,
                        scrollTrigger: {
                            trigger: el,
                            start: "top 85%",
                            end: "bottom 60%",
                            toggleActions: "play none none reverse",
                        },
                    }
                );
            });
        };

        if (document.readyState === "complete" || document.readyState === "interactive") {
            initTitles();
        } else {
            window.addEventListener("DOMContentLoaded", initTitles, { once: true });
        }

        const observer = new MutationObserver((mutations) => {
            for (const m of mutations) {
                if (m.addedNodes && m.addedNodes.length) {
                    initTitles();
                    break;
                }
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });

        window.addEventListener("beforeunload", () => observer.disconnect());
    }
</script>
