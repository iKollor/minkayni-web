---
import MainLayout from "../layouts/MainLayout.astro";
import { Image } from "astro:assets";
import Logo from "../assets/SVG/LOGO_HEADER_WHITE.svg";
import Tag from "../components/index/Tag.astro";
import Moments from "../components/index/Moments.astro";
import Testimonials from "../components/index/Testimonials.astro";
import Nosotros from "../components/index/Nosotros.astro";
import IntroVideo from "../components/IntroVideo.astro";
import BubbleBackground from "@/components/index/BubbleBackground.astro";

import Markdown from "@/components/Markdown.astro";

import { getCollection, getEntry } from "astro:content";

import { getData } from "../utils/i18n";
import { localizeCollection, localizeEntry } from "../utils/page-content";
import { getLocale, localizePath, useTranslations } from "../i18n";
import Projects from "../components/index/Projects.astro";
import ProjectsCta from "../components/index/ProjectsCta.astro";
import HelpCta from "../components/index/HelpCta.astro";
import { loadPageContent } from "../utils/page-content";
import { globalFallback } from "../data/pages/global";
import { fallbackLegend, fallbackLegendEn } from "../data/site";
import { homepageTextsFallback } from "../data/pages/global";

const locale = getLocale(Astro.url);
const t = useTranslations(locale);

/* La portada en inglés lee `homepageEn` sobre `homepage`: lo que todavía no
   esté traducido en el CMS sale en español en lugar de salir vacío. */
const homepage = await localizeEntry(await getEntry("homepage", "homepage"), "homepageEn", "homepage", locale);

/* Testimonios y Equipo: collection types en Strapi, ordenados por `sort`
   (menor primero) y luego por fecha de creación. */
const bySort = (a: { sort?: number | null; createdAt?: string | null }, b: { sort?: number | null; createdAt?: string | null }) =>
    (a.sort ?? 0) - (b.sort ?? 0) || String(a.createdAt ?? "").localeCompare(String(b.createdAt ?? ""));

const readCollection = async (name: "testimonials" | "testimonialsEn" | "teamMembers" | "teamMembersEn") => {
    try {
        return (await getCollection(name)).map((entry) => entry.data);
    } catch {
        return [];
    }
};

/* En inglés, cada testimonio o ficha traducida sustituye a su original; las
   que aún no lo estén salen en español. */
const testimonials = localizeCollection(
    await readCollection("testimonials"),
    locale === "en" ? await readCollection("testimonialsEn") : [],
    locale
).sort(bySort);
const teams = localizeCollection(
    await readCollection("teamMembers"),
    locale === "en" ? await readCollection("teamMembersEn") : [],
    locale
).sort(bySort);
const legend = getData(homepage, "legend", undefined, locale === "en" ? fallbackLegendEn : fallbackLegend);
const testimonialsTitle = getData(homepage, "testimonialsTitle", undefined, homepageTextsFallback.testimonialsTitle) || homepageTextsFallback.testimonialsTitle;
const teamTitle = getData(homepage, "teamTitle", undefined, homepageTextsFallback.teamTitle) || homepageTextsFallback.teamTitle;
const featuredProject = homepage ? getData(homepage, "featuredProject", undefined, null) : null;
/* Contacto (correo y WhatsApp) del single type `global`, para la sección de
   cierre «Cómo puedes ayudar». */
const site = await loadPageContent("globalSettings", globalFallback, locale);
/* Misma regla que MainLayout: la intro solo se reproduce con PUBLIC_HOME_INTRO=on. */
const intro = import.meta.env.PUBLIC_HOME_INTRO === "on";
const projectsCta = homepage
    ? {
          heading: getData(homepage, "projectsCtaHeading", undefined, null),
          tags: getData(homepage, "projectsCtaTags", undefined, []),
          button: getData(homepage, "projectsCtaButton", undefined, null),
      }
    : null;
---

<MainLayout title="">
    <style is:global>
        /* Hint para evitar glitches al animar clip-path: forzar rasterización/GPU */
        #app-content {
            will-change: clip-path;
            transform: translateZ(0);
            -webkit-transform: translateZ(0);
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
        }
        @supports not (clip-path: circle(50% at 50% 50%)) {
            #app-content {
                clip-path: none !important;
            }
        }

        #odometer {
            overflow: visible;
            font-variant-numeric: normal;
            letter-spacing: 0;
        }
        #odometer .digit {
            display: inline-block;
            position: relative;
            overflow: visible;
            height: 1em;
            width: auto;
            min-width: 0;
            padding: 0;
            margin: 0;
            font-variant-numeric: inherit;
        }
        #odometer .digit span {
            display: block;
            width: auto;
        }

        /* ── Nada oculto en el HTML ──────────────────────────────────────
           El contenido de la portada viene visible en el documento y se
           pinta con el primer cuadro. Solo se tapa cuando hay JavaScript y
           la intro va a reproducirse: `html[data-intro="pending"]` lo
           escribe head.astro antes del primer pintado, solo en visitas
           nuevas, e `intro.ts` lo retira al terminar. La regla lleva una
           animación de seguridad que devuelve la visibilidad pasado un
           tiempo, por si el script no llega a ejecutarse: nunca una
           pantalla en blanco por un fallo de red.

           La leyenda (#foundation-text) ya no se esconde aquí: en móvil es
           el elemento más grande de la primera pantalla —el LCP que mide
           PageSpeed— y ocultarla hasta que cargaran el script y las fuentes
           costaba seis segundos. Su cascada palabra a palabra la decide
           scripts/index/paragraph.ts, y solo cuando el texto aún no está a
           la vista. */
        html[data-intro="pending"] #app-content {
            opacity: 0;
            animation: app-content-safety 0.5s ease 12s forwards;
        }
        @keyframes app-content-safety {
            to {
                opacity: 1;
            }
        }
        #hero-background {
            contain: paint;
            will-change: background;
        }

        /* Altura final del hero. Vive aquí y la lee `intro.ts` para animar hasta
           el mismo valor: antes el 70svh estaba escrito por duplicado (clase
           `pt-[70svh]` y tres literales en el script), y cualquier cambio en uno
           dejaba el texto pegado al degradado o flotando lejos de él. */
        :root {
            --hero-h: 70svh;
            /* Separación entre el degradado y la leyenda. En móvil el texto va
               debajo y necesita aire; en escritorio va al costado y no. */
            --hero-gap: 2.5rem;
            /* Ancho del logotipo sobre el degradado. `IntroVideo.astro` escala
               su lienzo a partir de este mismo valor, así que la animación
               termina con el logotipo justo del tamaño del que queda aquí. */
            --logo-w: 70svw;
        }

        @media (min-width: 640px) {
            :root {
                --logo-w: 50svw;
            }
        }

        @media (min-width: 768px) {
            :root {
                --hero-gap: 0px;
                --logo-w: 40svw;
            }
        }

        header .bottom__section__container {
            padding-top: calc(var(--hero-h) + var(--hero-gap));
        }
    </style>

    {intro && <IntroVideo />}

    <!-- Contenido principal. Visible en el HTML: solo lo tapa la intro
         mientras se reproduce (ver el <style> de arriba). -->
    <main id="app-content" class="transition-opacity duration-500">
        <header>
            <div class="header__container w-full relative">
                <!-- El título visual de la portada es el logotipo (una imagen), así
                     que el h1 del documento va aquí, disponible para lectores de
                     pantalla y rastreadores sin alterar el diseño. -->
                <h1 class="sr-only">{t("home.title")}</h1>
                {/* Sin intro, el degradado nace ya con su altura y radio finales
                    (`--hero-h`, 30 px): antes venía a 50svh/100svh y `intro.ts`
                    lo llevaba a 70svh al cargar, y ese cambio movía el logotipo
                    y las burbujas ya pintados —era el salto de diseño (CLS 0,07)
                    que PageSpeed anotaba en la portada—. Con intro sí arranca a
                    pantalla completa: la animación lo encoge al terminar. */}
                <div
                    id="hero-background"
                    data-nav-theme="dark"
                    class:list={[
                        "bg__container absolute top-0 left-0 w-full z-20 bg-[var(--primary)]",
                        intro ? "h-[50svh] md:h-svh" : "h-[var(--hero-h)] rounded-b-[30px]",
                    ]}>
                    <BubbleBackground
                        interactive
                        colors={{
                            second: "18,113,255",
                            third: "140,100,255",
                            fourth: "63,169,245",
                            fifth: "140,100,255",
                            sixth: "63,169,245",
                        }}
                    >
                        <div class="z-10 relative flex justify-center items-center h-full">
                            {/* Es el elemento más grande del primer pantallazo (LCP): se pide
                                con prioridad alta y sin `lazy`, que Astro pone por defecto. */}
                            <Image class="logo pointer-events-none w-[var(--logo-w)] mb-2 mr-[2px]" src={Logo} alt={t("alt.logo")} loading="eager" fetchpriority="high" />
                        </div>
                    </BubbleBackground>
                </div>
                <div class="bottom__section__container w-full md:w-[90%] min-h-[100svh] flex flex-col-reverse md:flex-row mx-auto pt-[70svh] justify-end items-center">
                    <div class="prose w-full md:w-1/2 text-[color:var(--text)] opacity-80 text-lg md:text-base max-w-[90%] md:max-w-[50%] text-center md:text-left leading-[1.55]" id="foundation-text">
                        <Markdown of={legend} />
                    </div>
                </div>
            </div>
        </header>

        <div id="moments">
            <section class="max-w-[1200px] mx-auto my-16 px-4"><Tag /></section>
            <section class="my-24">
                <Moments />
                <!-- El carrusel enseña las últimas fotos y nada más: sin texto
                     ni fecha. Este enlace lleva al listado completo, que sí es
                     contenido leíble y rastreable. Ver src/utils/novedades.ts. -->
                <p class="mt-10 text-center">
                    <a
                        class="font-display text-lg font-black text-primary underline underline-offset-4 transition hover:text-secondary-deep focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                        href={localizePath("/novedades", locale)}>{t("news.title")} →</a
                    >
                </p>
            </section>
            <!-- Reemplazado: ahora cargamos el módulo de animaciones de Moments -->
            <script src="../scripts/moments.ts"></script>
        </div>
        <section id="testimonials">
            {
                testimonials.length > 0 ? (
                    <Testimonials testimonials={testimonials} title={testimonialsTitle} locale={locale} />
                ) : (
                    <div class="mx-auto w-[90%] max-w-[1200px] py-24 sm:py-32">
                        <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{testimonialsTitle}</p>
                        <blockquote class="rounded-[2.75rem] bg-secondary p-8 text-black sm:p-14 lg:rounded-[5rem] lg:p-20">
                            <p class="max-w-[32ch] font-display text-4xl font-black leading-[1.05] sm:text-6xl">{t("home.danielQuote")}</p>
                            <footer class="mt-8 text-lg font-bold">{t("home.danielAttribution")}</footer>
                        </blockquote>
                    </div>
                )
            }
        </section>

        <section id="about-us">
            {
                teams.length > 0 ? (
                    <Nosotros data={teams} title={teamTitle} />
                ) : (
                    <div class="mx-auto grid w-[90%] max-w-[1200px] items-center gap-8 py-24 sm:py-32 lg:grid-cols-[1fr_auto]">
                        <div>
                            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{t("home.teamEyebrow")}</p>
                            <h2 data-scroll-float class="max-w-[14ch] font-display text-5xl font-black leading-[0.92] text-primary sm:text-7xl">{t("home.teamSubtitle")}</h2>
                            <p class="mt-6 max-w-[54ch] text-lg leading-[1.55] text-black/65">{t("home.teamBody")}</p>
                        </div>
                        <a href={localizePath("/about", locale)} class="inline-flex min-h-14 items-center justify-center rounded-full bg-primary px-7 py-4 font-display text-lg font-bold text-white transition hover:-translate-y-1 hover:bg-secondary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary">{t("home.teamCta")}</a>
                    </div>
                )
            }
        </section>
        <section id="projects">
            <Projects content={featuredProject} />
            <ProjectsCta content={projectsCta} last={false} />
        </section>
        <HelpCta contactEmail={site.contactEmail} whatsappUrl={site.whatsappUrl} />
    </main>
    <script>
        import { init } from "../scripts/index/init.ts";

        init();
    </script>
</MainLayout>

<script>
    import { gsap } from "../scripts/main";

    if (typeof window !== "undefined") {
        const initTitles = () => {
            /* Los títulos con ScrollFloat (`data-scroll-float`) ya se animan letra
               a letra; este fade-in-up encima tapaba ese efecto. */
            const nodeList = document.querySelectorAll(".title:not([data-scroll-float]), #title:not([data-scroll-float])") as NodeListOf<HTMLElement>;
            const titles = Array.from(nodeList) as HTMLElement[];
            if (!titles.length) return;

            titles.forEach((el) => {
                if (el.dataset.gsapTitleInit) return;
                el.dataset.gsapTitleInit = "1";

                gsap.fromTo(
                    el,
                    { y: 80, opacity: 0, willChange: "transform, opacity" },
                    {
                        y: 0,
                        opacity: 1,
                        ease: "power1.out",
                        duration: 0.8,
                        scrollTrigger: {
                            trigger: el,
                            start: "top 85%",
                            end: "bottom 60%",
                            toggleActions: "play none none reverse",
                        },
                    }
                );
            });
        };

        if (document.readyState === "complete" || document.readyState === "interactive") {
            initTitles();
        } else {
            window.addEventListener("DOMContentLoaded", initTitles, { once: true });
        }

        const observer = new MutationObserver((mutations) => {
            for (const m of mutations) {
                if (m.addedNodes && m.addedNodes.length) {
                    initTitles();
                    break;
                }
            }
        });
        observer.observe(document.body, { childList: true, subtree: true });

        window.addEventListener("beforeunload", () => observer.disconnect());
    }
</script>
