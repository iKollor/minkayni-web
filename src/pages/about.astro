---
import PageLayout from "../layouts/PageLayout.astro";
import { Image } from "astro:assets";
import MaskFlor from "../components/MaskFlor.astro";
import Button from "../components/Button.astro";
import CmsImage from "../components/CmsImage.astro";
import ImmersiveTimeline from "../components/ImmersiveTimeline.astro";
import flor from "../assets/SVG/misc/flor.svg";
import foto from "../assets/FOTO_BATUCADA.webp";
import comunidad from "../assets/batucada-popular/comunidad.webp";
import marcha from "../assets/batucada-popular/marcha.webp";
import daniel from "../assets/DANIEL.png";
import { aboutFallback } from "../data/pages/about";
import { loadPageContent } from "../utils/page-content";
import { formatTitle } from "../utils/rich-title";

/* Contenido: single type `about-page` en Strapi, con fallback local. */
const d = await loadPageContent("aboutPage", aboutFallback);

const { timeline, politicas, ecosistema } = {
    timeline: d.timeline,
    politicas: d.policies,
    ecosistema: d.ecosystemCards,
};

/* Estilos por posición de las tarjetas de líneas de acción (presentacional). */
const actionCardStyles = [
    { card: "bg-primary text-white", dim: "text-white/75" },
    { card: "bg-secondary text-black", dim: "text-black/65" },
    { card: "bg-accent text-black", dim: "text-black/65" },
];
---

<PageLayout title="Conócenos" navbarThreshold={0.5}>
    <!-- Quiénes somos -->
    <section class="mx-auto w-[90%] max-w-[1280px] py-20 sm:py-28" aria-labelledby="about-intro-title">
        <div class="grid items-center gap-14 lg:grid-cols-[1.05fr_0.95fr]">
            <div data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.intro.eyebrow}</p>
                <h2 id="about-intro-title" class="font-display text-5xl font-black leading-[0.92] tracking-tight text-black sm:text-7xl" set:html={formatTitle(d.intro.title, "text-secondary-deep")} />
                <p class="mt-8 max-w-[62ch] text-lg leading-relaxed text-black/70" set:html={formatTitle(d.intro.body ?? "", "italic")} />
            </div>

            <div class="relative mx-auto w-fit pb-16 pl-10 sm:pb-20" data-reveal data-reveal-delay="0.15">
                <div class="absolute -top-8 right-0 h-24 w-24 sm:h-32 sm:w-32" data-float aria-hidden="true"><Image src={flor} alt="" class="h-full w-full object-cover" /></div>
                <MaskFlor src={comunidad} alt="Integrantes de la Batucada Popular celebrando tras una presentación" className="h-72 w-72 shadow-xl sm:h-96 sm:w-96 lg:h-[28rem] lg:w-[28rem]" />
                <figure class="absolute -bottom-0 -left-0 w-44 rotate-[-6deg] overflow-hidden rounded-[1.25rem] border-[6px] border-white shadow-2xl sm:w-60" data-float>
                    <Image src={marcha} alt="Jóvenes marchando con tambores en el centro de Guayaquil" class="h-full w-full object-cover" />
                </figure>
            </div>
        </div>

        <div class="mt-16 grid gap-5 md:grid-cols-3" data-reveal-group>
            {
                d.actionLines.map((line, index) => {
                    const style = actionCardStyles[index % actionCardStyles.length];
                    return (
                        <div class={`rounded-[2.25rem] p-8 transition duration-300 hover:-translate-y-2 sm:p-10 ${style.card}`}>
                            <h3 class="mb-3 font-display text-2xl font-bold">{line.title}</h3>
                            <p class={`leading-relaxed ${style.dim}`}>{line.description}</p>
                        </div>
                    );
                })
            }
        </div>
    </section>

    <!-- Historia / línea de tiempo inmersiva -->
    <section class="mx-auto w-[94%] max-w-[1440px] rounded-[2.75rem] bg-[#dedbd4] px-4 py-14 sm:px-8 lg:rounded-[5rem] lg:px-14 lg:py-20" aria-labelledby="history-title">
        <div class="mb-10 max-w-[760px]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.historyHeading.eyebrow}</p>
            <h2 id="history-title" class="font-display text-4xl font-black leading-none text-black sm:text-6xl" set:html={formatTitle(d.historyHeading.title)} />
        </div>

        <ImmersiveTimeline items={timeline} ariaLabel="Historia de la fundación" />
    </section>

    <!-- Misión y visión -->
    <section class="mx-auto w-[90%] max-w-[1280px] py-24" aria-label="Misión y visión">
        <div class="grid gap-5 lg:grid-cols-2" data-reveal-group>
            <div class="relative overflow-hidden rounded-[2.75rem] bg-primary p-8 text-white sm:p-12">
                <Image src={flor} alt="" class="absolute -bottom-14 -right-12 h-56 w-56 rotate-12 opacity-15" aria-hidden="true" />
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary">{d.mission.title}</p>
                <p class="max-w-[58ch] text-lg leading-relaxed text-white/90">{d.mission.description}</p>
            </div>
            <div class="relative overflow-hidden rounded-[2.75rem] bg-secondary p-8 text-black sm:p-12">
                <Image src={flor} alt="" class="absolute -bottom-14 -right-12 h-56 w-56 -rotate-12 opacity-20" aria-hidden="true" />
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.vision.title}</p>
                <p class="max-w-[58ch] text-lg leading-relaxed text-black/80">{d.vision.description}</p>
            </div>
        </div>
    </section>

    <!-- Ecosistema -->
    <section class="mx-auto w-[90%] max-w-[1280px] pb-24" aria-labelledby="ecosystem-title">
        <div class="mb-12 max-w-[760px]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{d.ecosystemHeading.eyebrow}</p>
            <h2 id="ecosystem-title" class="font-display text-4xl font-black leading-none text-primary sm:text-6xl" set:html={formatTitle(d.ecosystemHeading.title)} />
            <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-black/70">{d.ecosystemHeading.body}</p>
        </div>

        <div class="grid gap-5 md:grid-cols-2" data-reveal-group>
            {
                ecosistema.map((item) => (
                    <article class={`flex flex-col rounded-[2.25rem] p-8 transition duration-300 hover:-translate-y-2 sm:p-10 ${item.dark ? "text-white" : "text-black"}`} style={`background: ${item.accentColor};`}>
                        <div class="flex items-start justify-between gap-4">
                            <span class={`rounded-full px-3 py-1 text-xs font-bold uppercase tracking-[0.14em] ${item.dark ? "bg-white/15 text-white" : "bg-black/10 text-black"}`}>{item.kind}</span>
                            {item.logo?.url && (
                                <span class="shrink-0 rounded-2xl bg-white/90 p-2 shadow-sm">
                                    <CmsImage media={item.logo} alt={`Logo de ${item.name}`} widths={[96, 192]} class="h-9 w-auto max-w-[7rem] object-contain" />
                                </span>
                            )}
                        </div>
                        <h3 class="mt-6 font-display text-3xl font-bold">{item.name}</h3>
                        <p class={`mt-3 leading-relaxed ${item.dark ? "text-white/80" : "text-black/70"}`}>{item.text}</p>
                        {item.instagramUrl && (
                            <a
                                href={item.instagramUrl}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`mt-auto inline-flex w-fit items-center gap-2 pt-5 text-sm font-bold underline underline-offset-4 transition ${item.dark ? "text-white/85 hover:text-white" : "text-black/75 hover:text-black"}`}
                            >
                                Instagram <span aria-hidden="true">↗</span>
                            </a>
                        )}
                    </article>
                ))
            }
        </div>
        <a
            href={d.ecosystemLink.href}
            class="mt-10 inline-flex items-center gap-2 font-display font-bold text-primary underline-offset-4 transition hover:text-secondary-deep hover:underline"
            data-reveal
        >
            {d.ecosystemLink.text} <span aria-hidden="true">→</span>
        </a>
    </section>

    <!-- Equipo -->
    <section class="mx-auto w-[90%] max-w-[1280px] pb-24" aria-labelledby="team-title">
        <div class="grid items-center gap-10 lg:grid-cols-[auto_1fr]">
            <div class="relative mx-auto flex items-center justify-center" data-reveal>
                <div class="absolute -left-8 -top-6 h-28 w-28 sm:h-36 sm:w-36" data-float aria-hidden="true"><Image src={flor} alt="" class="h-full w-full object-cover" /></div>
                <MaskFlor src={foto} alt="Integrantes de Batucada Popular junto al equipo de MINKAYNI" className="h-64 w-64 shadow-lg sm:h-80 sm:w-80 lg:h-96 lg:w-96" />
            </div>
            <div data-reveal data-reveal-delay="0.1">
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.teamHeading.eyebrow}</p>
                <h2 id="team-title" class="font-display text-4xl font-black leading-none text-black sm:text-6xl" set:html={formatTitle(d.teamHeading.title)} />
                <div class="mt-8 grid gap-6 sm:grid-cols-2">
                    {
                        d.teamMembers.map((member) => (
                            <div>
                                <h3 class="font-display text-xl font-bold text-primary">{member.title}</h3>
                                <p class="mt-2 leading-relaxed text-black/70">{member.description}</p>
                            </div>
                        ))
                    }
                </div>
                <p class="mt-6 max-w-[68ch] leading-relaxed text-black/70">{d.teamNote}</p>
            </div>
        </div>
    </section>

    <!-- Transparencia y gobernanza -->
    <section class="mx-auto w-[94%] max-w-[1440px] rounded-[2.75rem] bg-[linear-gradient(130deg,var(--primary),#410063)] px-6 py-16 text-white sm:px-12 lg:rounded-[5rem] lg:px-20 lg:py-24" aria-labelledby="transparency-title">
        <div class="mb-12 max-w-[760px]" data-reveal>
            <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary">{d.transparencyHeading.eyebrow}</p>
            <h2 id="transparency-title" class="font-display text-4xl font-black leading-[0.95] sm:text-6xl" set:html={formatTitle(d.transparencyHeading.title)} />
            <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-white/75">{d.transparencyHeading.body}</p>
        </div>

        <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
            {
                politicas.map((p) => (
                    <li class="rounded-[1.5rem] bg-white/10 px-5 py-4 backdrop-blur">
                        <p class="font-display font-bold leading-snug">{p.text}</p>
                        {p.meta && <p class="mt-1 text-sm text-white/60">Aprobado en {p.meta}</p>}
                    </li>
                ))
            }
        </ul>

        <p class="mt-10 max-w-[70ch] text-sm leading-relaxed text-white/65">{d.transparencyNote}</p>
    </section>

    <!-- Prensa -->
    <section class="mx-auto w-[90%] max-w-[1280px] py-24" aria-labelledby="press-title">
        <div class="grid items-center gap-10 lg:grid-cols-[1fr_auto]">
            <div data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{d.pressHeading.eyebrow}</p>
                <h2 id="press-title" class="font-display text-4xl font-black leading-none text-primary sm:text-6xl" set:html={formatTitle(d.pressHeading.title)} />
                <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-black/70">{d.pressHeading.body}</p>
                <a href={d.pressCta.href} class="mt-8 inline-flex items-center gap-2 font-display font-bold text-primary underline-offset-4 transition hover:text-secondary-deep hover:underline">
                    {d.pressCta.text} <span aria-hidden="true">→</span>
                </a>
            </div>
            <div class="flex flex-row items-center gap-14 lg:flex-col lg:gap-10" data-reveal data-reveal-delay="0.15">
                {
                    d.pressLinks.map((p) => (
                        <a
                            href={p.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`Leer en ${p.outlet}`}
                            class="transition hover:-translate-y-1"
                        >
                            <CmsImage media={p.logo} fallback={p.localLogo} alt={p.outlet ?? ""} widths={[64, 128]} class={p.logoClass ?? "w-16"} />
                        </a>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- Contacto -->
    <section id="contacto" class="mx-auto mb-44 w-[94%] max-w-[1440px] overflow-hidden rounded-[2.75rem] bg-accent px-6 py-16 text-black sm:px-12 md:mb-80 lg:rounded-[5rem] lg:px-20 lg:py-24" aria-labelledby="contact-title">
        <div class="grid items-center gap-12 lg:grid-cols-[1fr_auto]">
            <div class="max-w-[760px]" data-reveal>
                <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{d.contactHeading.eyebrow}</p>
                <h2 id="contact-title" class="font-display text-5xl font-black leading-[0.95] sm:text-7xl" set:html={formatTitle(d.contactHeading.title)} />
                <p class="mt-6 max-w-[58ch] text-lg leading-relaxed text-black/70">{d.contactHeading.body}</p>
                <div class="mt-10 flex flex-wrap items-center gap-5">
                    <Button href={d.contactButton.href} defaultText={d.contactButton.defaultText} hoverText={d.contactButton.hoverText} />
                    <a
                        href={d.contactSecondary.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex min-h-12 items-center justify-center rounded-full bg-black px-7 py-3 text-center font-display font-bold text-white transition hover:-translate-y-1 hover:bg-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-black"
                    >
                        {d.contactSecondary.text}
                    </a>
                </div>
            </div>
            <div class="relative mx-auto hidden lg:block" data-reveal data-reveal-delay="0.2">
                <div class="absolute -left-10 top-4 h-24 w-24 opacity-70" data-float aria-hidden="true"><Image src={flor} alt="" class="h-full w-full object-cover" /></div>
                <Image src={daniel} alt="Daniel, integrante de la Batucada Popular" class="h-96 w-auto drop-shadow-2xl" data-float />
            </div>
        </div>
    </section>
</PageLayout>

<script>
    import { initReveals } from "../scripts/reveals";

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReveals, { once: true });
    } else {
        initReveals();
    }
</script>
