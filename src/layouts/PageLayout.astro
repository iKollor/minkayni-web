---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Menu from "../components/Menu.astro";
import Hero from "../components/Hero.astro";
import SiteGrain from "../components/SiteGrain.astro";
import { getEntry } from "astro:content";
import { getData } from "../utils/i18n";
import Head from "./lib/head.astro";
import type { LinkColor, UnderlineColor } from "@/components/NavButton.astro";
import { fallbackFooter, fallbackNavigation, withBatucadaProject } from "../data/site";

interface Props {
    title: string;
    showHero?: boolean;
    linkColor?: LinkColor;
    underlineColor?: UnderlineColor;
    buttonClassName?: string;
    enableMixBlend?: boolean;
    navbarThreshold?: number;
}

const navigationEntry = await getEntry("navigationHeader", "navigation:header:es");
const footerEntry = await getEntry("footer", "footer");
const navHeader = withBatucadaProject(navigationEntry ? getData(navigationEntry) : fallbackNavigation);
const footer = footerEntry ? getData(footerEntry, "es") : fallbackFooter;
const { title, showHero = true, linkColor = "text-white", underlineColor, buttonClassName = "", enableMixBlend, navbarThreshold } = Astro.props;
---

<Head title={title}>
    <SiteGrain />

    <Navbar buttons={navHeader} linkColor={linkColor} underlineColor={underlineColor} buttonClassName={buttonClassName} enableMixBlend={enableMixBlend} threshold={navbarThreshold} />
    <Menu buttons={navHeader} socials={footer.Socials} />

    <div id="smooth-wrapper" class="overflow-x-hidden">
        <div id="smooth-content" class="flex flex-col min-h-screen">
            <main class="flex-1 w-full flex flex-col justify-start">
                {showHero && <Hero text={title} />}
                <slot />
                <Footer primaryLinks={navHeader} {footer} secondaryLinks="Proyectos" />
            </main>
        </div>
    </div>

    <script src="/src/scripts/main.ts"></script>

    <script>
        import { showContentNoIntro } from "../scripts/index/intro";
        showContentNoIntro();
    </script>
</Head>
