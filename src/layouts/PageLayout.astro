---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import SiteMenu from "../components/react/SiteMenu";
import SiteScrollbar from "../components/SiteScrollbar.astro";
import PixelCurtain from "../components/react/PixelCurtain";
import CounterMount from "../components/react/CounterMount";
import ScrollFloatTitles from "../components/react/ScrollFloatTitles";
import { buildMenuData } from "../utils/menu-data";
import Hero from "../components/Hero.astro";
import SiteGrain from "../components/SiteGrain.astro";
import Head from "./lib/head.astro";
import { loadLayoutContent } from "../utils/layout-content";
import { getLocale } from "../i18n";

interface Props {
    title: string;
    /** Meta description propia de la página (SEO); si falta se usa la global. */
    description?: string;
    /** Excluye la página de los buscadores (404, borradores). */
    noindex?: boolean;
    /** Imagen de vista previa al compartir; si falta se usa la del sitio. */
    image?: string;
    /** Texto alternativo de `image`. */
    imageAlt?: string;
    showHero?: boolean;
    buttonClassName?: string;
    /** Desactiva la tinta adaptativa del navbar (lo deja siempre en crema). */
    enableNavTheming?: boolean;
}

/* El idioma sale de la URL: `/en/about` es inglés, `/about` español. Así
   ninguna página tiene que acordarse de declararlo. */
const locale = getLocale(Astro.url);
const { navHeader, footer, site, projects } = await loadLayoutContent(locale);
const menu = await buildMenuData({ locale, navHeader, footer, projects, currentPath: Astro.url.pathname, contactEmail: site.contactEmail });
const { title, description, noindex, image, imageAlt, showHero = true, buttonClassName = "", enableNavTheming } = Astro.props;
---

<Head title={title} description={description} noindex={noindex} image={image} imageAlt={imageAlt}>
    <SiteGrain />

    <Navbar buttons={navHeader} buttonClassName={buttonClassName} enableTheming={enableNavTheming} locale={locale} menu={menu} />
    {/* Los contadores hidratan en idle: entran con el scroll o al final de la
        cascada de la leyenda, que ya espera a las fuentes. El panel del menú
        y la cortina siguen en `client:load`: el primero tiene que responder a
        la hamburguesa en cuanto se pueda tocar; la segunda tapa la página al
        llegar desde otra y tiene que retirarse cuanto antes. */}
    <SiteScrollbar locale={locale} />
    <PixelCurtain client:idle />
    <CounterMount client:idle />
    <ScrollFloatTitles client:idle />

    <div id="smooth-wrapper" class="overflow-x-hidden">
        <div id="smooth-content" class="flex flex-col min-h-svh">
            <main class="flex-1 w-full flex flex-col justify-start">
                {showHero && <Hero text={title} />}
                <slot />
                <Footer primaryLinks={navHeader} {footer} secondaryLinks="Proyectos" locale={locale} extraLinks={menu.secondary} />
            </main>
        </div>
    </div>

    {/* El panel del menú va al final del documento, no al principio: son
        18 KB de HTML que, delante del contenido, retrasaban la llegada de la
        leyenda de la portada (el LCP móvil) en cada visita. Es `fixed` y sale
        cerrado e `inert`, así que su sitio en el DOM no cambia nada visible;
        la hamburguesa lo referencia por id (`aria-controls`). */}
    <SiteMenu client:load {...menu} />
    <script src="/src/scripts/main.ts"></script>

    <script>
        import { showContentNoIntro } from "../scripts/index/intro";
        showContentNoIntro();
    </script>
</Head>
