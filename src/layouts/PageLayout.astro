---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Menu from "../components/Menu.astro";
import Hero from "../components/Hero.astro";
import SiteGrain from "../components/SiteGrain.astro";
import { getEntry } from "astro:content";
import { getData } from "../utils/i18n";
import Head from "./lib/head.astro";
import { fallbackFooter, fallbackNavigation, withBatucadaProject } from "../data/site";
import { globalFallback } from "../data/pages/global";
import { loadPageContent } from "../utils/page-content";

interface Props {
    title: string;
    /** Meta description propia de la página (SEO); si falta se usa la global. */
    description?: string;
    /** Excluye la página de los buscadores (404, borradores). */
    noindex?: boolean;
    /** Imagen de vista previa al compartir; si falta se usa la del sitio. */
    image?: string;
    /** Texto alternativo de `image`. */
    imageAlt?: string;
    showHero?: boolean;
    buttonClassName?: string;
    /** Desactiva la tinta adaptativa del navbar (lo deja siempre en crema). */
    enableNavTheming?: boolean;
}

const navigationEntry = await getEntry("navigationHeader", "navigation:header:es");
const footerEntry = await getEntry("footer", "footer");
const navHeader = withBatucadaProject(navigationEntry ? getData(navigationEntry) : fallbackNavigation);
const footer = footerEntry ? getData(footerEntry, "es") : fallbackFooter;
const site = await loadPageContent("globalSettings", globalFallback);
const { title, description, noindex, image, imageAlt, showHero = true, buttonClassName = "", enableNavTheming } = Astro.props;

---

<Head title={title} description={description} noindex={noindex} image={image} imageAlt={imageAlt}>
    <SiteGrain />

    <Navbar buttons={navHeader} buttonClassName={buttonClassName} enableTheming={enableNavTheming} />
    <Menu buttons={navHeader} socials={footer.Socials} menuLabel={site.menuLabel} contactEmail={site.contactEmail} />

    <div id="smooth-wrapper" class="overflow-x-hidden">
        <div id="smooth-content" class="flex flex-col min-h-screen">
            <main class="flex-1 w-full flex flex-col justify-start">
                {showHero && <Hero text={title} />}
                <slot />
                <Footer primaryLinks={navHeader} {footer} secondaryLinks="Proyectos" />
            </main>
        </div>
    </div>

    <script src="/src/scripts/main.ts"></script>

    <script>
        import { showContentNoIntro } from "../scripts/index/intro";
        showContentNoIntro();
    </script>
</Head>
