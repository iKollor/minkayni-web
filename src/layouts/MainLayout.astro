---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import Menu from "../components/Menu.astro";
import SiteGrain from "../components/SiteGrain.astro";
import PageNavigation from "../components/index/PageNavigation.astro";
import { getEntry } from "astro:content";
import { getData } from "../utils/i18n";
import Head from "./lib/head.astro";
import { fallbackFooter, fallbackNavigation } from "../data/site";

interface Props {
    title: string;
}

const navigationEntry = await getEntry("navigationHeader", "navigation:header:es");
const footerEntry = await getEntry("footer", "footer");
const navHeader = navigationEntry ? getData(navigationEntry) : fallbackNavigation;
const footer = footerEntry ? getData(footerEntry, "es") : fallbackFooter;
const { title } = Astro.props;
---

<Head title={title}>
    <SiteGrain />
    <Navbar buttons={navHeader} linkColor="text-white" />
    <Menu buttons={navHeader} socials={footer.Socials} />
    <PageNavigation
        items={[
            {
                href: "#moments",
                text: "Momentos",
            },
            {
                href: "#testimonials",
                text: "Testimonios",
                scrollAnchor: "start",
                scrollOffset: 200,
            },
            {
                href: "#about-us",
                text: "Nosotros",
                scrollAnchor: "start",
            },
            {
                href: "#projects",
                text: "Proyectos",
                scrollAnchor: "start",
            },
        ]}
    />

    <div id="smooth-wrapper" class="overflow-hidden">
        <div id="smooth-content" class="overflow-hidden">
            <slot />
            <Footer primaryLinks={navHeader} {footer} secondaryLinks="Proyectos" />
        </div>
    </div>
    <script src="/src/scripts/main.ts"></script>
</Head>
