---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import SiteMenu from "../components/react/SiteMenu";
import SiteScrollbar from "../components/SiteScrollbar.astro";
import PixelCurtain from "../components/react/PixelCurtain";
import CounterMount from "../components/react/CounterMount";
import ScrollFloatTitles from "../components/react/ScrollFloatTitles";
import { buildMenuData } from "../utils/menu-data";
import SiteGrain from "../components/SiteGrain.astro";
import PageNavigation from "../components/index/PageNavigation.astro";
import Head from "./lib/head.astro";
import { loadLayoutContent } from "../utils/layout-content";
import { getLocale } from "../i18n";

interface Props {
    title: string;
    /** Meta description propia de la página (SEO); si falta se usa la global. */
    description?: string;
    /** Imagen de vista previa al compartir; si falta se usa la del sitio. */
    image?: string;
    /** Texto alternativo de `image`. */
    imageAlt?: string;
}

/* El idioma sale de la URL: `/en/` es inglés, `/` español. */
const locale = getLocale(Astro.url);
const { navHeader, footer, site, projects } = await loadLayoutContent(locale);
const menu = await buildMenuData({ locale, navHeader, footer, projects, currentPath: Astro.url.pathname, contactEmail: site.contactEmail });

/* Config de scroll por ancla (presentacional; el texto/orden viene del CMS). */
const scrollConfig: Record<string, { scrollAnchor?: "start"; scrollOffset?: number }> = {
    "#testimonials": { scrollAnchor: "start", scrollOffset: 200 },
    "#about-us": { scrollAnchor: "start" },
    "#projects": { scrollAnchor: "start" },
};
const pageNavItems = site.pageNav
    .filter((item) => item?.href && item?.text)
    .map((item) => ({ href: item.href as string, text: item.text as string, ...(scrollConfig[item.href as string] ?? {}) }));

const { title, description, image, imageAlt } = Astro.props;

/* La intro de la portada está APAGADA salvo que el entorno de build diga
   PUBLIC_HOME_INTRO=on (ver .env.example). PageSpeed analiza siempre como
   visita nueva y, con la intro delante, en escritorio no llegaba a medir el
   LCP (rendimiento 0) y en móvil daba 7,8 s. Apagada, la portada arranca
   con el contenido a la vista, como cualquier página interior. */
const intro = import.meta.env.PUBLIC_HOME_INTRO === "on";
---

<Head title={title} description={description} image={image} imageAlt={imageAlt} intro={intro}>
    <SiteGrain />
    <Navbar buttons={navHeader} locale={locale} menu={menu} />
    {/* Los contadores hidratan en idle: entran con el scroll o al final de la
        cascada de la leyenda, que ya espera a las fuentes. El panel del menú
        sigue en `client:load`: tiene que responder a la hamburguesa en cuanto
        se pueda tocar. La cortina va en idle: solo actúa al llegar desde otra
        página del sitio (la tapa un script en línea antes del primer pintado y
        la isla, al hidratar, la retira), y en una visita nueva —la que mide
        PageSpeed— hidratarla con el resto solo añadía trabajo antes de que la
        página respondiera. */}
    <SiteMenu client:load {...menu} />
    <SiteScrollbar locale={locale} />
    <PixelCurtain client:idle />
    <CounterMount client:idle />
    <ScrollFloatTitles client:idle />
    <PageNavigation items={pageNavItems} locale={locale} />

    <div id="smooth-wrapper" class="overflow-hidden">
        <div id="smooth-content" class="overflow-hidden">
            <slot />
            <Footer primaryLinks={navHeader} {footer} secondaryLinks="Proyectos" locale={locale} extraLinks={menu.secondary} />
        </div>
    </div>
    <script src="/src/scripts/main.ts"></script>
</Head>
