---
import faviconSrc from "/public/favicon.png";
import faviconSvgSrc from "/public/favicon.svg";
import shareImageSrc from "../../assets/FOTO_BATUCADA.webp";
import { getImage } from "astro:assets";
import { globalFallback } from "../../data/pages/global";
import { loadPageContent } from "../../utils/page-content";
import OrganizationJsonLd from "../../components/legal/OrganizationJsonLd.astro";
import PageJsonLd from "../../components/legal/PageJsonLd.astro";
import { alternatePaths, defaultLocale, getLocale, htmlLang, ogLocale } from "../../i18n";

interface Props {
    title: string;
    description?: string;
    /** Páginas que no deben indexarse (404, borradores): sin canonical y con robots noindex. */
    noindex?: boolean;
    /** Imagen para redes sociales. URL absoluta o ruta del sitio; si falta se usa la del CMS o la de por defecto. */
    image?: string;
    /** Texto alternativo de `image`. */
    imageAlt?: string;
}
const appleTouchIcon = await getImage({
    src: faviconSrc,
    width: 180,
    height: 180,
    format: "png",
});
const faviconSvg = await getImage({ src: faviconSvgSrc, format: "svg" });
/* Sustituye a /favicon.ico, que no existe en public/ y devolvía 404 en cada página. */
const faviconPng = await getImage({ src: faviconSrc, width: 32, height: 32, format: "png" });

/* SEO por defecto editable (single type `global` en Strapi), en el idioma
   de la página. */
const locale = getLocale(Astro.url);
const site = await loadPageContent("globalSettings", globalFallback, locale);
const { title, description = site.defaultSeo.metaDescription, noindex = false, image, imageAlt } = Astro.props;
const siteTitle = site.defaultSeo.metaTitle || site.siteName;
const fullTitle = title ? `${title} ${site.titleSuffix}` : siteTitle;

/* URL canónica de la página (requiere `site` en astro.config.ts).
   Una página de error no declara canónica: no es un destino real. */
const canonical = !noindex && Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

/* Las dos versiones de esta misma página, para `hreflang`. Sin ellas un
   buscador no sabe que /about y /en/about son la misma página en dos idiomas
   y puede tratar una como duplicado de la otra. `x-default` apunta al
   español, que es el idioma del sitio y el destino razonable para quien no
   encaje en ninguno de los dos. Una página `noindex` no las declara: no
   pertenece al índice, así que tampoco a un grupo de alternativas. */
const alternates =
    !noindex && Astro.site
        ? alternatePaths(Astro.url).map(({ locale: code, path }) => ({
              locale: code,
              href: new URL(path, Astro.site).href,
          }))
        : [];
const defaultAlternate = alternates.find((alt) => alt.locale === defaultLocale);

/* Imagen para compartir: la que pase la página, la del single type `global`
   o, como último recurso, una foto del proyecto recortada a 1200x630 (la
   proporción que esperan Facebook, LinkedIn y X). Las redes exigen URL
   absoluta: una ruta relativa se ignora y la tarjeta sale sin imagen. */
const defaultShareImage = await getImage({ src: shareImageSrc, width: 1200, height: 630, format: "webp" });
const shareImagePath = image ?? (site.defaultSeo as { shareImage?: { url?: string } }).shareImage?.url ?? defaultShareImage.src;
const shareImage = Astro.site ? new URL(shareImagePath, Astro.site).href : shareImagePath;
const shareImageAlt = imageAlt ?? `${siteTitle} — Batucada Popular`;
const ogUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;

/* preconnect a Strapi solo si la URL está configurada y es válida */
const strapiOrigin = (() => {
    try {
        return new URL(import.meta.env.STRAPI_URL ?? "").origin;
    } catch {
        return "";
    }
})();
---

<!doctype html>
<html lang={htmlLang[locale]}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
        <link rel="icon" href={faviconPng.src} type="image/png" sizes="32x32" />
        <link rel="icon" href={faviconSvg.src} type="image/svg+xml" />
        <link rel="apple-touch-icon" href={appleTouchIcon.src} />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        {canonical && <link rel="canonical" href={canonical} />}
        {alternates.map((alt) => <link rel="alternate" hreflang={htmlLang[alt.locale]} href={alt.href} />)}
        {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />}
        {noindex && <meta name="robots" content="noindex, follow" />}

        <!-- Open Graph / Twitter: sin esto, al compartir un enlace no hay
             título, descripción ni imagen de vista previa. -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.siteName} />
        <meta property="og:locale" content={ogLocale[locale]} />
        {alternates.filter((alt) => alt.locale !== locale).map((alt) => <meta property="og:locale:alternate" content={ogLocale[alt.locale]} />)}
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        {ogUrl && <meta property="og:url" content={ogUrl} />}
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={shareImageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImage} />
        <meta name="twitter:image:alt" content={shareImageAlt} />
        <!-- Preferencias de color del agente y color de UI del navegador (Safari iOS/desktop) -->
        <meta name="color-scheme" content="light dark" />
        <!-- Fallback general -->
        <meta name="theme-color" content="#67b7f0" />
        <!-- Variantes por esquema de color (iOS 15+ soporta theme-color) -->
        <meta name="theme-color" media="(prefers-color-scheme: light)" content="#67b7f0" />
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#67b7f0" />
        <!-- PWA en iOS (al añadir a la pantalla de inicio) -->
        <meta name="apple-mobile-web-app-capable" content="yes" />
        <!-- Recomendado: equivalente genérico para Android/Chrome -->
        <meta name="mobile-web-app-capable" content="yes" />
        <!-- black-translucent permite que el fondo de la página se vea detrás de la barra de estado -->
        <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
        {strapiOrigin && <link rel="preconnect" href={strapiOrigin} />}

        <!-- Equipos lentos: marca <html data-low-power> antes del primer pintado
             para que los fondos animados (Hero) se degraden sin parpadeo. -->
        <script is:inline>
            try {
                var n = navigator;
                var low = (n.hardwareConcurrency && n.hardwareConcurrency <= 2) || (n.deviceMemory && n.deviceMemory <= 2) || (n.connection && n.connection.saveData === true);
                if (low) document.documentElement.setAttribute("data-low-power", "");
            } catch (e) {}
        </script>

        <title>{fullTitle}</title>

        <!-- Identidad legal de la organización (schema.org/NGO) -->
        <OrganizationJsonLd />
        <!-- Sitio y ruta de navegación (WebSite + BreadcrumbList) -->
        <PageJsonLd title={title} noindex={noindex} />
        <style>
            body[data-grain="off"] #grain-layer {
                display: none;
            }
            html.no-scroll,
            body.no-scroll {
                overflow: hidden !important;
                height: 100%;
                overscroll-behavior: none;
                touch-action: none;
            }
        </style>
        <style is:global>
            @media (max-width: 768px) {
                nav.page-nav {
                    display: none !important;
                    visibility: hidden !important;
                    pointer-events: none !important;
                    height: 0 !important;
                    overflow: hidden !important;
                }
            }
            /* Ocultar COMPLETAMENTE el PageNavigation durante la intro */
            html.no-scroll nav.page-nav,
            body[data-intro="pending"] nav.page-nav {
                opacity: 0 !important;
                visibility: hidden !important;
                pointer-events: none !important;
                transform: translateY(16px);
            }
        </style>
    </head>
    <body class="bg-background text-black">
        <slot />
    </body>
</html>
