---
/* Medición para Google Ad Grants.
 *
 * La política de Ad Grants exige seguimiento de conversiones: una cuenta que
 * no puede demostrar qué hace la gente al llegar acaba suspendida. Hasta ahora
 * el sitio no tenía ninguna etiqueta.
 *
 * El identificador de Analytics vive en el repositorio: es público por diseño
 * —acaba en el HTML de todas las páginas— y así la medición no depende de que
 * alguien se acuerde de ponerlo en el panel del despliegue. Las variables de
 * entorno lo sustituyen, que es lo que hace falta para medir aparte una copia
 * del sitio (ver .env.example).
 *
 * Nada se emite fuera del sitio construido: con `astro dev` no se manda nada,
 * y la build servida en local (`pnpm run preview`) se reconoce por el nombre
 * de dominio y tampoco cuenta. Trastear no ensucia los informes.
 *
 * Qué se mide, además de la página vista: los tres gestos que para la
 * fundación son una conversión de verdad —abrir la página de aporte, escribir
 * por WhatsApp y escribir por correo—. Van como eventos con nombre propio para
 * poder marcarlos como conversión en el panel de Google Ads sin volver a tocar
 * el código.
 *
 * Privacidad: nada se guarda en el navegador de quien visita hasta que
 * responda al aviso (components/CookieConsent.astro). Aquí se declaran las
 * señales del modo de consentimiento de Google en «denegado» ANTES de cargar
 * la etiqueta, y ahí se quedan si la respuesta no llega: en ese estado Google
 * mide sin cookies y sin identificar a nadie. Además, `anonymize_ip` y sin
 * señales de publicidad personalizada.
 */
import { CLAVE_CONSENTIMIENTO, SENALES_FIJAS, SENALES_VARIABLES } from "../scripts/consentimiento";

/** Propiedad de Google Analytics 4 de la fundación. */
const GA_POR_DEFECTO = "G-4704EJW8QJ";

const medicion = import.meta.env.PUBLIC_GA_MEASUREMENT_ID?.trim() || GA_POR_DEFECTO;
const conversiones = import.meta.env.PUBLIC_ADS_CONVERSION_ID?.trim();

/* El primero de los dos manda sobre la carga del script; el segundo se
   configura encima si existe, que es como Google recomienda enlazar Analytics
   con Ads sin cargar gtag.js dos veces. */
const etiquetas = [medicion, conversiones].filter(Boolean) as string[];
const activo = import.meta.env.PROD && etiquetas.length > 0;
---

{
    activo && (
        <>
            {/* El bloque en línea va ANTES que gtag.js: las señales de
                consentimiento tienen que estar declaradas cuando la etiqueta
                arranque, o el primer envío saldría sin ellas. */}
            <script is:inline define:vars={{ etiquetas, clave: CLAVE_CONSENTIMIENTO, variables: SENALES_VARIABLES, fijas: SENALES_FIJAS }}>
                if (/^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname)) {
                    /* La build servida en local para revisarla antes de
                       desplegar no es una visita. */
                } else {
                window.dataLayer = window.dataLayer || [];
                function gtag() {
                    window.dataLayer.push(arguments);
                }
                window.gtag = gtag;

                /* Modo de consentimiento. Sin respuesta guardada, todo
                   denegado: Google puede contar la visita, pero no guarda
                   nada en el navegador ni sabe quién es. Si ya se respondió,
                   se aplica de entrada para que el primer envío salga bien
                   sin esperar al aviso. `wait_for_update` es el margen que
                   Google espera por si la respuesta llega enseguida. */
                let respuesta = null;
                try {
                    respuesta = localStorage.getItem(clave);
                } catch (e) {
                    /* Sin almacenamiento se pregunta otra vez. */
                }
                const valor = respuesta === "concedido" ? "granted" : "denied";
                const porDefecto = Object.assign({ wait_for_update: 500 }, fijas);
                for (const senal of variables) porDefecto[senal] = valor;
                gtag("consent", "default", porDefecto);

                gtag("js", new Date());
                for (const etiqueta of etiquetas) {
                    gtag("config", etiqueta, { anonymize_ip: true, allow_google_signals: false });
                }

                /* Un solo oyente en el documento en lugar de uno por enlace:
                   el menú y las tarjetas se montan y desmontan con React, y
                   los oyentes individuales se perderían en cada cambio. */
                document.addEventListener(
                    "click",
                    (evento) => {
                        const enlace = evento.target instanceof Element ? evento.target.closest("a[href]") : null;
                        if (!enlace) return;
                        const href = enlace.getAttribute("href") || "";

                        let nombre = null;
                        if (href.startsWith("mailto:")) nombre = "contacto_email";
                        else if (href.includes("wa.me") || href.includes("whatsapp")) nombre = "contacto_whatsapp";
                        else if (/(^|\/)(en\/)?donate\/?($|[#?])/.test(href)) nombre = "abrir_aporte";
                        if (!nombre) return;

                        gtag("event", nombre, {
                            /* Desde dónde se pulsó: sirve para saber si el CTA
                               del pie rinde igual que el del menú. */
                            pagina: location.pathname,
                            destino: href,
                        });
                    },
                    { passive: true },
                );
                }
            </script>
            {/* Sin `preconnect`: el componente va al final del cuerpo, así que
                la conexión se abre cuando toca. Adelantarla desde la cabecera
                sería pagar un saludo a un tercero antes de pintar la página. */}
            <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${etiquetas[0]}`} />
        </>
    )
}
