---
import { Image } from "astro:assets";
import paperTexture from "../assets/overlay/noise.webm";
import noisePoster from "../assets/overlay/noise-poster.webp";
---

<!-- El contenedor es `fixed inset-0`, así que YA tiene el tamaño del viewport
     visible y lo sigue de forma estable en iOS. Los hijos se dimensionan contra
     él (`absolute inset-0`) y no con unidades de viewport: `dvh` se recalcula en
     cada frame mientras la barra de Safari se recoge, lo que hacía que la capa
     de grano se redimensionara continuamente al desplazarse, y `vh`/`h-screen`
     es el viewport GRANDE, más alto que el área visible. -->
<div id="grain-layer" aria-hidden="true" class="fixed inset-0 z-1000 pointer-events-none overflow-hidden">
    <video
        id="grain-video"
        class="absolute inset-0 h-full w-full object-cover mix-blend-soft-light opacity-20 contrast-125 brightness-95 will-change-[opacity] dark:mix-blend-overlay dark:opacity-20"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster={noisePoster.src}
        style="visibility:hidden;"
    >
        <source src={paperTexture} type="video/webm" />
    </video>
    <Image src={noisePoster} alt="" class="still-noise absolute inset-0 h-full w-full object-cover mix-blend-overlay pointer-events-none object-center opacity-5" />
</div>

<script>
    const initGrain = () => {
        const root = document.getElementById("grain-layer");
        const video = document.getElementById("grain-video");
        if (!root || root.dataset.ready === "true" || !(video instanceof HTMLVideoElement)) return;
        root.dataset.ready = "true";

        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.body.dataset.grain = "off";
            return;
        }

        let played = false;
        const markPlaying = () => {
            played = true;
            document.documentElement.classList.remove("grain-still-fallback");
            video.style.visibility = "visible";
        };
        const play = () => video.play().then(markPlaying).catch(() => undefined);

        video.addEventListener("playing", markPlaying, { once: true });
        play();

        const retry = () => {
            if (!played) play();
        };
        ["pointerdown", "keydown"].forEach((eventName) => window.addEventListener(eventName, retry, { passive: true, once: true }));

        const fallbackTimer = window.setTimeout(() => {
            if (!played) document.documentElement.classList.add("grain-still-fallback");
        }, 3000);

        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState === "visible") retry();
            else video.pause();
        });
        window.addEventListener("pagehide", () => window.clearTimeout(fallbackTimer), { once: true });
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initGrain, { once: true });
    else initGrain();
</script>

<style is:global>
    /* Capa de composición propia: sin esto la superposición se repinta junto con
       la página durante el scroll elástico de iOS y produce parpadeos. */
    #grain-layer {
        transform: translateZ(0);
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .grain-still-fallback #grain-layer .still-noise {
        opacity: 0.1 !important;
    }
</style>
