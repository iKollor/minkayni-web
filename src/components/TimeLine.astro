---
import MaskFlor from "./MaskFlor.astro";
import flor from "../assets/SVG/misc/flor.svg";
import Image from "astro/components/Image.astro";
import type { ImageMetadata } from "astro";

export interface Step {
    year: number;
    title?: string;
    tittle?: string;
    text: string;
    image?: ImageMetadata;
    link?: string;
    linkText?: string;
}

export interface Props {
    steps: Step[];
    interval?: number;
}

const { steps = [], interval = 3000 } = Astro.props;
const years = steps.map((step) => step.year);
const columnTemplate = `repeat(${Math.max(years.length, 1)}, minmax(4rem, 1fr))`;
const gridStyle = `grid-template-columns: ${columnTemplate};`;
const timelinePadding = "px-6 sm:px-8 md:px-12 lg:px-20";
---

<div class="timeline-root relative flex flex-row w-full sm:w-[95%] md:w-[92%] h-auto min-h-[500px] md:min-h-[600px] lg:min-h-[700px] justify-center mx-auto px-2 sm:px-4" data-timeline data-interval={interval}>
    <div class="w-full flex flex-col gap-4 -translate-y-10 sm:-translate-y-12 lg:-translate-y-16 z-0">
        <div class={`timeline-years w-full ${timelinePadding} grid gap-3 text-center`} style={gridStyle}>
            {years.map((year) => <span class="text-sm sm:text-base md:text-xl lg:text-2xl xl:text-3xl font-semibold text-gray-800 transition-all duration-300">{year}</span>)}
        </div>
        <div class={`w-full ${timelinePadding} grid gap-3 items-center`} style={gridStyle}>
            {years.map((year) => <div class="flex justify-center"><MaskFlor alt={`Año ${year}`} className="w-16 h-16 sm:w-20 sm:h-20 md:w-32 md:h-32 lg:w-48 lg:h-48 xl:w-56 xl:h-56" /></div>)}
        </div>
    </div>

    <div class="z-20 bg-[#d5d5d5] absolute w-full h-full rounded-xl sm:rounded-2xl md:rounded-3xl flex flex-col py-3 sm:py-4 md:py-6 gap-2 sm:gap-3 md:gap-5">
        <div class="absolute top-5 sm:top-9 md:top-11 left-0 w-full border-b-2 border-gray-500 z-0"></div>
        <div class={`timeline-steps relative w-full grid items-center ${timelinePadding} gap-4 z-10`} style={gridStyle}>
            {steps.map((step, index) => (
                <button type="button" class="appearance-none border-0 bg-transparent p-0 cursor-pointer opacity-50 transition-all duration-300 hover:opacity-75 mx-auto w-5 sm:w-6 md:w-8 lg:w-10 xl:w-12 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" data-step={index} aria-label={`Mostrar hito de ${step.year}`}>
                    <Image src={flor} alt="" class="w-full h-auto" />
                </button>
            ))}
        </div>

        <div class="timeline-content w-full flex-1 px-2 sm:px-4 md:px-6 lg:px-10 overflow-y-auto bg">
            {steps.map((step, index) => {
                const title = step.title ?? step.tittle ?? `Hito ${step.year}`;
                return (
                    <div class={`step-content ${index === 0 ? "" : "hidden"} h-full flex flex-col lg:flex-row gap-3 sm:gap-4 md:gap-6`} data-step={index}>
                        <div class="flex flex-col w-full lg:w-2/5 p-2 sm:p-3 md:p-4 max-h-[50vh] lg:max-h-none">
                            <h1 class="text-base sm:text-xl md:text-2xl lg:text-3xl font-bold mb-2 sm:mb-3 text-indigo-600">{title}</h1>
                            <p class="text-xs sm:text-sm md:text-base lg:text-lg leading-relaxed mb-3 sm:mb-4 text-gray-700">{step.text}</p>
                            {step.link && <a href={step.link} target="_blank" rel="noopener noreferrer" class="self-start inline-block bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs sm:text-sm md:text-base px-4 sm:px-6 md:px-8 lg:px-10 py-2 sm:py-3 md:py-4 lg:py-5 rounded-2xl sm:rounded-3xl shadow-md transition-colors duration-200">{step.linkText || "Ver más"}</a>}
                        </div>
                        <div class="flex w-full lg:w-3/5 rounded-lg sm:rounded-xl overflow-hidden min-h-[200px] sm:min-h-[250px] md:min-h-[300px]">
                            {step.image && <Image src={step.image} alt={title} class="w-full h-full max-h-[40vh] sm:max-h-[50vh] md:max-h-[60vh] object-cover rounded-lg sm:rounded-xl transition-transform duration-300 hover:scale-[1.02]" loading="lazy" />}
                        </div>
                    </div>
                );
            })}
        </div>
    </div>
</div>

<script>
    const initTimelines = () => {
        document.querySelectorAll<HTMLElement>("[data-timeline]").forEach((root) => {
            if (root.dataset.ready === "true") return;
            root.dataset.ready = "true";
            const controls = Array.from(root.querySelectorAll<HTMLButtonElement>(".timeline-steps [data-step]"));
            const years = Array.from(root.querySelectorAll<HTMLElement>(".timeline-years span"));
            const contents = Array.from(root.querySelectorAll<HTMLElement>(".timeline-content [data-step]"));
            if (!controls.length) return;
            let activeStep = 0;
            let timer: number | undefined;
            const interval = Number(root.dataset.interval) || 3000;
            const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

            const setActiveStep = (step: number) => {
                activeStep = (step + controls.length) % controls.length;
                controls.forEach((control, index) => {
                    const active = index === activeStep;
                    control.classList.toggle("scale-110", active);
                    control.classList.toggle("sm:scale-125", active);
                    control.classList.toggle("opacity-100", active);
                    control.classList.toggle("opacity-50", !active);
                    control.setAttribute("aria-pressed", String(active));
                });
                years.forEach((year, index) => {
                    year.style.color = index === activeStep ? "#f3a20b" : "";
                    year.classList.toggle("scale-105", index === activeStep);
                    year.classList.toggle("sm:scale-110", index === activeStep);
                });
                contents.forEach((content, index) => content.classList.toggle("hidden", index !== activeStep));
            };
            const stop = () => { if (timer !== undefined) window.clearInterval(timer); timer = undefined; };
            const start = () => {
                stop();
                if (!reduced && controls.length > 1 && interval >= 3000) timer = window.setInterval(() => setActiveStep(activeStep + 1), interval);
            };
            controls.forEach((control, index) => control.addEventListener("click", () => { setActiveStep(index); start(); }));
            root.addEventListener("mouseenter", stop);
            root.addEventListener("mouseleave", start);
            root.addEventListener("focusin", stop);
            root.addEventListener("focusout", start);
            setActiveStep(0);
            start();
            window.addEventListener("pagehide", stop, { once: true });
        });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initTimelines, { once: true });
    else initTimelines();
</script>

<style>
    .timeline-content {
        scrollbar-width: thin;
        scrollbar-color: #f3a20b #d5d5d5;
    }
    .timeline-content::-webkit-scrollbar { width: 6px; height: 6px; }
    .timeline-content::-webkit-scrollbar-track { background: #d5d5d5; }
    .timeline-content::-webkit-scrollbar-thumb { background: #f3a20b; border-radius: 3px; }
</style>
