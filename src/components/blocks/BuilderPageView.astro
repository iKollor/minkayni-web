---
/* Cuerpo de una subpágina del constructor (collection type `page`).

   Lo comparten `/[...slug]` y `/en/[...slug]`. Los bloques los pinta
   BuilderBlocks (React) renderizado aquí a HTML estático, sin `client:*`:
   es el mismo componente que usa la vista previa del panel de Strapi
   (BuilderPreview.tsx), así que las dos salidas coinciden. El Markdown del
   bloque de texto se convierte aquí, en build, con el pipeline del sitio. */
import PageLayout from "@/layouts/PageLayout.astro";
import BuilderBlocks from "@/components/react/builder/BuilderBlocks";
import { normalizeBlocks, type Block } from "@/components/react/builder/normalize";
import { renderMarkdown } from "@/utils/render-markdown";
import type { BuilderPage } from "@/schemas/pages.zod";

interface Props {
    page: BuilderPage;
}

const { page } = Astro.props;
const STRAPI_URL = (import.meta.env.STRAPI_URL ?? "").trim();

const blocks: Block[] = await Promise.all(
    normalizeBlocks(page.sections).map(async (block) => (block.type === "richText" && block.body ? { ...block, bodyHtml: await renderMarkdown(block.body) } : block))
);

/* La subpágina trae su propio SEO; sin esto heredaba la descripción global. */
const description = page.seo?.metaDescription ?? page.description ?? undefined;
---

<PageLayout title={page.title ?? ""} description={description}>
    <div class="pb-32 md:pb-64">
        <BuilderBlocks blocks={blocks} strapiUrl={STRAPI_URL} />
    </div>
</PageLayout>

<script>
    import { initBatucadaAnchors } from "../../scripts/batucada/motion";
    import { initReveals } from "../../scripts/reveals";
    import { initMagicButtons } from "../../scripts/magic-button";

    const initBuilderPage = () => {
        initBatucadaAnchors(); // anclas internas con offset por navbar fija
        initReveals();
        initMagicButtons();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initBuilderPage, { once: true });
    } else {
        initBuilderPage();
    }
</script>
