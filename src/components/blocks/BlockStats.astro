---
/* Bloque "Cifras" — misma rejilla y odómetro que la sección Cifras de /impact. */
import { formatTitle } from "@/utils/rich-title";

interface Props {
    block: {
        heading?: { eyebrow?: string | null; title?: string | null; body?: string | null } | null;
        stats?: Array<{ value?: string | null; target?: number | null; prefix?: string | null; suffix?: string | null; label?: string | null; detail?: string | null } | null> | null;
    };
}
const { block } = Astro.props;
const heading = block.heading ?? {};
const stats = (block.stats ?? []).filter((s): s is NonNullable<typeof s> => Boolean(s));

const statStyles = [
    { bg: "bg-primary text-white", dim: "text-white/75" },
    { bg: "bg-secondary text-black", dim: "text-black/70" },
    { bg: "bg-accent text-black", dim: "text-black/70" },
    { bg: "bg-black text-white", dim: "text-white/70" },
];
---

<section class="mx-auto w-[90%] max-w-[1280px] py-12">
    {
        (heading.eyebrow || heading.title) && (
            <div class="mb-10 max-w-[760px]" data-reveal>
                {heading.eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-primary">{heading.eyebrow}</p>}
                {heading.title && <h2 class="font-display text-4xl font-black leading-none text-black sm:text-6xl" set:html={formatTitle(heading.title, "text-secondary-deep")} />}
                {heading.body && <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-black/70">{heading.body}</p>}
            </div>
        )
    }
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" data-reveal-group>
        {
            stats.map((stat, index) => {
                const style = statStyles[index % statStyles.length];
                return (
                    <div class={`rounded-[2.25rem] p-8 transition duration-300 hover:-translate-y-2 ${style.bg}`}>
                        <p class="font-display text-6xl font-black tabular-nums">
                            <span data-count={stat.target} data-count-prefix={stat.prefix ?? ""} data-count-suffix={stat.suffix ?? ""}>{stat.value}</span>
                        </p>
                        {stat.label && <p class="mt-3 font-display text-lg font-bold leading-snug">{stat.label}</p>}
                        {stat.detail && <p class={`mt-2 text-sm leading-relaxed ${style.dim}`}>{stat.detail}</p>}
                    </div>
                );
            })
        }
    </div>
</section>
