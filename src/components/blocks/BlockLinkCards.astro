---
/* Bloque "Tarjetas con enlace" — como "Sigue el recorrido" de /impact. */
import { formatTitle } from "@/utils/rich-title";

interface Props {
    block: {
        heading?: { eyebrow?: string | null; title?: string | null; body?: string | null } | null;
        cards?: Array<{ eyebrow?: string | null; title?: string | null; text?: string | null; href?: string | null; linkText?: string | null; external?: boolean | null } | null> | null;
    };
}
const { block } = Astro.props;
const heading = block.heading ?? {};
const cards = (block.cards ?? []).filter((c): c is NonNullable<typeof c> => Boolean(c));
---

<section class="mx-auto w-[90%] max-w-[1280px] py-12">
    {
        (heading.eyebrow || heading.title) && (
            <div class="mb-10 max-w-[760px]" data-reveal>
                {heading.eyebrow && <p class="mb-4 text-sm font-bold uppercase tracking-[0.22em] text-secondary-deep">{heading.eyebrow}</p>}
                {heading.title && <h2 class="font-display text-4xl font-black leading-none text-black sm:text-5xl" set:html={formatTitle(heading.title)} />}
                {heading.body && <p class="mt-6 max-w-[62ch] text-lg leading-relaxed text-black/70">{heading.body}</p>}
            </div>
        )
    }
    <div class="grid gap-5 md:grid-cols-3" data-reveal-group>
        {
            cards.map((item) => (
                <a
                    href={item.href}
                    target={item.external ? "_blank" : undefined}
                    rel={item.external ? "noopener noreferrer" : undefined}
                    class="group flex flex-col rounded-[2.25rem] border border-black/10 p-8 transition duration-300 hover:-translate-y-2 hover:border-primary/40 hover:shadow-[0_24px_50px_rgba(35,15,55,0.12)] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary sm:p-10"
                >
                    {item.eyebrow && <p class="text-xs font-bold uppercase tracking-[0.22em] text-black/50 transition group-hover:text-primary">{item.eyebrow}</p>}
                    <h3 class="mt-4 font-display text-2xl font-bold text-black transition group-hover:text-primary">{item.title}</h3>
                    {item.text && <p class="mt-3 leading-relaxed text-black/70">{item.text}</p>}
                    <span class="mt-auto pt-6 font-display font-bold text-primary opacity-70 transition group-hover:opacity-100" aria-hidden="true">
                        {item.linkText ?? "Seguir leyendo"} →
                    </span>
                </a>
            ))
        }
    </div>
</section>
