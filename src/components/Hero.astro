---
/* ──────────────────────────────────────────────────────────────────────────
   Hero de las páginas internas (/about, /impact, /donate, /transparencia…).

   Fondo: reproduce el degradado animado de la portada (los "blobs" de
   BubbleBackground) pero en CSS puro, sin React ni motion. Razones:
   - la portada ya hidrata ese componente; repetirlo en cada subpágina
     significaría ~40 KB de JS por página para un fondo decorativo;
   - en CSS se puede apagar por completo en equipos lentos y con
     `prefers-reduced-motion` sin coste de hidratación.

   Degradación (de mejor a peor equipo):
   1. normal            → blobs animados con blur y hard-light
   2. equipo lento      → `data-low-power` en <html> (ver layouts/lib/head.astro):
                          mismos colores, sin animación ni blur pesado
   3. reduced-motion    → estático
   4. sin JS/CSS moderno→ degradado lineal de marca

   Tipografía: el alto del fondo lo marca el contenedor del texto
   (`absolute inset-0`), así que nunca se desalinean.
─────────────────────────────────────────────────────────────────────────── */
import "../styles/global.css";

interface Props {
    text: string;
}

const { text } = Astro.props;
---

<header id="hero" data-nav-theme="dark" class="relative flex w-full items-center justify-center overflow-hidden">
    <!-- Fondo animado (decorativo) -->
    <div class="hero-bg absolute inset-0 z-0" aria-hidden="true">
        <div class="hero-blobs">
            <span class="hero-blob hero-blob--1"></span>
            <span class="hero-blob hero-blob--2"></span>
            <span class="hero-blob hero-blob--3"></span>
            <span class="hero-blob hero-blob--4"></span>
        </div>
    </div>

    <!-- Título -->
    <div class="relative z-10 flex h-[32vh] min-h-[240px] w-full items-center justify-center px-6 md:h-[60vh] md:min-h-[420px]">
        <h1 class="hero-title">{text}</h1>
    </div>
</header>

<style>
    .hero-bg {
        border-bottom-left-radius: 30px;
        border-bottom-right-radius: 30px;
        /* Base de marca: visible siempre, también si fallan blend/blur */
        background: linear-gradient(130deg, var(--secondary) 0%, color-mix(in oklch, var(--secondary) 36%, var(--primary) 64%) 45%, var(--primary) 100%);
        overflow: hidden;
        contain: paint;
    }

    /* Capa de blobs: mismo tratamiento que la portada (blur + hard-light) */
    .hero-blobs {
        position: absolute;
        inset: 0;
        filter: blur(40px);
        transform: translateZ(0);
    }

    .hero-blob {
        position: absolute;
        display: block;
        border-radius: 9999px;
        mix-blend-mode: hard-light;
        will-change: transform;
    }

    /* Paleta idéntica a la portada (BubbleBackground de index.astro) */
    .hero-blob--1 {
        inset: 10% auto auto 10%;
        width: 80%;
        height: 80%;
        background: radial-gradient(circle at center, rgb(18 113 255 / 0.8) 0%, rgb(18 113 255 / 0) 50%);
        animation: hero-orbit 20s linear infinite;
        transform-origin: calc(50% - 22vw) 50%;
    }

    .hero-blob--2 {
        inset: auto auto -10% -5%;
        width: 80%;
        height: 80%;
        background: radial-gradient(circle at center, rgb(140 100 255 / 0.8) 0%, rgb(140 100 255 / 0) 50%);
        animation: hero-orbit 40s linear infinite reverse;
        transform-origin: calc(50% + 20vw) 50%;
    }

    .hero-blob--3 {
        inset: 8% auto auto 12%;
        width: 80%;
        height: 80%;
        opacity: 0.7;
        background: radial-gradient(circle at center, rgb(63 169 245 / 0.8) 0%, rgb(63 169 245 / 0) 50%);
        animation: hero-sway 40s ease-in-out infinite;
    }

    .hero-blob--4 {
        inset: -30% auto auto -30%;
        width: 160%;
        height: 160%;
        background: radial-gradient(circle at center, rgb(140 100 255 / 0.8) 0%, rgb(140 100 255 / 0) 50%);
        animation: hero-orbit 26s linear infinite;
        transform-origin: calc(50% - 30vw) calc(50% + 10vh);
    }

    @keyframes hero-orbit {
        to {
            transform: rotate(360deg);
        }
    }

    @keyframes hero-sway {
        0%,
        100% {
            transform: translate3d(-4%, 0, 0);
        }
        50% {
            transform: translate3d(4%, 2%, 0);
        }
    }

    /* Título: grande, apretado y ópticamente centrado.
       - `text-wrap: balance` reparte las líneas en lugar de dejar huérfanas
       - `leading` bajo para que quepan títulos de dos o tres palabras
       - sin padding lateral propio: el centrado lo da el contenedor flex */
    .hero-title {
        max-width: min(100%, 18ch);
        margin-inline: auto;
        font-family: var(--font-display), system-ui, sans-serif;
        font-weight: 900;
        font-size: clamp(2.75rem, 13vw, 8rem);
        line-height: 0.84;
        letter-spacing: -0.02em;
        text-align: center;
        text-wrap: balance;
        color: var(--bg-white);
        /* compensa el espacio del interlineado bajo para un centrado óptico exacto */
        padding-block: 0.08em;
    }

    @media (min-width: 768px) {
        .hero-title {
            font-size: clamp(4rem, 9vw, 9rem);
            max-width: min(100%, 20ch);
        }
    }

    /* ── Degradación en equipos lentos y con reduced-motion ───────────────── */
    :global(html[data-low-power]) .hero-blobs {
        filter: none;
        opacity: 0.55;
    }

    :global(html[data-low-power]) .hero-blob {
        animation: none;
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-blob {
            animation: none;
        }
    }

    /* Sin soporte de mix-blend/blur: queda la base lineal, que ya es de marca */
    @supports not (mix-blend-mode: hard-light) {
        .hero-blobs {
            display: none;
        }
    }
</style>
