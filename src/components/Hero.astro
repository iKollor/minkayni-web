---
/* ──────────────────────────────────────────────────────────────────────────
   Hero de las páginas internas (/about, /impact, /donate, /transparencia y las
   subpáginas del constructor).

   Usa el MISMO fondo que la portada: `BubbleBackground`, con seguimiento del
   cursor. Antes reproducía ese degradado con una copia en CSS para no pagar el
   coste de React; desde que el fondo se reescribió sin React (unas pocas
   decenas de líneas de JS) mantener dos implementaciones del mismo efecto sólo
   garantizaba que acabaran divergiendo.

   La paleta es la de la portada. La degradación (equipos lentos,
   `prefers-reduced-motion`, fuera de viewport) la trae el propio componente.

   Tipografía: el alto del fondo lo marca el contenedor del texto
   (`absolute inset-0`), así que nunca se desalinean.
─────────────────────────────────────────────────────────────────────────── */
import "../styles/global.css";
import BubbleBackground from "./index/BubbleBackground.astro";

interface Props {
    text: string;
}

const { text } = Astro.props;

/* Misma paleta que la portada (ver src/pages/index.astro). */
const HERO_COLORS = {
    second: "18,113,255",
    third: "140,100,255",
    fourth: "63,169,245",
    fifth: "140,100,255",
    sixth: "63,169,245",
};
---

<header id="hero" data-nav-theme="dark" class="relative flex w-full items-center justify-center overflow-hidden">
    <!-- Fondo animado (decorativo) -->
    <div class="hero-bg absolute inset-0 z-0" aria-hidden="true">
        <BubbleBackground interactive colors={HERO_COLORS} />
    </div>

    <!-- Título -->
    <div class="relative z-10 flex h-[32vh] min-h-[240px] w-full items-center justify-center px-6 md:h-[60vh] md:min-h-[420px]">
        <h1 class="hero-title">{text}</h1>
    </div>
</header>

<style>
    .hero-bg :global([data-slot="bubble-background"]) {
        pointer-events: none;
    }

    .hero-bg {
        border-bottom-left-radius: 30px;
        border-bottom-right-radius: 30px;
        overflow: hidden;
        contain: paint;
    }

    /* Título: grande, apretado y ópticamente centrado.
       - `text-wrap: balance` reparte las líneas en lugar de dejar huérfanas
       - `leading` bajo para que quepan títulos de dos o tres palabras
       - sin padding lateral propio: el centrado lo da el contenedor flex */
    .hero-title {
        max-width: min(100%, 18ch);
        margin-inline: auto;
        font-family: var(--font-display), system-ui, sans-serif;
        font-weight: 900;
        font-size: clamp(2.75rem, 13vw, 8rem);
        line-height: 0.84;
        letter-spacing: -0.02em;
        text-align: center;
        text-wrap: balance;
        color: var(--bg-white);
        /* compensa el espacio del interlineado bajo para un centrado óptico exacto */
        padding-block: 0.08em;
    }

    @media (min-width: 768px) {
        .hero-title {
            font-size: clamp(4rem, 9vw, 9rem);
            max-width: min(100%, 20ch);
        }
    }

</style>
