---
/* Selector de idioma: control segmentado en píldora.

   Dos enlaces reales a la misma página en el otro idioma —no un desplegable
   con JavaScript—: funciona sin scripts, el buscador los rastrea y se pueden
   abrir en otra pestaña. El idioma activo va relleno; el otro, solo contorno.
   Con dos opciones un desplegable esconde información que cabe a la vista, y
   las banderas se descartaron a propósito: un idioma no es un país.

   Colores: no define ninguno propio. `--ls-ink` es `currentColor`, así que
   hereda la tinta adaptativa del navbar (crema sobre fondos oscuros, negra
   sobre claros) y el blanco del menú. Lo único que necesita saber es qué color
   poner al texto de la píldora activa, porque va SOBRE la tinta: eso es
   `--ls-contrast`, que declara quien lo monta (Navbar.astro, Menu.astro). */
import { locales, localeName, localizePath, useTranslations, type Locale } from "../i18n";

interface Props {
    /** Idioma que se está mostrando. */
    locale: Locale;
    /** `compact` para las barras del navbar; `menu` para el menú a pantalla completa. */
    variant?: "compact" | "menu";
    class?: string;
}

const { locale, variant = "compact", class: className = "" } = Astro.props;
const t = useTranslations(locale);

const options = locales.map((code) => ({
    code,
    href: localizePath(Astro.url.pathname, code),
    short: t(code === "es" ? "lang.esShort" : "lang.enShort"),
    name: localeName[code],
    current: code === locale,
}));
---

<nav aria-label={t("lang.label")} class:list={["lang-switch", variant === "menu" && "lang-switch--menu", className]}>
    {
        options.map((option) => (
            <a
                href={option.href}
                hreflang={option.code}
                lang={option.code}
                aria-current={option.current ? "page" : undefined}
                aria-label={option.current ? undefined : t("lang.switchTo", { language: option.name })}
                title={option.current ? undefined : option.name}
                class:list={["lang-switch__option", option.current && "is-active"]}
            >
                {option.short}
            </a>
        ))
    }
</nav>

<style>
    .lang-switch {
        --ls-ink: currentColor;
        --ls-contrast: var(--nav-ink-contrast, var(--text));

        display: inline-flex;
        align-items: center;
        gap: 2px;
        padding: 3px;
        border-radius: 999px;
        /* El contorno es la tinta al 35%: se ve sobre cualquier fondo sin
           competir con el CTA, que es el único elemento con color propio. */
        border: 1.5px solid color-mix(in srgb, var(--ls-ink) 35%, transparent);
        font-family: var(--font-display), system-ui, sans-serif;
        font-weight: 700;
        font-size: 0.68rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        line-height: 1;
        isolation: isolate;
    }

    .lang-switch__option {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.4rem;
        min-height: 1.7rem;
        padding: 0 0.65rem;
        border-radius: 999px;
        color: var(--ls-ink);
        opacity: 0.68;
        text-decoration: none;
        transition:
            opacity 220ms ease,
            background-color 220ms ease,
            color 220ms ease;
    }

    .lang-switch__option:hover,
    .lang-switch__option:focus-visible {
        opacity: 1;
    }

    .lang-switch__option.is-active {
        background-color: var(--ls-ink);
        color: var(--ls-contrast);
        opacity: 1;
    }

    .lang-switch__option:focus-visible {
        outline: 2px solid var(--ls-ink);
        outline-offset: 3px;
    }

    /* Menú a pantalla completa: más aire y área táctil de 44px. */
    .lang-switch--menu {
        font-size: 0.78rem;
        padding: 4px;
    }

    .lang-switch--menu .lang-switch__option {
        min-width: 3rem;
        min-height: 2.5rem;
        padding: 0 1rem;
    }

    @media (prefers-reduced-motion: reduce) {
        .lang-switch__option {
            transition: none;
        }
    }
</style>
