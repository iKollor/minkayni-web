---
/* Sección "Proyecto destacado" de la portada.
   Contenido editable desde Strapi (homepage → featuredProject); el logo de
   Batucada Popular es el protagonista del panel (SVG blanco sobre el
   degradado morado de marca, carga eager para que siempre esté visible). */
import type { ImageMetadata } from "astro";
import BatucadaLogo from "../../assets/SVG/LOGO_BATUCADA_2025.svg";
import BatucadaPhoto from "../../assets/FOTO_BATUCADA.webp";
import flor from "../../assets/SVG/misc/flor.svg";
import { Image } from "astro:assets";
import Button from "../Button.astro";
import CmsImage from "../CmsImage.astro";
import type { CmsMedia } from "../../data/pages/types";
import { featuredProjectFallback } from "../../data/pages/global";
import { withFallback } from "../../utils/content";
import { splitParagraphs } from "../../utils/rich-title";

interface Props {
    logoSrc?: ImageMetadata;
    photoSrc?: ImageMetadata;
    /** Contenido del componente sections.featured-project (homepage en Strapi) */
    content?: {
        title?: string | null;
        body?: string | null;
        logo?: CmsMedia;
        photo?: CmsMedia;
        button?: { href?: string | null; defaultText?: string | null; hoverText?: string | null } | null;
    } | null;
}

const { logoSrc = BatucadaLogo, photoSrc = BatucadaPhoto, content } = Astro.props as Props;
const d = withFallback({ ...featuredProjectFallback, logo: null as CmsMedia, photo: null as CmsMedia }, content);
const bodyParagraphs = splitParagraphs(d.body ?? "");
---

<section id="featured-project" class="relative mx-auto my-16 w-[94%] max-w-[1440px] md:my-24">
    <div class="grid overflow-hidden rounded-[2.75rem] bg-[linear-gradient(135deg,#4a0073_0%,#6e00a3_65%,#4a0073_100%)] lg:grid-cols-[1.05fr_0.95fr] lg:rounded-[5rem]">
        <!-- Foto -->
        <figure class="featured-img-col relative min-h-[300px] overflow-hidden sm:min-h-[380px] lg:min-h-[620px]">
            <CmsImage
                media={d.photo}
                fallback={photoSrc}
                alt="Batucada Popular – intervención cultural en Guayaquil"
                class="batucada-photo absolute inset-0 h-full w-full object-cover object-center transition duration-700 hover:scale-[1.03]"
                widths={[720, 1280, 1920]}
                sizes="(min-width: 64em) 52vw, 94vw"
            />
            <div class="pointer-events-none absolute inset-0 bg-[linear-gradient(0deg,rgba(56,0,88,0.55)_0%,rgba(56,0,88,0)_40%)] lg:bg-[linear-gradient(90deg,rgba(56,0,88,0)_55%,rgba(74,0,115,0.65)_100%)]" aria-hidden="true"></div>
        </figure>

        <!-- Panel -->
        <div id="featured-project-panel" class="relative flex flex-col justify-center overflow-hidden p-8 text-white sm:p-12 lg:p-16">
            <Image src={flor} alt="" class="pointer-events-none absolute -bottom-16 -right-14 h-64 w-64 rotate-12 opacity-10" aria-hidden="true" />

            <div class="relative flex flex-col items-start gap-6">
                <h2 class="featured-title flex items-center gap-3 text-sm font-bold uppercase tracking-[0.26em] text-secondary">
                    <span class="h-[3px] w-8 rounded-full bg-secondary" aria-hidden="true"></span>
                    {d.title}
                </h2>

                <CmsImage
                    media={d.logo}
                    fallback={logoSrc}
                    alt="Batucada Popular"
                    class="batucada-wordmark h-32 w-auto select-none drop-shadow-[0_10px_30px_rgba(0,0,0,0.35)] sm:h-40 lg:h-48"
                    loading="eager"
                    widths={[320, 640]}
                />

                <div class="featured-body flex flex-col gap-5">
                    {bodyParagraphs[0] && <p class="max-w-[48ch] text-lg leading-relaxed text-white sm:text-xl">{bodyParagraphs[0]}</p>}
                    {bodyParagraphs.slice(1).map((paragraph) => <p class="max-w-[52ch] border-l-2 border-secondary/60 pl-4 text-base leading-relaxed text-white/75">{paragraph}</p>)}
                </div>

                <div class="pt-2">
                    <Button href={d.button.href} defaultText={d.button.defaultText} hoverText={d.button.hoverText} />
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, SplitText, waitForFontsReady } from "../../scripts/main.ts";

    const initFeaturedProject = () => {
        const section = document.getElementById("featured-project");
        if (!section || section.dataset.fpReady === "true") return;
        section.dataset.fpReady = "true";

        const photo = section.querySelector(".batucada-photo");
        const wordmark = section.querySelector(".batucada-wordmark");
        const body = section.querySelector<HTMLElement>(".featured-body");
        const title = section.querySelector<HTMLElement>(".featured-title");
        const button = section.querySelector("[data-magic-btn]");
        const animated = [photo, wordmark, title, body, button].filter(Boolean);

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            gsap.set(animated, { clearProps: "all" });
            return;
        }

        waitForFontsReady(() => {
            let bodySplit: SplitText | undefined;
            try {
                if (body) bodySplit = new SplitText(body, { type: "lines", linesClass: "line" });

                const timeline = gsap.timeline({
                    defaults: { ease: "power3.out" },
                    scrollTrigger: {
                        trigger: section,
                        start: "top 75%",
                        toggleActions: "play none none reverse",
                    },
                });

                timeline
                    .from(photo, { scale: 1.15, duration: 1.2 }, 0)
                    .from(title, { y: 24, opacity: 0, duration: 0.5 }, 0.15)
                    .from(wordmark, { y: 34, opacity: 0, rotate: -2, duration: 0.9 }, 0.25);

                if (bodySplit?.lines.length) timeline.from(bodySplit.lines, { yPercent: 40, opacity: 0, stagger: 0.09, duration: 0.6 }, 0.45);
                if (button) timeline.from(button, { y: 30, opacity: 0, duration: 0.5 }, 0.6);

                const revealFallback = window.setTimeout(() => gsap.set(animated, { clearProps: "opacity,visibility" }), 1800);
                window.addEventListener("pagehide", () => {
                    window.clearTimeout(revealFallback);
                    timeline.kill();
                    bodySplit?.revert();
                }, { once: true });
            } catch {
                gsap.set(animated, { clearProps: "all" });
                bodySplit?.revert();
            }
        });
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initFeaturedProject, { once: true });
    else initFeaturedProject();
</script>
