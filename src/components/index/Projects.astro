---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import BatucadaLogo from "../../assets/SVG/LOGO_BATUCADA_2025.svg";
import BatucadaPhoto from "../../assets/FOTO_BATUCADA.webp";
import Button from "../Button.astro";

interface Props {
    logoSrc?: ImageMetadata;
    photoSrc?: ImageMetadata;
}

const { logoSrc = BatucadaLogo, photoSrc = BatucadaPhoto } = Astro.props as Props;
---

<section id="featured-project" class="relative mx-auto w-full h-auto md:h-[calc(100vh+300px)]">
    <div id="featured-project-shell" class="relative h-full">
        <div class="relative grid h-full min-h-0 grid-cols-12 lg:grid-cols-[35%_auto] gap-0 grid-rows-[1fr_1fr] lg:grid-rows-[minmax(0,1fr)] content-stretch items-stretch rounded-t-[50px] md:rounded-t-[100px] overflow-hidden">
            <div class="featured-img-col relative col-span-12 lg:col-span-1 h-full min-h-0 overflow-hidden">
                <Image src={photoSrc} alt="Batucada Popular – intervención cultural" class="batucada-photo absolute inset-0 h-full w-full object-cover object-center" loading="lazy" />
                <div class="mobile-photo-overlay absolute inset-0 lg:hidden pointer-events-none bg-black/55"></div>
                <div class="mobile-wordmark-wrapper lg:hidden absolute inset-0 flex items-center justify-center p-4">
                    <Image src={logoSrc} alt="Logo Batucada Popular" class="mobile-wordmark w-[62%] max-w-[320px] h-auto max-h-full object-contain drop-shadow-[0_2px_14px_rgba(0,0,0,0.55)]" loading="lazy" />
                </div>
            </div>

            <div id="featured-project-panel" class="relative col-span-12 lg:col-span-1 flex h-full pb-[200px] md:pb-0 lg:h-full flex-col p-14 text-white overflow-hidden bg-[linear-gradient(135deg,#4a0073_0%,#6e00a3_65%,#4a0073_100%)] lg:items-end">
                <div class="relative flex flex-col items-center lg:items-end lg:max-w-[500px] text-center lg:text-right gap-6">
                    <header class="w-full flex lg:justify-end justify-center">
                        <h2 class="featured-title font-display font-[900] tracking-tight text-[clamp(3.2rem,4.2vw,5.4rem)] leading-none">Proyecto destacado</h2>
                    </header>
                    <div class="featured-body flex flex-col text-base lg:text-xl leading-relaxed max-w-[50ch]">
                        <p>Nuestro proyecto estrella es la Batucada Popular, una iniciativa cultural y social que utiliza la música —especialmente los tambores y la percusión— como herramienta de transformación comunitaria y protección de jóvenes en contextos vulnerables.</p>
                        <p>Al promover Derechos Humanos, convivencia pacífica y resistencia cultural, la Batucada crea un refugio comunitario y fortalece redes de apoyo barrial.</p>
                    </div>
                    <Button href="/projects/batucada-popular/" defaultText="Descubre más 🚀" hoverText="Y siente su impacto 🔥" />
                </div>
            </div>

            <div class="pointer-events-none -translate-y-[calc(50%+150px)] absolute z-10 top-1/2 left-[calc(50%/2)] hidden lg:block">
                <div class="wordmark-parallax">
                    <Image src={logoSrc} alt="Logo Batucada Popular" class="batucada-wordmark w-[150px] max-w-[30vw] md:w-[260px] lg:w-[420px] max-h-full select-none drop-shadow-[0_2px_14px_rgba(0,0,0,0.55)]" loading="lazy" />
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { gsap, SplitText, waitForFontsReady } from "../../scripts/main.ts";

    const initFeaturedProject = () => {
        const section = document.getElementById("featured-project");
        if (!section || section.dataset.fpReady === "true") return;
        section.dataset.fpReady = "true";

        const photo = section.querySelector(".batucada-photo");
        const wordmark = section.querySelector(".batucada-wordmark");
        const mobileWordmark = section.querySelector(".mobile-wordmark");
        const title = section.querySelector<HTMLElement>(".featured-title");
        const body = section.querySelector<HTMLElement>(".featured-body");
        const button = section.querySelector("[data-magic-btn]");
        const animated = [photo, wordmark, mobileWordmark, title, body, button].filter(Boolean);

        if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
            gsap.set(animated, { clearProps: "all" });
            return;
        }

        waitForFontsReady(() => {
            let titleSplit: SplitText | undefined;
            let bodySplit: SplitText | undefined;
            try {
                if (title) titleSplit = new SplitText(title, { type: "words,chars", wordsClass: "word", charsClass: "char" });
                if (body) bodySplit = new SplitText(body, { type: "lines", linesClass: "line" });

                const timeline = gsap.timeline({
                    defaults: { ease: "power3.out" },
                    scrollTrigger: {
                        trigger: section,
                        start: "top 75%",
                        toggleActions: "play none none reverse",
                    },
                });

                timeline
                    .from(photo, { scale: 1.15, duration: 1.2 }, 0)
                    .from(wordmark, { yPercent: -10, rotate: -2, duration: 0.9 }, 0.2)
                    .from(mobileWordmark, { scale: 0.9, duration: 0.6 }, 0.25);

                if (titleSplit?.chars.length) timeline.from(titleSplit.chars, { yPercent: 120, opacity: 0, stagger: { each: 0.02, from: "center" }, duration: 0.65 }, 0.22);
                if (bodySplit?.lines.length) timeline.from(bodySplit.lines, { yPercent: 40, opacity: 0, stagger: 0.09, duration: 0.6 }, 0.4);
                if (button) timeline.from(button, { y: 30, opacity: 0, duration: 0.5 }, 0.55);

                const revealFallback = window.setTimeout(() => gsap.set(animated, { clearProps: "opacity,visibility" }), 1800);
                window.addEventListener("pagehide", () => {
                    window.clearTimeout(revealFallback);
                    timeline.kill();
                    titleSplit?.revert();
                    bodySplit?.revert();
                }, { once: true });
            } catch {
                gsap.set(animated, { clearProps: "all" });
                titleSplit?.revert();
                bodySplit?.revert();
            }
        });
    };

    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initFeaturedProject, { once: true });
    else initFeaturedProject();
</script>
