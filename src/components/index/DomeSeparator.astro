---
import ICON from "../../assets/SVG/misc/flor.svg";

interface Props {
    isAbsolute?: boolean;
    className?: string;
    showDecoration?: boolean;
}

const { className, isAbsolute = true, showDecoration = true } = Astro.props as Props;
---

<!-- Segmento bajo la curva (dome) -->
<div class={`w-[calc(100%+2px)] h-[150px] md:h-[300px] ${isAbsolute ? "absolute -top-[calc(150px-1px)] md:-top-[calc(300px-1px)]" : "relative top-[1px]"}`}>
    <!-- Contenedor general -->
    <div class="relative h-[150px] md:h-[300px] text-white">
        <!-- Capa base (relleno) -->
        <!-- Cúpula y contorno: una elipse de 140vw de ancho y alto fijo por
             breakpoint. Con un círculo de vmax, el arco bajaba tanto hacia los
             lados que salía por el fondo del recorte antes de llegar al borde
             de la pantalla y se veían sus extremos. Así los extremos quedan
             siempre a ±70vw (fuera de pantalla, sea cual sea el ancho) y la
             caída en el borde es fija: 90px en móvil y 210px en escritorio,
             por debajo del recorte incluso con los 40/60px del contorno. -->
        <div class="absolute inset-0 overflow-hidden">
            <!-- Cúpula grande (rellena) -->
            <div class=`absolute left-1/2 top-0 -translate-x-1/2 w-[140vw] h-[600px] rounded-[50%] bg-current md:h-[1400px] ${className}`></div>

            {showDecoration && <div class="absolute left-1/2 top-10 md:top-15 -translate-x-1/2 w-[140vw] h-[600px] rounded-[50%] border-[6px] border-primary md:h-[1400px]" />}
        </div>
        {showDecoration && <ICON class="object-cover h-10 w-10 absolute right-1/2 top-11 md:top-16 translate-x-1/2 -translate-y-1/2 transform transform-origin-center" />}
    </div>

    <!-- Contenido centrado -->
    <div class="absolute inset-0 flex items-center justify-center pt-12 md:pt-20">
        <slot />
    </div>
</div>
