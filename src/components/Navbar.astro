---
import Reloj from "./Reloj.astro";

import NavButton from "./NavButton.astro";
import Button from "./Button.astro";

import IsotipoIcon from "../assets/SVG/ISOTIPO_WHITE.svg";
import LogoIcon from "../assets/SVG/LOGO.svg";
import LogoIconWhite from "../assets/SVG/LOGO_WHITE.svg";
import BurgerIcon from "./BurgerIcon.astro";
import type { NavTree } from "../schemas/navigation";
import type { LinkColor, UnderlineColor } from "./NavButton.astro";

interface Props {
    buttons: NavTree;
    threshold?: number;
    linkColor?: LinkColor; // clase extra opcional
    underlineColor?: UnderlineColor; // color del underline
    buttonClassName?: string; // clase extra opcional
    enableMixBlend?: boolean;
}
// traer el pathname pero no existe en url aunque te devuelve toda la url

const { buttons, threshold, linkColor, underlineColor, buttonClassName = "", enableMixBlend = true } = Astro.props;
const submenuButtons = buttons
    .map((button, index) => ({ button, index }))
    .filter(({ button }) => Array.isArray(button.items) && button.items.length > 0);
---

<div class="fixed w-full h-[90px] z-50 hidden" id="nav-container" data-threshold={threshold ?? 0.7} data-enable-mixblend={enableMixBlend}>
    <div class="mx-10 h-full overflow-hidden">
        <div class="h-full w-full">
            <div id="nav-switcher" class="max-lg:-translate-y-[100px]">
                <div id="navBase" class="flex items-center h-[90px] justify-between text-lg text-white font-medium">
                    <a href="/" class="animate" aria-label="Ir al inicio">
                        <IsotipoIcon class={`h-10 mr-10 ${linkColor}`} />
                    </a>
                    <div class="flex items-center space-x-8 w-full animate">
                        {buttons.map((button, index) => ((button.additionalFields?.style ?? "default") === "default" ? <NavButton button={button} index={index} linkColor={linkColor} underlineColor={underlineColor} /> : null))}
                    </div>
                    <Reloj />
                    {
                        buttons.map((button) => {
                            if (button.additionalFields?.style === "cta" && button.path) {
                                return <Button href={button.path} defaultText={button.title} hoverText={String(button.additionalFields?.ctaText)} className={buttonClassName} />;
                            }
                            return null;
                        })
                    }
                </div>
                <div id="navScrolled" class="flex items-center h-[90px] justify-between">
                    <a href="/" aria-label="Ir al inicio">
                        {!enableMixBlend ? <LogoIcon class={`h-10 w-auto ${linkColor}`} /> : <LogoIconWhite class={`h-10 w-auto ${linkColor}`} />}
                    </a>
                    <BurgerIcon color={linkColor} />
                </div>
            </div>
        </div>
    </div>

    {
        submenuButtons.map(({ button, index }) => (
            <nav
                id={`navbar-submenu-${index}`}
                class="navbar-submenu absolute top-[68px] min-w-60 rounded-2xl border border-primary/15 bg-[var(--bg-white)] p-2 text-primary opacity-0 invisible pointer-events-none -translate-y-2 shadow-[0_18px_45px_rgba(35,15,55,0.18)] transition-[opacity,transform,visibility] duration-200"
                aria-label={`Submenú de ${button.title}`}
            >
                <ul>
                    {button.items?.map((item) => (
                        <li>
                            <a href={item.path} class="block rounded-xl px-4 py-3 font-display font-bold text-base hover:bg-primary hover:text-white focus-visible:bg-primary focus-visible:text-white focus-visible:outline-none">
                                {item.title}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        ))
    }
</div>

<script>
    import { gsap, ScrollTrigger, ScrollSmoother } from "../scripts/main.ts";

    const initNavSwitcher = () => {
        const navSwitcher = document.getElementById("nav-switcher");
        if (!navSwitcher) return;

        // Instancia matchMedia (reemplaza al deprecado ScrollTrigger.matchMedia)
        const mm = gsap.matchMedia();

        mm.add("(min-width: 1024px)", () => {
            const header = document.getElementById("header");
            const smoothContent = document.getElementById("smooth-content");
            const triggerEl = header || smoothContent || document.body;

            gsap.to(navSwitcher, {
                y: -100,
                ease: "none",
                scrollTrigger: {
                    trigger: triggerEl,
                    start: "top top",
                    end: "+=300",
                    scrub: true,
                    invalidateOnRefresh: true,
                },
            });

            requestAnimationFrame(() => ScrollTrigger.refresh());
        });

        // Toggle mix-blend-difference al superar threshold del documento
        const container = document.getElementById("nav-container");
        if (!container) return;

        // data-enable-mixblend controla si la funcionalidad está activa (por defecto true)
        const enableAttr = container.dataset.enableMixblend;
        const enableMixBlendFlag = enableAttr === undefined ? true : enableAttr === "true" || enableAttr === "1";

        if (!enableMixBlendFlag) {
            // Si está deshabilitado, asegurarse de que no haya mix-blend y salir
            container.classList.remove("mix-blend-difference");
        } else {
            const applyBlend = (active: boolean) => {
                container.classList.toggle("mix-blend-difference", active);
            };

            const updateBlend = () => {
                const smoother = ScrollSmoother.get?.();
                const y = smoother ? smoother.scrollTop() : window.scrollY;
                const raw = container.dataset.threshold;
                const thresholdVal = raw ? parseFloat(raw) * window.innerHeight : window.innerHeight * 0.7;
                applyBlend(y > thresholdVal);
            };

            // ScrollTrigger para actualizar en scroll/resize y con Smooth
            ScrollTrigger.create({
                start: 0,
                end: () => ScrollTrigger.maxScroll(window) || document.documentElement.scrollHeight - window.innerHeight,
                onUpdate: updateBlend,
                onRefresh: updateBlend,
            });

            // Estado inicial
            updateBlend();
        }
    };

    const initNavbarSubmenus = () => {
        const submenuElements = Array.from(document.querySelectorAll<HTMLElement>(".navbar-submenu"));
        if (submenuElements.length === 0) return;

        let closeTimer: number | undefined;

        const setExpanded = (trigger: HTMLElement, expanded: boolean) => {
            trigger.querySelector("a")?.setAttribute("aria-expanded", String(expanded));
        };

        const hideAll = () => {
            submenuElements.forEach((submenu) => {
                submenu.classList.add("opacity-0", "invisible", "pointer-events-none", "-translate-y-2");
                submenu.classList.remove("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
                const index = submenu.id.replace("navbar-submenu-", "");
                const trigger = document.getElementById(`nav-button-${index}`);
                if (trigger) setExpanded(trigger, false);
            });
        };

        submenuElements.forEach((submenu) => {
            const index = submenu.id.replace("navbar-submenu-", "");
            const trigger = document.getElementById(`nav-button-${index}`);
            if (!trigger) return;

            const triggerLink = trigger.querySelector("a");
            triggerLink?.setAttribute("aria-haspopup", "true");
            triggerLink?.setAttribute("aria-expanded", "false");
            triggerLink?.setAttribute("aria-controls", submenu.id);

            const show = () => {
                window.clearTimeout(closeTimer);
                hideAll();

                const triggerRect = trigger.getBoundingClientRect();
                const submenuWidth = submenu.offsetWidth || 240;
                const left = Math.min(Math.max(16, triggerRect.left), window.innerWidth - submenuWidth - 16);
                submenu.style.left = `${left}px`;
                submenu.classList.remove("opacity-0", "invisible", "pointer-events-none", "-translate-y-2");
                submenu.classList.add("opacity-100", "visible", "pointer-events-auto", "translate-y-0");
                setExpanded(trigger, true);
            };

            const scheduleHide = () => {
                window.clearTimeout(closeTimer);
                closeTimer = window.setTimeout(hideAll, 140);
            };

            trigger.addEventListener("mouseenter", show);
            trigger.addEventListener("mouseleave", scheduleHide);
            trigger.addEventListener("focusin", show);
            trigger.addEventListener("focusout", scheduleHide);
            submenu.addEventListener("mouseenter", () => window.clearTimeout(closeTimer));
            submenu.addEventListener("mouseleave", scheduleHide);
            submenu.addEventListener("focusin", () => window.clearTimeout(closeTimer));
            submenu.addEventListener("focusout", scheduleHide);
        });

        document.addEventListener("keydown", (event) => {
            if (event.key === "Escape") hideAll();
        });
        window.addEventListener("resize", hideAll, { passive: true });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
            initNavSwitcher();
            initNavbarSubmenus();
        }, { once: true });
    } else {
        initNavSwitcher();
        initNavbarSubmenus();
    }
</script>
