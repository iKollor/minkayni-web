---
/* La intro es una animación Lottie (vectorial, con transparencia real): se ve
   igual en Safari/iOS, Android y escritorio, sin depender de códecs de vídeo.
   La reproduce `src/scripts/index/intro.ts`; aquí solo vive el contenedor. */
import logoIntro from "../assets/lottie/logo_intro.json?url";
---

<!-- Sin `preload`: la intro ya no se reproduce en todas las visitas (ver
     src/scripts/visita.ts), así que precargar sus 55 KB desde el HTML los
     gastaba en la mayoría de cargas para nada. Quien sí va a verla los pide
     desde `intro.ts`, que es quien conoce la decisión. -->

<div id="intro-overlay" class="intro-hidden fixed inset-0 z-10 flex items-center justify-center overflow-hidden bg-transparent transition-opacity duration-500 [backface-visibility:hidden] [-webkit-backface-visibility:hidden]">
    <button id="skip-intro" type="button" class="absolute bottom-6 right-6 text-lg tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity cursor-pointer z-100"> Saltar </button>

    <!-- El logotipo ocupa 770 de los 1920 px de ancho del lienzo, así que para
         que acabe midiendo `--logo-w` (el del hero) el lienzo va a 1920/770 de
         ese ancho. Ambos quedan centrados en la ventana, uno sobre el otro. -->
    <div id="intro-lottie" data-src={logoIntro} aria-hidden="true" class="pointer-events-none absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[calc(var(--logo-w)*1920/770)] aspect-[16/9] origin-center [contain:paint]"></div>
</div>

<style is:global>
    .intro-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    /* Mientras el intro está pendiente, desenfocar/ocultar nav (coordinado con #skip-intro) */
    body[data-intro="pending"] #navBase > * {
        opacity: 0;
        transform: translateY(40px);
    }
</style>
