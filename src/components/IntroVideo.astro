---
/**
 * Overlay de la intro de portada. El logo animado es ahora un Lottie
 * (`LogoMotion`), no un video: ocupa la misma caja 16:9 centrada y a ancho
 * completo que tenía el `<video>`, así que la coreografía y los tiempos de
 * `intro.ts` no cambian. El nombre del archivo se conserva porque
 * `index.astro` lo importa así.
 *
 * `#intro-overlay`, `#skip-intro` e `#intro-fallback-logo` son la API que
 * consume `src/scripts/index/intro.ts`; `#intro-motion` es el nuevo nodo
 * animado (antes `#intro-stacked` / `#intro-webm`).
 */
import { Image } from "astro:assets";
import Logo from "../assets/SVG/LOGO_HEADER_WHITE.svg";
import LogoMotion from "./LogoMotion.astro";
---

<div id="intro-overlay" class="intro-hidden fixed inset-0 z-10 flex items-center justify-center overflow-hidden bg-transparent transition-opacity duration-500 [backface-visibility:hidden] [-webkit-backface-visibility:hidden]">
    <button id="skip-intro" class="absolute bottom-6 right-6 text-lg tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity cursor-pointer z-100"> Saltar </button>

    <!-- Fallback estático: sólo se muestra si el Lottie no carga. -->
    <Image id="intro-fallback-logo" src={Logo} alt="Logo" class="pointer-events-none absolute inset-0 m-auto w-[min(90vw,900px)] opacity-0 invisible" />

    <!-- Motion graphic del logo (mismo encuadre que tenía el video). La intro lo
         arranca desde intro.ts para poder medir el tiempo mínimo visible. -->
    <LogoMotion id="intro-motion" autoplay={false} label="" class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-[180svw] md:w-[100svw] origin-center will-change-[transform]" />
</div>

<style is:global>
    .intro-hidden {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
    }

    /* Hasta que el Lottie está listo no hay nada que mostrar en su caja. */
    #intro-motion[data-state="loading"],
    #intro-motion[data-state="error"] {
        visibility: hidden;
    }

    /* Mientras el intro está pendiente, desenfocar/ocultar nav (coordinado con #skip-intro) */
    body[data-intro="pending"] #navBase > * {
        opacity: 0;
        transform: translateY(40px);
    }
</style>
