---
import flor from "../assets/SVG/misc/flor.svg";
import Image from "astro/components/Image.astro";

interface Props {
    tittle?: string;
    buttontext?: string;
    text: string;
}

const { tittle, buttontext, text } = Astro.props;
---

<div class="relative w-full max-w-sm mx-auto bg">
    <!-- Flor posicionada encima -->
    <Image
        src={flor}
        alt="flor"
        class="object-cover w-16 h-16 sm:w-20 sm:h-20 absolute -top-8 sm:-top-10 left-1/2 -translate-x-1/2 z-10"
    />

    <!-- Card -->
    <div
        class="flex flex-col bg-[#d5d5d5] rounded-3xl overflow-hidden relative"
    >
        <!-- Sección superior -->
        <div
            class="w-full px-6 sm:px-10 md:px-10 py-8 sm:py-10 text-center"
            style="background-color: var(--bg-indigo-bright); color: white;"
        >
            <p class="text-sm sm:text-base mt-5">
                {tittle}
            </p>
        </div>

        <!-- Contenido -->
        <div
            class="flex flex-col items-center min-h-90 px-6 sm:px-8 md:px-15 py-8 sm:py-10 gap-6"
        >
            <p
                class="max-w-prose text-xs sm:text-sm md:text-xl text-left leading-relaxed"
            >
                {text}
            </p>

            <a
                href="#"
                class="w-full inline-block bg-amber-600 hover:bg-amber-700 text-white font-medium text-xs sm:text-sm md:text-base px-6 md:px-8 py-2.5 md:py-3 rounded-3xl shadow-md transition-colors duration-200 text-center"
            >
                {buttontext}
            </a>
        </div>
    </div>
</div>
