---
import type { NavItem } from "../schemas/navigation";

export interface Props {
    button: NavItem;
    index: number;
}

const currentPath = new URL(Astro.request.url).pathname;

const { button, index } = Astro.props;
---

<div class="nav-button relative mx-4 overflow-hidden" id={`nav-button-${index}`}>
    <a href={button.path} class:list={["inline-block relative z-10 focus:outline-none", currentPath === button.path && "pointer-events-none opacity-60"]}>
        {button.title}
    </a>
    {currentPath !== button.path && <span class="underline pointer-events-none absolute left-0 bottom-0 h-[1.5px] w-full rounded-xl bg-current" style="transform:translateX(-100%);will-change:transform;" />}
</div>
<script>
    import { gsap } from "gsap";

    const buttons = document.querySelectorAll<HTMLElement>(".nav-button");

    buttons.forEach((buttonElement) => {
        const underline = buttonElement.querySelector<HTMLElement>(".underline");
        if (!underline) return;

        buttonElement.addEventListener("mouseenter", () => {
            gsap.to(underline, {
                duration: 0.3,
                ease: "power2.out",
                transform: "translateX(0%)",
            });
        });

        buttonElement.addEventListener("mouseleave", () => {
            gsap.to(underline, {
                duration: 0.3,
                ease: "power3.in",
                transform: "translateX(100%)",
                onComplete: () => {
                    // Reset para que la siguiente entrada empiece desde la izquierda
                    gsap.set(underline, { transform: "translateX(-100%)" });
                },
            });
        });
    });
</script>
