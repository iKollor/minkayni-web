---
import { Image } from "astro:assets";

interface Props {
    src?: ImageMetadata;
    alt?: string;
    className?: string;
    /** Anchuras del srcset. La máscara siempre es cuadrada y no pasa de 28rem. */
    widths?: number[];
    /** Debe reflejar el tamaño que fija `className` en cada breakpoint. */
    sizes?: string;
}

/* Sin `widths` Astro sirve la imagen a su tamaño intrínseco: la foto de
   portada son 6000x4000 px para un círculo de 288-448 px en pantalla.
   `width` además acota el `src` de respaldo, que si no apunta a la original. */
const DEFAULT_WIDTHS = [288, 448, 576, 896];
const DEFAULT_SIZES = "(min-width: 1024px) 448px, (min-width: 640px) 384px, 288px";

const { src, alt = "", className = "", widths = DEFAULT_WIDTHS, sizes = DEFAULT_SIZES } = Astro.props;
---

<div class={`flower-mask ${className}`} role="img" aria-label={alt}>
    {src ? <Image src={src} alt={alt} width={widths[widths.length - 1]} widths={widths} sizes={sizes} /> : null}
</div>

<style>
    .flower-mask {
        display: inline-block;
        overflow: hidden;
        --g: /50.422% 50.422% radial-gradient(#000 calc(71% - 1px), #0000 71%) no-repeat;
        mask:
            50.785% 99.994% var(--g),
            0.006% 50.785% var(--g),
            49.215% 0.006% var(--g),
            99.994% 49.215% var(--g),
            radial-gradient(100% 100%, #000 20.711%, #0000 calc(20.711% + 1px));
        -webkit-mask:
            50.785% 99.994% var(--g),
            0.006% 50.785% var(--g),
            49.215% 0.006% var(--g),
            99.994% 49.215% var(--g),
            radial-gradient(100% 100%, #000 20.711%, #0000 calc(20.711% + 1px));
        background-color: #d5d5d5;
    }

    .flower-mask img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
</style>
