---
import Lefticon from "../assets/SVG/misc/arrowizq.svg";
import RightIcon from "../assets/SVG/misc/arrowder.svg";
import Image from "astro/components/Image.astro";
import CardInfo from "./CardInfo.astro";

interface SlideData {
    isVisible: boolean;
    imageSrc?: ImageMetadata;
    buttonText?: string;
    text: string;
    href?: string;
}

interface Props {
    slides: SlideData[];
    autoPlay?: boolean;
    interval?: number;
}

const { slides, autoPlay = false, interval = 5000 } = Astro.props;
const slidesCount = slides.length;
---

<div class="w-[90%] mx-auto mt-[2%] relative" data-slider data-autoplay={autoPlay} data-interval={interval}>
    <div class="relative" data-slides-container>
        {slides.map((slide) => <CardInfo isVisible={slide.isVisible} imageSrc={slide.imageSrc} buttonText={slide.buttonText} text={slide.text} href={slide.href} />)}
    </div>
    {slidesCount > 1 && (
        <>
            <div class="absolute top-1/2 -translate-y-1/2 w-full flex justify-between z-10 pointer-events-none">
                <button type="button" data-prev-slide class="flex justify-center items-center bg-amber-600 w-[4vw] h-[4vw] max-w-[60px] max-h-[60px] min-w-10 min-h-10 rounded-full border-none cursor-pointer transition-colors duration-300 hover:bg-black/50 -ml-5 pointer-events-auto" aria-label="Slide anterior"><div class="w-full h-full flex justify-center items-center rounded-full bg-white p-2"><Image src={Lefticon} alt="" class="object-cover w-full h-full" /></div></button>
                <button type="button" data-next-slide class="flex justify-center items-center bg-amber-600 w-[4vw] h-[4vw] max-w-[60px] max-h-[60px] min-w-10 min-h-10 rounded-full border-none cursor-pointer transition-colors duration-300 hover:bg-black/50 -mr-5 pointer-events-auto" aria-label="Siguiente slide"><div class="w-full h-full flex justify-center items-center rounded-full bg-white p-2"><Image src={RightIcon} alt="" class="object-cover w-full h-full" /></div></button>
            </div>
            <div class="flex justify-center gap-2 mt-4" data-indicators>
                {Array.from({ length: slidesCount }).map((_, index) => <button type="button" class={`indicator w-2 h-2 rounded-full transition-all duration-300 ${index === 0 ? "bg-[#d97706] w-6" : "bg-gray-400"}`} data-indicator-index={index} aria-label={`Ir a slide ${index + 1}`} />)}
            </div>
        </>
    )}
</div>

<script>
    const initSliders = () => {
        document.querySelectorAll<HTMLElement>("[data-slider]").forEach((root) => {
            if (root.dataset.ready === "true") return;
            root.dataset.ready = "true";
            const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slides-container] > *"));
            const indicators = Array.from(root.querySelectorAll<HTMLElement>("[data-indicator-index]"));
            if (slides.length < 2) return;
            let currentIndex = 0;
            let timer: number | undefined;
            const show = (index: number) => {
                currentIndex = (index + slides.length) % slides.length;
                slides.forEach((slide, i) => (slide.style.display = i === currentIndex ? "flex" : "none"));
                indicators.forEach((indicator, i) => {
                    indicator.classList.toggle("bg-[#d97706]", i === currentIndex);
                    indicator.classList.toggle("w-6", i === currentIndex);
                    indicator.classList.toggle("bg-gray-400", i !== currentIndex);
                });
            };
            const stop = () => { if (timer !== undefined) window.clearInterval(timer); timer = undefined; };
            const start = () => {
                stop();
                if (root.dataset.autoplay === "true" && !matchMedia("(prefers-reduced-motion: reduce)").matches) timer = window.setInterval(() => show(currentIndex + 1), Number(root.dataset.interval) || 5000);
            };
            root.querySelector("[data-next-slide]")?.addEventListener("click", () => show(currentIndex + 1));
            root.querySelector("[data-prev-slide]")?.addEventListener("click", () => show(currentIndex - 1));
            indicators.forEach((indicator, index) => indicator.addEventListener("click", () => show(index)));
            root.addEventListener("mouseenter", stop);
            root.addEventListener("mouseleave", start);
            show(0);
            start();
            window.addEventListener("pagehide", stop, { once: true });
        });
    };
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", initSliders, { once: true });
    else initSliders();
</script>
