---
/**
 * Motion graphic del logotipo (isotipo + «inkayni» + tagline) como Lottie.
 *
 * Reemplaza al `logo_intro.webm` con alpha: la misma coreografía (24 fps,
 * 120 cuadros, 1920×1080) reconstruida cuadro a cuadro como vectores, así
 * que escala sin pixelarse, pesa ~40 KB comprimido y no depende del soporte
 * de video transparente del navegador.
 *
 * Es reutilizable: cualquier página puede montarlo con
 * `<LogoMotion id="..." autoplay loop />`. El elemento emite en su nodo:
 *   - `logomotion:ready`     el JSON cargó y el SVG está en el DOM
 *   - `logomotion:play`      empezó a reproducirse
 *   - `logomotion:complete`  terminó (sólo sin `loop`)
 *   - `logomotion:error`     no se pudo cargar/reproducir
 * y expone la instancia en `el.logoMotion` (play/pause/stop/goToAndStop…).
 * `data-state` refleja el estado (`loading` | `ready` | `playing` |
 * `complete` | `error`) para estilos y para quien se suscriba tarde.
 *
 * Con `prefers-reduced-motion` salta directamente al último cuadro (el logo
 * completo) y emite `complete`: el contenido nunca queda a la espera.
 */
import logoIntroUrl from "../assets/lottie/logo_intro.json?url";

interface Props {
    id?: string;
    class?: string;
    /** Reproducir al cargar (por defecto sí). */
    autoplay?: boolean;
    loop?: boolean;
    /** Multiplicador de velocidad (1 = tiempo real, 5 s). */
    speed?: number;
    /** Texto accesible; vacío para tratarlo como decorativo. */
    label?: string;
    /** Respetar `prefers-reduced-motion` (por defecto sí). */
    respectReducedMotion?: boolean;
}

const { id, class: className = "", autoplay = true, loop = false, speed = 1, label = "Animación del logotipo de Minkayni", respectReducedMotion = true } = Astro.props;
---

<div
    id={id}
    class:list={["logo-motion", className]}
    data-logo-motion
    data-src={logoIntroUrl}
    data-autoplay={autoplay ? "true" : "false"}
    data-loop={loop ? "true" : "false"}
    data-speed={String(speed)}
    data-reduced={respectReducedMotion ? "true" : "false"}
    data-state="loading"
    role={label ? "img" : undefined}
    aria-label={label || undefined}
    aria-hidden={label ? undefined : "true"}
>
</div>

<style>
    .logo-motion {
        display: block;
        aspect-ratio: 16 / 9;
        contain: layout paint;
    }
    .logo-motion :global(svg) {
        display: block;
        width: 100%;
        height: 100%;
    }
</style>

<script>
    import lottie from "lottie-web/build/player/lottie_svg";
    import type { AnimationItem } from "lottie-web";

    /* Un elemento por Lottie: `lottie-web` deja de referirse al DOM al
       llamar `destroy()`, y se llama al vaciar la página (ver `pagehide`). */
    type MotionElement = HTMLElement & { logoMotion?: AnimationItem };

    const emit = (el: HTMLElement, name: string, detail?: unknown): void => {
        el.dispatchEvent(new CustomEvent(`logomotion:${name}`, { detail, bubbles: true }));
    };

    const setState = (el: HTMLElement, state: string): void => {
        el.dataset.state = state;
    };

    const mount = async (el: MotionElement): Promise<void> => {
        if (el.logoMotion) return;
        const src = el.dataset.src;
        if (!src) {
            setState(el, "error");
            emit(el, "error", new Error("LogoMotion: falta data-src"));
            return;
        }

        const autoplay = el.dataset.autoplay !== "false";
        const loop = el.dataset.loop === "true";
        const speed = Number(el.dataset.speed) || 1;
        const reduced = el.dataset.reduced !== "false" && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        let animationData: unknown;
        try {
            const res = await fetch(src);
            if (!res.ok) throw new Error(`LogoMotion: ${res.status} al pedir ${src}`);
            animationData = await res.json();
        } catch (error) {
            setState(el, "error");
            emit(el, "error", error);
            return;
        }

        const anim = lottie.loadAnimation({
            container: el,
            renderer: "svg",
            loop,
            autoplay: false,
            animationData,
            rendererSettings: {
                preserveAspectRatio: "xMidYMid meet",
                progressiveLoad: false,
                /* El SVG describe el mismo lienzo 16:9 que tenía el video. */
                viewBoxOnly: true,
            },
        });
        el.logoMotion = anim;
        anim.setSpeed(speed);

        anim.addEventListener("DOMLoaded", () => {
            setState(el, "ready");
            emit(el, "ready");
            if (reduced) {
                /* Estado final usable sin movimiento. */
                anim.goToAndStop(anim.totalFrames - 1, true);
                setState(el, "complete");
                emit(el, "complete");
                return;
            }
            if (autoplay) {
                anim.play();
                setState(el, "playing");
                emit(el, "play");
            }
        });
        anim.addEventListener("complete", () => {
            setState(el, "complete");
            emit(el, "complete");
        });
        anim.addEventListener("data_failed", () => {
            setState(el, "error");
            emit(el, "error", new Error("LogoMotion: datos inválidos"));
        });
    };

    const init = (): void => {
        document.querySelectorAll<MotionElement>("[data-logo-motion]").forEach((el) => {
            void mount(el);
        });
    };

    init();
    document.addEventListener("astro:page-load", init);
    window.addEventListener("pagehide", () => {
        document.querySelectorAll<MotionElement>("[data-logo-motion]").forEach((el) => {
            el.logoMotion?.destroy();
            el.logoMotion = undefined;
        });
    });
</script>
