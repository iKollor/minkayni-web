---
/* Borde rasgado entre secciones: una franja del color de la sección ANTERIOR,
   enmascarada con uno de los grunge borders (assets/SVG, rasterizados con alfa
   en public/batucada). El margen negativo la hace "rasgar" sobre la sección
   siguiente y la escala 1.3 la desborda a propósito (el contenedor recorta).
   Sin soporte de máscaras queda oculto: corte recto, nunca roto. */
interface Props {
    color?: string;
    border?: 1 | 2 | 3 | 4;
    flip?: boolean;
}

const { color = "var(--bg-white)", border = 1, flip = false } = Astro.props;
---

<div
    class:list={[
        "pointer-events-none relative z-[2] opacity-90",
        "h-[clamp(34px,6vw,84px)] mb-[calc(clamp(34px,6vw,84px)*-1)]",
        "[mask-image:var(--torn-mask)] [mask-size:100%_100%] [mask-repeat:no-repeat]",
        /* el grano de papel también vive en la tira: sin esto es un parche
           plano y liso que desentona contra las secciones texturizadas.
           En bases oscuras soft-light apenas aclara (se pierde), por eso
           además baja la opacidad general: nunca lee como calcomanía 100%
           sólida — siempre dejar asomar algo de lo que hay debajo. */
        "[background-image:var(--bp-noise)] [background-blend-mode:soft-light]",
        "hidden supports-[mask-size:100%_100%]:block",
        flip ? "[scale:-1.3_1.3]" : "[scale:1.3]",
    ]}
    style={`background-color:${color}; --torn-mask:url('/batucada/border-${border}.webp')`}
    aria-hidden="true"
>
</div>
