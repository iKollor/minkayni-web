---
interface Props {
    tittle: string;
    subtitle: string;
    text: string;
}

const { tittle, subtitle, text } = Astro.props;
---

<div
    class="flex flex-col p-4 sm:p-6 rounded-2xl w-full sm:w-1/3 min-h-[180px] justify-between text-center sm:text-left"

>
    <div style="color: var(--bg-indigo-bright);">
        <h1 class="text-3xl sm:text-6xl font-bold">{tittle}</h1>
        <p class="text-base sm:text-lg">{subtitle}</p>
    </div>
    <p class="text-xs sm:text-sm mt-2 leading-relaxed opacity-90">
        {text}
    </p>
</div>
